{
  "manifest_version": 3,
  "name": "普拉魂擷取",
  "version": "0.1.0",
  "description": "在 FB 鋼彈交易貼文點一下，自動帶到普拉魂後台填表",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "普拉魂擷取",
    "default_icon": {
      "16": "icons/icon-128.png",
      "48": "icons/icon-128.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-128.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  }
}
