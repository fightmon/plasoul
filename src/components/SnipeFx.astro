---
/**
 * 開發日誌用：自帶的「狙擊特效」迷你演示（純 CSS/JS，無 GIF / 無引擎依賴）
 * 掃描頁面上的 <div class="snipe-demo" data-variant="final|graze|tuner"> 並掛上動畫，loop 播放。
 * data-variant="tuner" 額外帶 3 個可調鈕（出口距離 / 後火花大小 / 顆粒樣式）。
 */
---

<style is:global>
  .snipe-demo { display: block; margin: 18px auto; }
  .sd-stage { position: relative; width: 100%; max-width: 440px; margin: 0 auto; aspect-ratio: 5 / 4; border-radius: 14px; overflow: hidden; background: radial-gradient(circle at 50% 42%, #16223f, #0a0e1c 62%, #060812); border: 1px solid #1c2748; will-change: transform; }
  .sd-stage[data-size="thumb"] { aspect-ratio: 16 / 9; border-radius: 12px; }
  .sd-stars { position: absolute; inset: 0; background-image: radial-gradient(1.5px 1.5px at 20% 28%, #fff, transparent), radial-gradient(1px 1px at 70% 60%, #bcf, transparent), radial-gradient(1px 1px at 45% 82%, #fff, transparent), radial-gradient(1px 1px at 86% 30%, #ace, transparent); opacity: .5; }
  .sd-fxb { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .sd-atk { position: absolute; left: 20%; top: 50%; transform: translate(-50%,-50%); font-size: clamp(26px, 7vw, 40px); z-index: 2; filter: drop-shadow(0 0 6px rgba(120,170,255,.5)); }
  .sd-card { position: absolute; left: 72%; top: 50%; transform: translate(-50%,-50%); width: 24%; aspect-ratio: 3 / 4; border-radius: 10px; background: linear-gradient(160deg, #3a2418, #2a1810); border: 2px solid #7a5a3a; display: flex; align-items: center; justify-content: center; z-index: 3; box-shadow: 0 0 0 2px rgba(120,170,255,.35); }
  .sd-art { font-size: clamp(22px, 6vw, 34px); }
  .sd-fxf { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  .sd-dmg { color: #ffd23d; font-weight: 900; font-size: clamp(18px, 5vw, 26px); text-shadow: 0 2px 6px #000; white-space: nowrap; }

  /* tuner */
  .sd-tuner { max-width: 440px; margin: 18px auto; }
  .sd-ctrl { margin-top: 12px; display: flex; flex-direction: column; gap: 10px; }
  .sd-row { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--color-text, #cdd6ea); }
  .sd-row > label { flex-shrink: 0; width: 70px; font-weight: 700; }
  .sd-range { flex: 1; accent-color: #2f9bff; }
  .sd-val { width: 48px; text-align: right; font-variant-numeric: tabular-nums; color: var(--color-text-secondary, #8aa); }
  .sd-seg { display: flex; gap: 6px; flex: 1; }
  .sd-seg button { flex: 1; padding: 7px 4px; border-radius: 8px; border: 1px solid var(--color-border, #2c3a5e); background: var(--color-card, #141c34); color: var(--color-text, #cdd6ea); font-size: 13px; font-weight: 700; cursor: pointer; }
  .sd-seg button.on { background: linear-gradient(135deg, #3b82f6, #1e50e5); border-color: #5b86ff; color: #fff; }
  .sd-replay { margin-top: 2px; padding: 9px; border-radius: 9px; border: 1px solid var(--color-border, #2c3a5e); background: transparent; color: var(--color-text-secondary, #8aa); font-weight: 700; cursor: pointer; }
  .sd-replay:hover { border-color: #5b86ff; color: var(--color-text, #fff); }
</style>

<script>
  (function () {
    const SIZES = { none: [0, 0], small: [6, 0.6], med: [10, 0.95], large: [16, 1.35] };
    const VARIANTS = {
      final: { style: 'line', exitP: 55, back: 'large', front: 'small', pierce: true, dir: 'in' },
      graze: { style: 'dot', exitP: 0, back: 'none', front: 'med', pierce: false, dir: 'out' },
      tuner: { style: 'line', exitP: 55, back: 'large', front: 'small', pierce: true, dir: 'in' },
      diffuse: { lines: 5, chargeT: 620 },
      'diffuse-tuner': { lines: 5, chargeT: 620 },
      bit: {},
      charge: {},
      wave: {},
      snipebeam: {},
    };
    const SNIPE_V = { final: 1, graze: 1, tuner: 1 };
    function el(parent, cls, css) { const d = document.createElement('div'); if (cls) d.className = cls; if (css) d.style.cssText = css; parent.appendChild(d); return d; }
    function spark(layer, x, y, dir, style, sizeKey, color, spreadDeg) {
      const s = SIZES[sizeKey] || [0, 0], count = s[0], mag = s[1], col = color || '#ffb060', sp = spreadDeg || 60;
      for (let k = 0; k < count; k++) {
        const a = (dir + (Math.random() * sp - sp / 2)) * Math.PI / 180, deg = a * 180 / Math.PI;
        const dist = (20 + Math.random() * 34) * mag, dx = Math.cos(a) * dist, dy = Math.sin(a) * dist;
        if (style === 'line') {
          const len = 7 + Math.random() * 8, th = 2 + Math.random() * 1.4;
          const p = el(layer, '', 'position:absolute;left:' + x + 'px;top:' + y + 'px;width:' + len + 'px;height:' + th + 'px;border-radius:' + th + 'px;background:linear-gradient(90deg,' + col + ',transparent);box-shadow:0 0 6px ' + col);
          p.animate([{ transform: 'translate(-50%,-50%) rotate(' + deg + 'deg) scaleX(1.1)', opacity: 1 }, { transform: 'translate(calc(-50% + ' + dx + 'px),calc(-50% + ' + dy + 'px)) rotate(' + deg + 'deg) scaleX(.25)', opacity: 0 }], { duration: 420 + Math.random() * 180, easing: 'ease-out', fill: 'forwards' });
        } else {
          const sz = 4 + Math.random() * 4;
          const p = el(layer, '', 'position:absolute;left:' + x + 'px;top:' + y + 'px;width:' + sz + 'px;height:' + sz + 'px;border-radius:50%;background:' + col + ';box-shadow:0 0 6px ' + col + ';transform:translate(-50%,-50%)');
          p.animate([{ transform: 'translate(-50%,-50%) scale(1.1)', opacity: 1 }, { transform: 'translate(calc(-50% + ' + dx + 'px),calc(-50% + ' + dy + 'px)) scale(.2)', opacity: 0 }], { duration: 460 + Math.random() * 180, easing: 'ease-out', fill: 'forwards' });
        }
      }
    }
    function runScene(stage, cfg) {
      stage.classList.add('sd-stage'); stage.innerHTML = '';
      el(stage, 'sd-stars');
      const fxb = el(stage, 'sd-fxb');
      el(stage, 'sd-atk').textContent = '🤖';
      const card = el(stage, 'sd-card'); el(card, 'sd-art').textContent = '👾';
      const fxf = el(stage, 'sd-fxf');
      function play() {
        fxf.innerHTML = ''; fxb.innerHTML = ''; const oh = card.querySelector('.sd-hole'); if (oh) oh.remove();
        const r = stage.getBoundingClientRect(); if (!r.width) return;
        const a = { x: r.width * 0.27, y: r.height * 0.5 };
        const cr = card.getBoundingClientRect();
        const p = { x: (cr.left - r.left) + cr.width / 2, y: (cr.top - r.top) + cr.height / 2 };
        // 砲口閃光
        el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;width:18px;height:18px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#fff,#ffd24d 55%,transparent 74%)').animate([{ opacity: .9, transform: 'translate(-50%,-50%) scale(.5)' }, { opacity: 0, transform: 'translate(-50%,-50%) scale(1.3)' }], { duration: 240, fill: 'forwards' });
        // 子彈飛向命中點
        const b = el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;width:14px;height:6px;border-radius:4px;background:linear-gradient(90deg,#ffd24d,#ff7a1f);box-shadow:0 0 8px #ff9a3d;transform:translate(-50%,-50%)');
        b.animate([{ transform: 'translate(-50%,-50%)' }, { transform: 'translate(calc(-50% + ' + (p.x - a.x) + 'px),calc(-50% + ' + (p.y - a.y) + 'px))' }], { duration: 175, easing: 'linear' }).onfinish = function () { b.remove(); impact(); };
        function impact() {
          // 入口彈孔（掛在卡上）
          const lx = p.x - (cr.left - r.left), ly = p.y - (cr.top - r.top);
          el(card, 'sd-hole', 'position:absolute;left:' + lx + 'px;top:' + ly + 'px;width:13px;height:13px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#140d05 36%,#3a2913 62%,rgba(90,55,22,.45) 80%,transparent 92%);box-shadow:0 0 6px rgba(0,0,0,.55);z-index:3;pointer-events:none').animate([{ opacity: 0, transform: 'translate(-50%,-50%) scale(.4)' }, { opacity: 1, transform: 'translate(-50%,-50%) scale(1)', offset: .1 }, { opacity: 1, offset: .62 }, { opacity: 0 }], { duration: 1300, easing: 'ease-out', fill: 'forwards' });
          // 入口火花（in=反向鑽入 / out=往後擦傷）
          spark(fxf, p.x, p.y, cfg.dir === 'in' ? 180 : 0, cfg.style, cfg.front);
          // 傷害數字
          const dn = el(fxf, 'sd-dmg', 'position:absolute;left:' + p.x + 'px;top:' + p.y + 'px'); dn.textContent = '-999!';
          dn.animate([{ transform: 'translate(-50%,-50%) scale(.6)', opacity: 0 }, { transform: 'translate(-50%,-92%) scale(1.1)', opacity: 1, offset: .3 }, { transform: 'translate(-50%,-150%) scale(1)', opacity: 0 }], { duration: 950, easing: 'ease-out', fill: 'forwards' });
          // 擊退 + 鏡頭微縮放
          card.animate([{ transform: 'translate(0,0)' }, { transform: 'translate(7px,0)', offset: .3 }, { transform: 'translate(0,0)' }], { duration: 320, easing: 'ease-out', composite: 'add' });
          stage.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.03)', offset: .3 }, { transform: 'scale(1)' }], { duration: 260, easing: 'ease-out' });
          // 貫穿：子彈滑出卡背（卡後層）+ 出口火花
          if (cfg.pierce) {
            const ex = { x: p.x + cfg.exitP, y: p.y };
            setTimeout(function () {
              const m2 = el(fxb, '', 'position:absolute;left:' + p.x + 'px;top:' + p.y + 'px;width:14px;height:6px;border-radius:4px;background:linear-gradient(90deg,#ffd24d,#ff7a1f);box-shadow:0 0 8px #ff9a3d;transform:translate(-50%,-50%)');
              m2.animate([{ transform: 'translate(-50%,-50%)', opacity: 1 }, { transform: 'translate(calc(-50% + ' + (cfg.exitP + 45) + 'px),-50%)', opacity: 0 }], { duration: 300, easing: 'ease-out', fill: 'forwards' }).onfinish = function () { m2.remove(); };
              spark(fxb, ex.x, ex.y, 0, cfg.style, cfg.back);
            }, 45);
          }
        }
      }
      play(); setInterval(play, 2600);
      return { play: play };
    }
    function buildTuner(root, cfg, play) {
      const ctrl = el(root, 'sd-ctrl');
      ctrl.innerHTML =
        '<div class="sd-row"><label>出口距離</label><input type="range" class="sd-range" min="5" max="60" value="' + cfg.exitP + '"><span class="sd-val">P+' + cfg.exitP + '</span></div>' +
        '<div class="sd-row"><label>後火花</label><div class="sd-seg" data-key="back"><button data-v="small">小</button><button data-v="med">中</button><button data-v="large">大</button></div></div>' +
        '<div class="sd-row"><label>顆粒樣式</label><div class="sd-seg" data-key="style"><button data-v="dot">圓點</button><button data-v="line">線條</button></div></div>' +
        '<button class="sd-replay">▶ 重播</button>';
      function sync() { ctrl.querySelectorAll('.sd-seg').forEach(function (seg) { const key = seg.getAttribute('data-key'); seg.querySelectorAll('button').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-v') === String(cfg[key])); }); }); }
      sync();
      const range = ctrl.querySelector('.sd-range'), val = ctrl.querySelector('.sd-val');
      range.addEventListener('input', function () { cfg.exitP = +range.value; val.textContent = 'P+' + range.value; play(); });
      ctrl.querySelectorAll('.sd-seg button').forEach(function (b) { b.addEventListener('click', function () { const key = b.closest('.sd-seg').getAttribute('data-key'); cfg[key] = b.getAttribute('data-v'); sync(); play(); }); });
      ctrl.querySelector('.sd-replay').addEventListener('click', play);
    }
    // ---- 射擊系（擴散 / 子機光繪 / 蓄力）共用 ----
    const SVGNS = 'http://www.w3.org/2000/svg';
    function setupStage(stage) {
      stage.classList.add('sd-stage'); stage.innerHTML = '';
      el(stage, 'sd-stars');
      const fxb = el(stage, 'sd-fxb');
      el(stage, 'sd-atk').textContent = '🤖';
      const card = el(stage, 'sd-card'); el(card, 'sd-art').textContent = '👾';
      const fxf = el(stage, 'sd-fxf');
      return { fxb: fxb, card: card, fxf: fxf };
    }
    function hitPoint(layer, x, y, big) {   // 白光點（子機/雷射/擴散命中那顆）
      const s = big ? 17 : 11;
      const n = el(layer, '', 'position:absolute;left:' + x + 'px;top:' + y + 'px;width:' + s + 'px;height:' + s + 'px;border-radius:50%;background:#fff;box-shadow:0 0 9px #fff,0 0 16px #fff;transform:translate(-50%,-50%) scale(.3);z-index:6');
      n.animate([{ opacity: 0, transform: 'translate(-50%,-50%) scale(.2)' }, { opacity: 1, transform: 'translate(-50%,-50%) scale(1.1)', offset: .35 }, { opacity: 0, transform: 'translate(-50%,-50%) scale(1.5)' }], { duration: 560, easing: 'ease-out', fill: 'forwards' });
      setTimeout(function () { try { n.remove(); } catch (e) {} }, 600);
    }
    function dmgNum(layer, x, y, txt) {
      const dn = el(layer, 'sd-dmg', 'position:absolute;left:' + x + 'px;top:' + y + 'px'); dn.textContent = txt;
      dn.animate([{ transform: 'translate(-50%,-50%) scale(.6)', opacity: 0 }, { transform: 'translate(-50%,-92%) scale(1.1)', opacity: 1, offset: .3 }, { transform: 'translate(-50%,-150%) scale(1)', opacity: 0 }], { duration: 950, easing: 'ease-out', fill: 'forwards' });
    }
    function trailPath(svg, d, dur, color) {   // 光繪軌跡：沿曲線逐段描出→殘留→淡出
      const p = document.createElementNS(SVGNS, 'path');
      p.setAttribute('d', d); p.setAttribute('fill', 'none'); p.setAttribute('stroke', color); p.setAttribute('stroke-width', '1.6'); p.setAttribute('stroke-linecap', 'round');
      p.style.filter = 'drop-shadow(0 0 5px ' + color + ') drop-shadow(0 0 2px #fff)'; svg.appendChild(p);
      const L = p.getTotalLength(); p.style.strokeDasharray = L; p.style.strokeDashoffset = L;
      p.animate([{ strokeDashoffset: L }, { strokeDashoffset: 0 }], { duration: dur, easing: 'ease-in-out', fill: 'forwards' });
      p.animate([{ opacity: 1, offset: 0 }, { opacity: 1, offset: dur / (dur + 420) }, { opacity: 0, offset: 1 }], { duration: dur + 420, fill: 'forwards' });
      setTimeout(function () { try { p.remove(); } catch (e) {} }, dur + 470);
    }

    function runDiffuse(stage, cfg) {
      const s = setupStage(stage), fxf = s.fxf, card = s.card;
      function play() {
        fxf.innerHTML = '';
        const r = stage.getBoundingClientRect(); if (!r.width) return;
        const a = { x: r.width * 0.27, y: r.height * 0.5 };
        const cr = card.getBoundingClientRect(); const cx0 = cr.left - r.left, cy0 = cr.top - r.top;
        const chargeT = cfg.chargeT || 620;
        // 蓄力：中心白點漸大
        const dot = el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;width:16px;height:16px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#fff 42%,rgba(255,255,255,.4) 70%,transparent 85%);box-shadow:0 0 12px #fff');
        dot.animate([{ transform: 'translate(-50%,-50%) scale(.15)', opacity: .5 }, { transform: 'translate(-50%,-50%) scale(1)', opacity: 1 }], { duration: chargeT, easing: 'ease-in', fill: 'forwards' });
        setTimeout(function () { try { dot.remove(); } catch (e) {} }, chargeT + 240);
        // 蓄力：顆粒由外往內集中
        const waves = 6, travel = 300, span = Math.max(0, chargeT - travel);
        for (let w = 0; w < waves; w++) setTimeout(function () {
          for (let k = 0; k < 4; k++) {
            const ang = Math.random() * Math.PI * 2, rad = 38 + Math.random() * 22;
            const sx = a.x + Math.cos(ang) * rad, sy = a.y + Math.sin(ang) * rad, sz = 3 + Math.random() * 3;
            const pp = el(fxf, '', 'position:absolute;left:' + sx + 'px;top:' + sy + 'px;width:' + sz + 'px;height:' + sz + 'px;border-radius:50%;background:#bfefff;box-shadow:0 0 6px #9fe8ff;transform:translate(-50%,-50%)');
            pp.animate([{ transform: 'translate(-50%,-50%) scale(.4)', opacity: 0 }, { transform: 'translate(-50%,-50%) scale(1)', opacity: 1, offset: .3 }, { transform: 'translate(calc(-50% + ' + (a.x - sx) + 'px),calc(-50% + ' + (a.y - sy) + 'px)) scale(.2)', opacity: .9 }], { duration: travel, easing: 'ease-in', fill: 'forwards' });
            setTimeout(function () { try { pp.remove(); } catch (e) {} }, travel + 60);
          }
        }, waves > 1 ? span * w / (waves - 1) : 0);
        // 蓄滿→發射
        setTimeout(function () {
          el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;width:22px;height:22px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#fff,#9fe8ff 55%,transparent 74%)').animate([{ opacity: .95, transform: 'translate(-50%,-50%) scale(.5)' }, { opacity: 0, transform: 'translate(-50%,-50%) scale(1.4)' }], { duration: 260, fill: 'forwards' });
          spark(fxf, a.x, a.y, 0, 'line', 'large', '#7fd4ff', 150);   // 發射火光線條（上下大幅散佈）
          const N = cfg.lines || 5;
          for (let i = 0; i < N; i++) {
            const tx = cx0 + cr.width * (0.2 + Math.random() * 0.6), ty = cy0 + cr.height * (0.2 + Math.random() * 0.6);
            const ang = Math.atan2(ty - a.y, tx - a.x) * 180 / Math.PI;
            const st = el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;width:26px;height:3px;border-radius:3px;transform:translate(-50%,-50%) rotate(' + ang + 'deg);background:linear-gradient(90deg,transparent,rgba(159,232,255,.5) 55%,#2f9bff);box-shadow:0 0 8px #2f9bff');
            st.animate([{ transform: 'translate(-50%,-50%) rotate(' + ang + 'deg)' }, { transform: 'translate(calc(-50% + ' + (tx - a.x) + 'px),calc(-50% + ' + (ty - a.y) + 'px)) rotate(' + ang + 'deg)' }], { duration: 230 + Math.random() * 70, easing: 'linear' }).onfinish = (function (tx, ty, ang, st) { return function () { st.remove(); hitPoint(fxf, tx, ty); spark(fxf, tx, ty, ang, 'dot', 'small', '#bfefff'); }; })(tx, ty, ang, st);
          }
          dmgNum(fxf, cx0 + cr.width * 0.5, cy0 + cr.height * 0.42, '-350');
          card.animate([{ transform: 'translate(0,0)' }, { transform: 'translate(5px,0)', offset: .3 }, { transform: 'translate(0,0)' }], { duration: 300, easing: 'ease-out', composite: 'add' });
        }, chargeT + 80);
      }
      play(); setInterval(play, (cfg.chargeT || 620) + 2200);
      return { play: play };
    }

    function runBit(stage, cfg) {
      const s = setupStage(stage), fxf = s.fxf, card = s.card;
      const svg = document.createElementNS(SVGNS, 'svg');
      svg.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:4;overflow:visible'; stage.appendChild(svg);
      function play() {
        fxf.innerHTML = ''; svg.innerHTML = '';
        const r = stage.getBoundingClientRect(); if (!r.width) return;
        svg.setAttribute('viewBox', '0 0 ' + r.width + ' ' + r.height);
        const a = { x: r.width * 0.27, y: r.height * 0.5 }; const cr = card.getBoundingClientRect();
        const tx = (cr.left - r.left) + cr.width * 0.42, ty = (cr.top - r.top) + cr.height * 0.45;
        const c1 = { x: a.x + r.width * 0.14, y: a.y - r.height * 0.32 }, c2 = { x: (a.x + tx) / 2, y: ty - r.height * 0.3 };
        const d = 'M ' + a.x + ' ' + a.y + ' C ' + c1.x + ' ' + c1.y + ' ' + c2.x + ' ' + c2.y + ' ' + tx + ' ' + ty;
        trailPath(svg, d, 640, '#8fe0ff');
        const pod = el(fxf, '', 'position:absolute;left:0;top:0;width:18px;height:13px;background:linear-gradient(90deg,#5bc8ff,#eafaff);box-shadow:0 0 12px #6fd3ff;clip-path:polygon(100% 50%,0 0,0 100%);z-index:6');
        pod.style.offsetPath = "path('" + d + "')"; pod.style.offsetRotate = 'auto'; pod.style.offsetDistance = '0%';
        pod.animate([{ offsetDistance: '0%' }, { offsetDistance: '100%' }], { duration: 640, easing: 'ease-in-out', fill: 'forwards' }).onfinish = function () {
          el(fxf, '', 'position:absolute;left:' + tx + 'px;top:' + ty + 'px;width:14px;height:14px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#fff,#9fe8ff 55%,transparent 74%)').animate([{ opacity: .9, transform: 'translate(-50%,-50%) scale(.5)' }, { opacity: 0, transform: 'translate(-50%,-50%) scale(1.3)' }], { duration: 240, fill: 'forwards' });
          hitPoint(fxf, tx, ty); spark(fxf, tx, ty, 0, 'dot', 'small', '#bfefff');
          dmgNum(fxf, tx, ty, '-350');
          card.animate([{ transform: 'translate(0,0)' }, { transform: 'translate(5px,0)', offset: .3 }, { transform: 'translate(0,0)' }], { duration: 300, composite: 'add' });
          // 飛回
          const bp = { x: a.x, y: a.y }, bc = { x: (tx + bp.x) / 2, y: Math.min(ty, bp.y) - r.height * 0.32 };
          const d2 = 'M ' + tx + ' ' + ty + ' C ' + bc.x + ' ' + bc.y + ' ' + bc.x + ' ' + bc.y + ' ' + bp.x + ' ' + bp.y;
          setTimeout(function () {
            trailPath(svg, d2, 440, '#8fe0ff');
            pod.style.offsetPath = "path('" + d2 + "')"; pod.style.offsetDistance = '0%';
            pod.animate([{ offsetDistance: '0%' }, { offsetDistance: '100%' }], { duration: 440, easing: 'ease-in-out', fill: 'forwards' }).onfinish = function () { try { pod.remove(); } catch (e) {} };
          }, 260);
        };
      }
      play(); setInterval(play, 2900);
      return { play: play };
    }

    function runCharge(stage, cfg) {
      const s = setupStage(stage), fxf = s.fxf, card = s.card;
      function play() {
        fxf.innerHTML = '';
        const r = stage.getBoundingClientRect(); if (!r.width) return;
        const a = { x: r.width * 0.27, y: r.height * 0.5 }; const cr = card.getBoundingClientRect();
        const p = { x: (cr.left - r.left) + cr.width * 0.5, y: (cr.top - r.top) + cr.height * 0.5 };
        for (let k = 0; k < 3; k++) setTimeout(function () {
          const c = el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;width:40px;height:40px;border-radius:50%;border:3px solid #9fe8ff;box-shadow:0 0 10px #9fe8ff;transform:translate(-50%,-50%)');
          c.animate([{ transform: 'translate(-50%,-50%) scale(1.8)', opacity: 0 }, { transform: 'translate(-50%,-50%) scale(1.8)', opacity: .85, offset: .18 }, { transform: 'translate(-50%,-50%) scale(.25)', opacity: 0 }], { duration: 440, easing: 'ease-in', fill: 'forwards' });
          setTimeout(function () { try { c.remove(); } catch (e) {} }, 460);
        }, k * 120);
        setTimeout(function () {
          const len = Math.hypot(p.x - a.x, p.y - a.y) + 26, ang = Math.atan2(p.y - a.y, p.x - a.x) * 180 / Math.PI, h = 22;
          const beam = el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;height:' + h + 'px;margin-top:' + (-h / 2) + 'px;width:' + len + 'px;border-radius:' + h + 'px;transform-origin:left center;background:linear-gradient(90deg,#9fe8ff,#2f9bff);box-shadow:0 0 18px #2f9bff');
          beam.animate([
            { transform: 'rotate(' + ang + 'deg) scaleY(1)', opacity: 0 },
            { transform: 'rotate(' + ang + 'deg) scaleY(1)', opacity: 1, offset: .1 },
            { transform: 'rotate(' + ang + 'deg) scaleY(1)', opacity: 1, offset: .78 },
            { transform: 'rotate(' + ang + 'deg) scaleY(.14)', opacity: 1, offset: .92 },
            { transform: 'rotate(' + ang + 'deg) scaleY(.14)', opacity: 0 },
          ], { duration: 780, easing: 'ease-out', fill: 'forwards' });
          setTimeout(function () { try { beam.remove(); } catch (e) {} }, 840);
          el(fxf, '', 'position:absolute;left:' + p.x + 'px;top:' + p.y + 'px;width:30px;height:30px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#fff,#9fe8ff 50%,transparent 72%)').animate([{ opacity: .9, transform: 'translate(-50%,-50%) scale(.4)' }, { opacity: 0, transform: 'translate(-50%,-50%) scale(1.5)' }], { duration: 420, easing: 'ease-out', fill: 'forwards' });
          spark(fxf, p.x, p.y, ang, 'line', 'med', '#9fe8ff');
          dmgNum(fxf, p.x, p.y, '-999!');
        }, 420);
      }
      play(); setInterval(play, 2600);
      return { play: play };
    }

    function runWave(stage, cfg) {   // 被砍掉的「波動」：一圈圈往外推的聲波／能量波（格鬥遊戲味，非鋼彈）
      const s = setupStage(stage), fxf = s.fxf, card = s.card;
      function play() {
        fxf.innerHTML = '';
        const r = stage.getBoundingClientRect(); if (!r.width) return;
        const a = { x: r.width * 0.27, y: r.height * 0.5 };
        const cr = card.getBoundingClientRect(); const p = { x: (cr.left - r.left) + cr.width * 0.5, y: (cr.top - r.top) + cr.height * 0.5 };
        const n = 4;
        for (let k = 0; k < n; k++) setTimeout(function () {
          const w = el(fxf, '', 'position:absolute;left:' + a.x + 'px;top:' + a.y + 'px;width:46px;height:74px;border:5px solid transparent;border-right-color:#7fd0ff;border-radius:50%;transform:translate(-50%,-50%);filter:drop-shadow(0 0 5px #fff)');
          w.animate([{ transform: 'translate(-50%,-50%) scale(.45)', opacity: 0 }, { transform: 'translate(-50%,-50%) scale(.85)', opacity: .95, offset: .2 }, { transform: 'translate(calc(-50% + ' + (p.x - a.x) + 'px),-50%) scale(1.9)', opacity: 0 }], { duration: 580, easing: 'ease-out', fill: 'forwards' });
          setTimeout(function () { try { w.remove(); } catch (e) {} }, 640);
        }, k * 100);
        setTimeout(function () {
          el(fxf, '', 'position:absolute;left:' + p.x + 'px;top:' + p.y + 'px;width:36px;height:36px;border-radius:50%;border:3px solid #c9a3ff;transform:translate(-50%,-50%)').animate([{ transform: 'translate(-50%,-50%) scale(.4)', opacity: .9 }, { transform: 'translate(-50%,-50%) scale(1.6)', opacity: 0 }], { duration: 420, easing: 'ease-out', fill: 'forwards' });
          dmgNum(fxf, p.x, p.y, '-350');
          card.animate([{ transform: 'translate(0,0)' }, { transform: 'translate(5px,0)', offset: .3 }, { transform: 'translate(0,0)' }], { duration: 300, composite: 'add' });
        }, n * 100 + 320);
      }
      play(); setInterval(play, 2400);
      return { play: play };
    }
    function beamSeg(layer, x, y, len, angDeg, h) {   // 一段雷射：從(x,y)沿角度長出來→停留→消
      const n = el(layer, '', 'position:absolute;left:' + x + 'px;top:' + y + 'px;height:' + h + 'px;margin-top:' + (-h / 2) + 'px;width:' + len + 'px;border-radius:' + h + 'px;transform-origin:left center;background:linear-gradient(90deg,#9fe8ff,#2f9bff);box-shadow:0 0 12px #2f9bff');
      n.animate([{ transform: 'rotate(' + angDeg + 'deg) scaleX(0)', opacity: .6 }, { transform: 'rotate(' + angDeg + 'deg) scaleX(1)', opacity: 1, offset: .12 }, { transform: 'rotate(' + angDeg + 'deg) scaleX(1)', opacity: 1, offset: .72 }, { transform: 'rotate(' + angDeg + 'deg) scaleX(1)', opacity: 0 }], { duration: 760, easing: 'ease-out', fill: 'forwards' });
      setTimeout(function () { try { n.remove(); } catch (e) {} }, 800);
    }
    function heatHole(card, lx, ly) {   // 灼熱貫穿孔（白→黃→橘→紅）
      const n = el(card, '', 'position:absolute;left:' + lx + 'px;top:' + ly + 'px;width:16px;height:16px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#fff 15%,#ffe26a 33%,#ff8a1f 55%,#e6300f 76%,transparent 92%);box-shadow:0 0 13px #ff7a1f,0 0 5px #fff;z-index:4');
      n.animate([{ opacity: 0, transform: 'translate(-50%,-50%) scale(.2)' }, { opacity: 1, transform: 'translate(-50%,-50%) scale(1)', offset: .12 }, { opacity: 1, offset: .6 }, { opacity: 0 }], { duration: 1100, easing: 'ease-out', fill: 'forwards' });
      setTimeout(function () { try { n.remove(); } catch (e) {} }, 1150);
    }
    function runSnipeBeam(stage, cfg) {   // 狙擊雷射貫穿：入射雷射→卡上灼熱孔/白光點→卡後仍有一條貫穿雷射(關鍵差異)
      const s = setupStage(stage), fxb = s.fxb, fxf = s.fxf, card = s.card;
      function play() {
        fxf.innerHTML = ''; fxb.innerHTML = '';
        const r = stage.getBoundingClientRect(); if (!r.width) return;
        const a = { x: r.width * 0.27, y: r.height * 0.5 };
        const cr = card.getBoundingClientRect(); const p = { x: (cr.left - r.left) + cr.width * 0.5, y: (cr.top - r.top) + cr.height * 0.5 };
        const ang = Math.atan2(p.y - a.y, p.x - a.x) * 180 / Math.PI, h = 14;
        const cross = el(fxf, '', 'position:absolute;left:' + p.x + 'px;top:' + p.y + 'px;width:34px;height:34px;border-radius:50%;border:2px solid rgba(159,232,255,.85);transform:translate(-50%,-50%)');
        cross.animate([{ opacity: 0, transform: 'translate(-50%,-50%) scale(1.6)' }, { opacity: 1, transform: 'translate(-50%,-50%) scale(1)', offset: .5 }, { opacity: .5 }], { duration: 300, fill: 'forwards' });
        setTimeout(function () { try { cross.remove(); } catch (e) {} }, 340);
        setTimeout(function () {
          beamSeg(fxf, a.x, a.y, Math.hypot(p.x - a.x, p.y - a.y), ang, h);   // 入射(到卡)
          beamSeg(fxb, p.x, p.y, (r.width - p.x) + 40, ang, h);               // 出射貫穿(卡後層→繼續穿出畫面)
          heatHole(card, p.x - (cr.left - r.left), p.y - (cr.top - r.top));
          hitPoint(fxf, p.x, p.y, true);
          spark(fxf, p.x, p.y, ang + 180, 'line', 'med', '#bfefff');
          spark(fxb, p.x + 56, p.y, ang, 'line', 'large', '#bfefff');
          dmgNum(fxf, p.x, p.y, '-999!');
          card.animate([{ transform: 'translate(0,0)' }, { transform: 'translate(6px,0)', offset: .3 }, { transform: 'translate(0,0)' }], { duration: 340, composite: 'add' });
        }, 360);
      }
      play(); setInterval(play, 2600);
      return { play: play };
    }
    function buildDiffuseTuner(root, cfg, play) {
      const ctrl = el(root, 'sd-ctrl');
      ctrl.innerHTML =
        '<div class="sd-row"><label>線數</label><input type="range" class="sd-range" data-k="lines" min="3" max="9" value="' + cfg.lines + '"><span class="sd-val">' + cfg.lines + '</span></div>' +
        '<div class="sd-row"><label>蓄力</label><input type="range" class="sd-range" data-k="chargeT" min="300" max="1100" step="20" value="' + cfg.chargeT + '"><span class="sd-val">' + cfg.chargeT + 'ms</span></div>' +
        '<button class="sd-replay">▶ 重播</button>';
      ctrl.querySelectorAll('.sd-range').forEach(function (rg) {
        rg.addEventListener('input', function () { const k = rg.getAttribute('data-k'); cfg[k] = +rg.value; rg.nextElementSibling.textContent = k === 'chargeT' ? rg.value + 'ms' : rg.value; play(); });
      });
      ctrl.querySelector('.sd-replay').addEventListener('click', play);
    }

    function init() {
      document.querySelectorAll('.snipe-demo').forEach(function (root) {
        if (root.dataset.sdInit) return; root.dataset.sdInit = '1';
        const v = root.getAttribute('data-variant') || 'final';
        const cfg = Object.assign({}, VARIANTS[v] || VARIANTS.final);
        if (v === 'tuner') {
          root.classList.add('sd-tuner');
          const stage = el(root, 'sd-stage'); if (root.getAttribute('data-size')) stage.setAttribute('data-size', root.getAttribute('data-size'));
          const api = runScene(stage, cfg);
          buildTuner(root, cfg, api.play);
        } else if (v === 'diffuse-tuner') {
          root.classList.add('sd-tuner');
          const stage = el(root, 'sd-stage'); if (root.getAttribute('data-size')) stage.setAttribute('data-size', root.getAttribute('data-size'));
          const api = runDiffuse(stage, cfg);
          buildDiffuseTuner(root, cfg, api.play);
        } else if (v === 'diffuse') { runDiffuse(root, cfg); }
        else if (v === 'bit') { runBit(root, cfg); }
        else if (v === 'charge') { runCharge(root, cfg); }
        else if (v === 'wave') { runWave(root, cfg); }
        else if (v === 'snipebeam') { runSnipeBeam(root, cfg); }
        else { runScene(root, cfg); }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
