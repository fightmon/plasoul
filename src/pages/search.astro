---
import Layout from "../layouts/Layout.astro";

/**
 * /search · 找便宜（W2）
 * - 純 SSG 殼，client 讀 query string → fetch /api/public/search → 渲染報價卡
 * - 一筆 listing 一張卡（左圖右資訊），照價格排序
 * - 「前往」走 /api/go/:id 轉址（source_url 不進 HTML，法律紅線）
 */
---

<Layout title="搜尋 · 普拉魂" hideHeaderSearch={true}>
  <main class="ps-search-page">
    <section class="ps-search-hero">
      <h1 class="ps-search-title" id="ps-search-page-title">搜尋</h1>
      <form action="/search" method="get" class="ps-search-form" role="search">
        <input
          type="search"
          name="q"
          id="ps-search-input"
          placeholder="牛鋼 / RX-78-2 / 命運..."
          class="ps-search-input"
          autocomplete="off"
        />
        <button type="submit" class="ps-search-submit">搜尋</button>
      </form>
    </section>

    {/* 空狀態 */}
    <section class="ps-empty" id="ps-empty-state">
      <div class="ps-empty-icon" aria-hidden="true">🔍</div>
      <h2 class="ps-empty-title">想找哪一盒？</h2>
      <p class="ps-empty-text">
        試試 <a href="/search?series=RG">RG</a>、<a href="/search?series=MG">MG</a>、<a href="/search?q=自由">自由</a>
      </p>
    </section>

    {/* 載入中 */}
    <section class="ps-loading" id="ps-loading" hidden>
      <div class="ps-spinner" aria-hidden="true"></div>
      <p>搜尋中…</p>
    </section>

    {/* 結果 */}
    <section class="ps-results-wrap" id="ps-results-wrap" hidden>
      <div class="ps-results-head">
        <span id="ps-results-count" class="ps-results-count"></span>
        <label class="ps-sort">
          排序
          <select id="ps-sort-select" class="ps-sort-select">
            <option value="price">價格低 → 高</option>
            <option value="price_desc">價格高 → 低</option>
            <option value="newest">最新</option>
          </select>
        </label>
      </div>
      <div class="ps-results" id="ps-results"></div>
    </section>

    {/* 無結果 */}
    <section class="ps-empty" id="ps-noresult" hidden>
      <div class="ps-empty-icon" aria-hidden="true">🤷</div>
      <h2 class="ps-empty-title">沒找到「<span id="ps-noresult-q"></span>」</h2>
      <p class="ps-empty-text">換個關鍵字，或試試 <a href="/search?series=RG">RG</a> / <a href="/search?series=MG">MG</a></p>
    </section>
  </main>
</Layout>

<style>
  .ps-search-page { max-width: 880px; margin: 0 auto; padding: 32px 16px 80px; }

  .ps-search-hero { margin-bottom: 28px; text-align: center; }
  .ps-search-title { font-size: clamp(20px, 4vw, 28px); font-weight: 700; color: var(--color-text); margin: 0 0 20px; }
  .ps-search-form { display: flex; gap: 8px; max-width: 600px; margin: 0 auto; }
  .ps-search-input {
    flex: 1; min-width: 0; padding: 14px 18px; font-size: 16px;
    background: var(--color-input-bg); border: 2px solid var(--color-border);
    border-radius: var(--radius-pill); color: var(--color-text); outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .ps-search-input:focus { border-color: var(--color-primary); box-shadow: 0 0 0 4px var(--color-primary-light); }
  .ps-search-submit {
    padding: 0 24px; background: var(--color-primary); color: #fff; border: none;
    border-radius: var(--radius-pill); font-weight: 700; cursor: pointer; transition: background-color 0.15s;
  }
  .ps-search-submit:hover { background: var(--color-primary-dark); }

  /* 空 / 無結果 */
  .ps-empty {
    text-align: center; padding: 56px 16px; background: var(--color-card);
    border-radius: var(--radius); border: 1px solid var(--color-border-subtle); box-shadow: var(--shadow-sm);
  }
  .ps-empty-icon { font-size: 52px; margin-bottom: 14px; opacity: 0.6; }
  .ps-empty-title { font-size: 20px; font-weight: 700; color: var(--color-text); margin: 0 0 8px; }
  .ps-empty-text { color: var(--color-text-secondary); margin: 0; }
  .ps-empty-text a { color: var(--color-primary); text-decoration: none; font-weight: 600; }
  .ps-empty-text a:hover { text-decoration: underline; }

  /* 載入 */
  .ps-loading { text-align: center; padding: 48px 16px; color: var(--color-text-secondary); }
  .ps-spinner {
    width: 32px; height: 32px; margin: 0 auto 12px; border-radius: 50%;
    border: 3px solid var(--color-border); border-top-color: var(--color-primary);
    animation: ps-spin 0.7s linear infinite;
  }
  @keyframes ps-spin { to { transform: rotate(360deg); } }

  /* 結果頭 */
  .ps-results-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px; gap: 12px;
  }
  .ps-results-count { font-size: 14px; color: var(--color-text-secondary); font-weight: 600; }
  .ps-sort { font-size: 13px; color: var(--color-text-secondary); display: inline-flex; align-items: center; gap: 6px; }
  .ps-sort-select {
    font-size: 13px; padding: 6px 10px; border-radius: 8px;
    border: 1px solid var(--color-border); background: var(--color-card); color: var(--color-text); cursor: pointer;
  }

  /* 結果清單 + 報價卡 */
  .ps-results { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }

  .ps-offer {
    display: flex; gap: 14px; align-items: stretch;
    background: var(--color-card); border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm); padding: 14px; box-shadow: var(--shadow-sm);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .ps-offer:hover { border-color: var(--color-primary); box-shadow: var(--shadow); }
  .ps-offer-img {
    flex: 0 0 96px; width: 96px; height: 96px; border-radius: 10px; overflow: hidden;
    background: var(--color-bg); display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--color-border-subtle);
  }
  .ps-offer-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ps-offer-img .ph { font-size: 30px; opacity: 0.4; }
  .ps-offer-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 7px; }
  .ps-offer-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .ps-offer-name {
    font-size: 15px; font-weight: 700; color: var(--color-text); line-height: 1.35;
    text-decoration: none; min-width: 0; word-break: break-word;
  }
  .ps-offer-name:hover { color: var(--color-primary); }
  .ps-offer-price {
    font-size: 19px; font-weight: 800; color: var(--color-accent);
    white-space: nowrap; font-variant-numeric: tabular-nums; letter-spacing: -0.3px;
  }
  .ps-offer-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .ps-chip {
    font-size: 11px; padding: 2px 9px; border-radius: 999px;
    background: var(--color-primary-light); color: var(--color-primary-dark); font-weight: 600;
  }
  .ps-offer-meta { font-size: 12.5px; color: var(--color-text-secondary); line-height: 1.5; }
  .ps-offer-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    margin-top: auto; padding-top: 8px; border-top: 1px dashed var(--color-border-subtle);
  }
  .ps-offer-src { font-size: 11.5px; color: var(--color-text-secondary); }
  .ps-offer-go {
    flex-shrink: 0; font-size: 13px; font-weight: 700; text-decoration: none;
    color: #fff; background: var(--color-primary); padding: 7px 14px; border-radius: 999px;
    transition: background-color 0.15s;
  }
  .ps-offer-go:hover { background: var(--color-primary-dark); }

  @media (max-width: 480px) {
    .ps-offer-img { flex-basis: 76px; width: 76px; height: 76px; }
    .ps-offer-price { font-size: 17px; }
  }
</style>

<script>
  const $ = (id: string) => document.getElementById(id);
  const params = new URLSearchParams(window.location.search);
  let q = (params.get('q') || '').trim();
  const series = (params.get('series') || '').trim();
  let sort = (params.get('sort') || 'price').trim();

  const titleEl = $('ps-search-page-title');
  const input = $('ps-search-input') as HTMLInputElement | null;
  const emptyEl = $('ps-empty-state');
  const loadingEl = $('ps-loading');
  const resultsWrap = $('ps-results-wrap');
  const resultsEl = $('ps-results');
  const countEl = $('ps-results-count');
  const noResultEl = $('ps-noresult');
  const sortSel = $('ps-sort-select') as HTMLSelectElement | null;

  const heading = q ? `「${q}」` : series ? `${series} 系列` : '搜尋';
  if (titleEl) titleEl.textContent = heading;
  if (q || series) document.title = `${heading} · 普拉魂`;
  if (input && q) input.value = q;
  if (sortSel) sortSel.value = sort;

  // Astro scoped 樣式不套到 JS 動態元素 → 從容器補 scope 屬性
  function applyScope(container: HTMLElement) {
    const attr = Array.from(container.attributes).map((a) => a.name).find((n) => n.startsWith('data-astro-cid'));
    if (attr) container.querySelectorAll('*').forEach((el) => el.setAttribute(attr, ''));
  }

  const esc = (s: string) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const timeAgo = (ms: number) => {
    if (!ms) return '';
    const d = Math.floor((Date.now() - ms) / 86400000);
    if (d <= 0) return '今天';
    if (d < 30) return `${d} 天前`;
    if (d < 365) return `${Math.floor(d / 30)} 個月前`;
    return `${Math.floor(d / 365)} 年前`;
  };

  function show(el: Element | null) { el?.removeAttribute('hidden'); }
  function hide(el: Element | null) { el?.setAttribute('hidden', ''); }

  function card(o: any): string {
    const img = o.cover_key
      ? `<img src="/api/screenshot/${encodeURIComponent(o.cover_key)}" alt="${esc(o.product_name)}" loading="lazy" />`
      : `<span class="ph" aria-hidden="true">🤖</span>`;
    const tags = [o.condition, o.series].filter(Boolean).map((t: string) => `<span class="ps-chip">${esc(t)}</span>`).join('');
    const meta = [o.shipping_text ? `📦 ${esc(o.shipping_text)}` : '', o.meetup_text ? `📍 ${esc(o.meetup_text)}` : ''].filter(Boolean).join('　');
    const go = o.has_link
      ? `<a class="ps-offer-go" href="/api/go/${esc(o.listing_id)}" target="_blank" rel="noopener nofollow">前往 →</a>`
      : '';
    const nameHtml = o.slug
      ? `<a class="ps-offer-name" href="/gundam/${esc(o.slug)}">${esc(o.product_name)}</a>`
      : `<span class="ps-offer-name ps-offer-name--plain">${esc(o.product_name)}</span>`;
    return `
      <div class="ps-offer">
        <div class="ps-offer-img">${img}</div>
        <div class="ps-offer-body">
          <div class="ps-offer-head">
            ${nameHtml}
            <div class="ps-offer-price">NT$ ${(o.price || 0).toLocaleString()}</div>
          </div>
          <div class="ps-offer-tags">${tags}</div>
          ${meta ? `<div class="ps-offer-meta">${meta}</div>` : ''}
          <div class="ps-offer-foot">
            <span class="ps-offer-src">玩家社群參考價 · ${timeAgo(o.created_at)}</span>
            ${go}
          </div>
        </div>
      </div>`;
  }

  async function run() {
    if (!q && !series) { show(emptyEl); return; }
    hide(emptyEl); hide(resultsWrap); hide(noResultEl); show(loadingEl);
    try {
      const usp = new URLSearchParams();
      if (q) usp.set('q', q);
      if (series) usp.set('series', series);
      usp.set('sort', sort);
      const res = await fetch(`/api/public/search?${usp.toString()}`);
      const data = await res.json();
      hide(loadingEl);
      const offers = (data && data.offers) || [];
      if (!offers.length) {
        const qe = $('ps-noresult-q'); if (qe) qe.textContent = q || series;
        show(noResultEl);
        return;
      }
      if (resultsEl) {
        resultsEl.innerHTML = offers.map(card).join('');
        applyScope(resultsEl as HTMLElement);
      }
      if (countEl) countEl.textContent = `找到 ${offers.length} 筆報價`;
      show(resultsWrap);
    } catch (e) {
      hide(loadingEl);
      const qe = $('ps-noresult-q'); if (qe) qe.textContent = q || series;
      show(noResultEl);
    }
  }

  // 換排序 → 重查
  sortSel?.addEventListener('change', () => {
    sort = sortSel.value;
    const usp = new URLSearchParams(window.location.search);
    usp.set('sort', sort);
    history.replaceState(null, '', `/search?${usp.toString()}`);
    run();
  });

  if (!q && !series && input) setTimeout(() => input.focus(), 50);
  run();
</script>
