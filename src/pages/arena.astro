<script>
  const $ = (id: string) => document.getElementById(id);
  const esc = (s: any) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const TYPE: any = { ranged: { t: '射', c: 't-ranged' }, melee: { t: '近', c: 't-melee' }, evade: { t: '閃', c: 't-evade' } };
  const TIER_MIN = [0, 200, 400, 700, 1000, 1300, 1600, 2000];
  const TIER_NAME = ['F', 'E', 'D', 'C', 'B', 'A', 'S', 'SS'];
  const RANK = (s: number) => { let t = 'F'; for (let k = 0; k < TIER_MIN.length; k++) if ((s || 0) >= TIER_MIN[k]) t = TIER_NAME[k]; return t; };

  // 放話語氣：資料化（/data/tones.json 按需載入；之後可擴到上百種）
  let TONES: any = { hot: { name: '熱血', atk: ['上啊！', '看我的！'], crit: ['必殺！'], dodge: ['太天真了！'], ult: ['全力解放！'] } };  // 最小 fallback
  let TONE_KEYS: string[] = ['hot'];
  fetch('/data/tones.json').then((r) => (r.ok ? r.json() : null)).then((d) => { if (d && typeof d === 'object') { TONES = d; TONE_KEYS = Object.keys(d); } }).catch(() => {});
  const getTone = () => { try { const t = localStorage.getItem('ps_tone'); return t && TONES[t] ? t : 'hot'; } catch { return 'hot'; } };
  const setTone = (t: string) => { try { localStorage.setItem('ps_tone', t); } catch {} };
  const toneName = (t: string) => TONES[t] ? TONES[t].name : '熱血';

  // 招式目錄（每張卡依天性可多掛；moves=null 視為全掛）。射/近有招池；閃以反擊為主，暫不開放選招。
  const MOVE_POOL: any = { ranged: ['laser', 'cannon', 'shotgun', 'homing', 'wave', 'snipe', 'charge'], melee: ['slash', 'arc', 'cross', 'impact', 'iai', 'thrust', 'spin'] };
  const MOVE_NAME: any = { laser: '雷射', cannon: '加農炮', shotgun: '散彈槍', homing: '追蹤飛彈', wave: '能量波', snipe: '狙擊', charge: '蓄力炮', slash: '斬擊', arc: '弧斬', cross: '十字斬', impact: '衝擊波', iai: '居合', thrust: '突刺', spin: '迴旋斬' };
  // 解析卡片啟用的招式（給戰鬥隨機抽）：moves 為 JSON 字串；null/空/全選 → 全池
  const movesOf = (card: any, type: string): string[] => {
    const pool = MOVE_POOL[type]; if (!pool) return [];
    if (card && card.moves) { try { const m = JSON.parse(card.moves); if (Array.isArray(m) && m.length) { const f = pool.filter((x: string) => m.includes(x)); if (f.length) return f; } } catch {} }
    return pool;
  };

  let cards: any[] = [];
  let player: any = {};

  function toast(msg: string) {
    const t = $('ar-toast')!; t.textContent = msg; t.removeAttribute('hidden');
    setTimeout(() => t.setAttribute('hidden', ''), 1800);
  }

  // 進站：檢查登入
  (async () => {
    let me: any = null;
    try { const r = await fetch('/api/user/me', { credentials: 'include' }); if (r.ok) me = await r.json(); } catch {}
    if (!me || !me.ok) { $('ar-login')!.removeAttribute('hidden'); return; }
    $('ar-main')!.removeAttribute('hidden');
    $('ar-name')!.textContent = me.user.display_name || me.user.email.split('@')[0];
    await loadData();
  })();

  async function loadData() {
    try {
      const r = await fetch('/api/card/list', { credentials: 'include' });
      const d = await r.json();
      if (!d.ok) return;
      cards = d.cards || []; player = d.player || {};
      $('ar-parts')!.textContent = player.parts ?? 0;
      $('ar-coins')!.textContent = (player.coins ?? 0).toLocaleString();
      $('ar-rank')!.textContent = '段位 ' + RANK(player.rank_score || 0);
      renderFleet(); renderHangar();
    } catch {}
  }

  // 大廳：MVP 1 艘戰艦，顯示已編成的卡
  function renderFleet() {
    const byId: any = {}; cards.forEach((c) => byId[c.id] = c);
    const lineup = (player.ship_card_ids || []).map((id: string) => byId[id]).filter(Boolean);
    const hp = (player.ship_base_hp || 800) + lineup.reduce((s: number, c: any) => s + (c.hp || 0), 0);
    const slot = (c: any) => c
      ? `<div class="ar-slot">${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : '<span class="ar-empty">🤖</span>'}<span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span></div>`
      : `<div class="ar-slot"><span class="ar-empty">空格<br>點編成放卡</span></div>`;
    $('ar-fleet')!.innerHTML = `
      <div class="ar-ship">
        <div class="ar-ship-head"><span class="ar-ship-name">🚀 我的戰艦 <span style="font-size:11px;color:var(--ar-dim)">🛡️ 防守隊</span></span><span class="ar-ship-hp">HP <b>${hp.toLocaleString()}</b></span></div>
        <div class="ar-slots">${slot(lineup[0])}${slot(lineup[1])}${slot(lineup[2])}</div>
        <div class="ar-ship-acts">
          <button class="ar-sortie" id="ar-sortie">⚔️ 出擊</button>
          <button class="ar-edit" id="ar-edit">編成</button>
        </div>
      </div>`;
    $('ar-fleet')!.insertAdjacentHTML('beforeend', `<button class="ar-tone-chip" id="ar-tone">🗣️ 預設語氣：<b>${esc(toneName(getTone()))}</b><small>（未單獨設定的卡用這個）</small></button>`);
    $('ar-sortie')!.addEventListener('click', () => { if (!lineup.length) { toast('先按「編成」把卡放上戰艦'); return; } openMatch(); });
    $('ar-edit')!.addEventListener('click', openEquip);
    $('ar-tone')!.addEventListener('click', openTone);
  }

  function renderHangar() {
    $('ar-card-count')!.textContent = cards.length ? `（${cards.length} 張）` : '';
    if (!cards.length) {
      $('ar-cards')!.innerHTML = '<div class="ar-empty-hangar">還沒有戰鬥卡 🎴<br>按下方「＋ 拍照創卡」<br>拍你的鋼彈成品變成卡！</div>';
      return;
    }
    $('ar-cards')!.innerHTML = cards.map((c, i) => `
      <div class="ar-c c-${esc(c.rarity)}" data-i="${i}">
        <span class="ar-rar r-${esc(c.rarity)}">${esc(c.rarity)}</span>
        <div class="ar-c-img">${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : '<span class="ph">🤖</span>'}</div>
        <div class="ar-c-body">
          <div class="ar-c-name">${esc(c.name)}</div>
          <div class="ar-c-sub"><span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span><span class="ar-c-pow">戰力 ${(c.hp + c.atk + c.def + c.mob)}</span></div>
        </div>
      </div>`).join('');
    $('ar-cards')!.querySelectorAll('.ar-c').forEach((el) => el.addEventListener('click', () => showDetail(cards[parseInt((el as HTMLElement).dataset.i!, 10)])));
  }

  // 編成
  let equipSel: string[] = [];
  function openEquip() {
    equipSel = [...(player.ship_card_ids || [])].filter((id: string) => cards.some((c) => c.id === id)).slice(0, 3);
    const el = $('ar-equip')!;
    const byId: any = {}; cards.forEach((c) => byId[c.id] = c);
    const render = () => {
      const list = cards.length ? cards.map((c) => { const on = equipSel.includes(c.id); return `<div class="ar-eq-card ${on ? 'on' : ''}" data-id="${esc(c.id)}">${c.photo_url ? `<img src="${esc(c.photo_url)}"/>` : '<span class="ph">🤖</span>'}<span class="ar-tbadge ${TYPE[c.type]?.c}">${TYPE[c.type]?.t}</span>${on ? '<span class="ar-eq-chk">✓</span>' : ''}</div>`; }).join('') : '<div class="ar-eq-none">還沒有卡，先去格納庫創卡</div>';
      el.innerHTML = `<div class="ar-eq-box"><div class="ar-eq-head"><b>編成戰艦</b><button class="x-btn" id="ar-eq-x">✕</button></div><div class="ar-eq-hint">點卡片放上 / 取下（最多 3 張）　已選 <b style="color:#ffd23d">${equipSel.length}</b>/3　🛡️ 此艦同時為防守隊</div><div class="ar-eq-list">${list}</div><div class="ar-eq-foot"><button class="ar-rv-close" id="ar-eq-save">儲存編成</button></div></div>`;
      $('ar-eq-x')!.addEventListener('click', closeEquip);
      $('ar-eq-save')!.addEventListener('click', saveEquip);
      el.querySelectorAll('.ar-eq-card').forEach((d) => d.addEventListener('click', () => {
        const id = (d as HTMLElement).dataset.id!;
        if (equipSel.includes(id)) equipSel = equipSel.filter((x) => x !== id);
        else if (equipSel.length < 3) equipSel.push(id);
        else { toast('最多 3 張'); return; }
        render();
      }));
    };
    el.removeAttribute('hidden'); render();
  }
  function closeEquip() { const el = $('ar-equip')!; el.setAttribute('hidden', ''); el.innerHTML = ''; }
  async function saveEquip() {
    try {
      const r = await fetch('/api/card/equip', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ card_ids: equipSel }) });
      const d = await r.json();
      if (!r.ok || !d.ok) { toast((d && d.message) || '儲存失敗'); return; }
      closeEquip(); toast('編成已儲存 ✅'); await loadData();
    } catch { toast('網路錯誤'); }
  }

  // 天梯：選對手
  let ladderCache: any = null;
  async function openMatch() {
    const el = $('ar-match')!;
    el.innerHTML = '<div class="ar-bt-loading"><div class="ar-spin"></div><div>搜尋對手中…</div></div>';
    el.removeAttribute('hidden');
    try {
      const r = await fetch('/api/card/ladder', { credentials: 'include' });
      const d = await r.json();
      if (!d.ok) { el.setAttribute('hidden', ''); el.innerHTML = ''; toast('對手載入失敗'); return; }
      ladderCache = d; renderMatch(d);
    } catch { el.setAttribute('hidden', ''); el.innerHTML = ''; toast('網路錯誤'); }
  }
  function closeMatch() { const el = $('ar-match')!; el.setAttribute('hidden', ''); el.innerHTML = ''; }
  function openTone() {
    const el = $('ar-tone-modal')!; const cur = getTone();
    el.innerHTML = `<div class="ar-modal-box ar-match-box"><div class="ar-modal-head"><b>🗣️ 預設放話語氣</b><button class="ar-x" id="ar-tone-x">✕</button></div><div class="ar-tone-list">${TONE_KEYS.map((k) => `<button class="ar-tone-opt${k === cur ? ' on' : ''}" data-k="${k}"><b>${esc(toneName(k))}</b><small>「${esc(TONES[k].atk[0])}」</small></button>`).join('')}</div></div>`;
    el.removeAttribute('hidden');
    $('ar-tone-x')!.addEventListener('click', () => { el.setAttribute('hidden', ''); el.innerHTML = ''; });
    el.querySelectorAll('.ar-tone-opt').forEach((b) => b.addEventListener('click', () => { setTone((b as HTMLElement).dataset.k!); el.setAttribute('hidden', ''); el.innerHTML = ''; renderFleet(); toast('語氣已設定 ✅'); }));
  }
  function renderMatch(d: any) {
    const cand = (d.candidates || []).map((o: any, i: number) => {
      const fleet = (o.fleet || []).map((c: any) => `<div class="ar-mc"><div class="ar-mc-img">${c.photo ? `<img src="${esc(c.photo)}"/>` : '<span>👾</span>'}<span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span><span class="ar-mc-r r-${esc(c.rarity)}">${esc(c.rarity)}</span></div></div>`).join('');
      return `<div class="ar-opp" data-oid="${esc(o.user_id)}">
        <div class="ar-opp-head"><span class="ar-opp-name">${esc(o.name)}</span><span class="ar-opp-score">${o.rank_score} 分</span></div>
        <div class="ar-opp-fleet">${fleet}</div>
        <button class="ar-sortie ar-opp-go" data-oid="${esc(o.user_id)}">⚔️ 挑戰</button>
      </div>`;
    }).join('');
    const myRank = d.me.rank ? `#${d.me.rank}` : '未上榜';
    $('ar-match')!.innerHTML = `<div class="ar-modal-box ar-match-box">
      <div class="ar-modal-head"><b>⚔️ 選擇對手</b><button class="ar-x" id="ar-match-x">✕</button></div>
      <div class="ar-match-me">我的名次 <b>${myRank}</b> · ${d.me.rank_score} 分</div>
      <div class="ar-opps">${cand || '<div class="ar-empty-hangar">目前找不到對手</div>'}</div>
      <button class="ar-edit" id="ar-match-refresh" style="width:100%;margin-top:4px">🔄 換一批對手</button>
    </div>`;
    $('ar-match-x')!.addEventListener('click', closeMatch);
    $('ar-match-refresh')!.addEventListener('click', openMatch);
    $('ar-match')!.querySelectorAll('.ar-opp-go').forEach((b) => b.addEventListener('click', () => { const oid = (b as HTMLElement).dataset.oid!; closeMatch(); doBattle(oid); }));
  }

  // 戰鬥
  async function doBattle(opponentId?: string) {
    const el = $('ar-battle')!;
    el.innerHTML = '<div class="ar-bt-loading"><div class="ar-spin"></div><div>出擊中…</div></div>';
    el.removeAttribute('hidden');
    let d: any = null;
    try {
      const r = await fetch('/api/card/battle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(opponentId ? { opponent_id: opponentId } : {}) });
      d = await r.json(); if (!r.ok || !d.ok) { el.setAttribute('hidden', ''); el.innerHTML = ''; toast((d && d.message) || '出擊失敗'); return; }
    } catch { el.setAttribute('hidden', ''); el.innerHTML = ''; toast('網路錯誤'); return; }
    animateBattle(d);
  }
  function animateBattle(d: any) {
    const el = $('ar-battle')!;
    const myMax = d.my.maxHP, foeMax = d.foe.maxHP;
    const myTeam = d.my.team || [], foeTeam = d.foe.team || [];
    const tcls = (t: string) => t === 'ranged' ? 't-ranged' : t === 'melee' ? 't-melee' : 't-evade';
    const tlab = (t: string) => ({ ranged: '射', melee: '近', evade: '閃' } as any)[t] || '?';
    const unit = (c: any, side: string, k: number) => `<div class="bt-u ${side}-side" id="bt-${side}-${k}">${c.photo ? `<img src="${esc(c.photo)}"/>` : `<div class="bt-noimg ${tcls(c.type)}">${side === 'foe' ? '👾' : '🤖'}</div>`}<span class="bt-tb ${tcls(c.type)}">${tlab(c.type)}</span><span class="bt-uname">${esc(c.name)}</span></div>`;
    el.innerHTML = `<div class="ar-bt-box">
      <div class="ar-bt-stars"></div>
      <div class="bt-hd">
        <div class="bt-hd-side"><div class="bt-pname">我方</div><div class="ar-bar"><i id="bt-my" style="width:100%"></i></div></div>
        <div class="bt-round" id="bt-round">VS</div>
        <div class="bt-hd-side foe"><div class="bt-pname">${esc(d.foe.name)}</div><div class="ar-bar foe"><i id="bt-foe" style="width:100%"></i></div></div>
      </div>
      <div class="bt-field" id="bt-field"><div class="bt-darken" id="bt-darken"></div>${myTeam.map((c: any, k: number) => unit(c, 'my', k)).join('')}${foeTeam.map((c: any, k: number) => unit(c, 'foe', k)).join('')}<div class="bt-fx" id="bt-fx"></div><div class="bt-banner" id="bt-banner"></div></div>
      <div class="bt-talk" id="bt-talk"></div>
      <div class="bt-foot"><button class="bt-skip" id="bt-skip">跳過 ⏩</button></div>
      <div id="bt-end"></div>
    </div>`;
    const lines = d.log || []; let i = 0; const timers: any[] = []; let skipped = false; let aMy = 0, aFoe = 0;
    const SLOT = ['14%', '36%', '58%'];   // 上中段叢集，營造小隊感
    const U = (side: string, k: number) => $(`bt-${side}-${k}`);
    const place = (side: string, k: number, active: boolean) => { const u = U(side, k); if (!u) return; u.classList.remove('hit', 'dodge', 'lunge', 'ult', 'dim', 'won'); u.classList.toggle('active', active); u.style.top = active ? '36%' : SLOT[k]; if (side === 'my') u.style.left = active ? '13%' : '3%'; else u.style.right = active ? '13%' : '3%'; };
    const reset = () => { [0, 1, 2].forEach((k) => { place('my', k, false); place('foe', k, false); }); $('bt-fx')!.innerHTML = ''; };
    const setHP = (my: number, foe: number) => { const mb = $('bt-my'), fb = $('bt-foe'); if (mb) (mb as HTMLElement).style.width = Math.max(0, Math.round(my / myMax * 100)) + '%'; if (fb) (fb as HTMLElement).style.width = Math.max(0, Math.round(foe / foeMax * 100)) + '%'; };
    const shake = () => { const f = $('bt-field')!; f.classList.add('shake'); setTimeout(() => f.classList.remove('shake'), 320); };
    // 放話（依語氣；LINE 風：我方左、對方右，帶說話卡頭像）
    const pickL = (a: string[]) => a[Math.floor(Math.random() * a.length)];
    const toneOf = (side: string) => { const c = side === 'my' ? myTeam[aMy] : foeTeam[aFoe]; if (c && c.tone_id && TONES[c.tone_id]) return c.tone_id; return side === 'my' ? getTone() : TONE_KEYS[Math.floor(Math.random() * TONE_KEYS.length)]; };
    const say = (side: string, situ: string) => {
      const tk = toneOf(side); const p = TONES[tk] && TONES[tk][situ]; if (!p || !p.length) return;
      const card = side === 'my' ? myTeam[aMy] : foeTeam[aFoe];
      const av = card && card.photo ? `<img src="${esc(card.photo)}" alt=""/>` : (side === 'my' ? '🤖' : '👾');
      const t = $('bt-talk'); if (!t) return;
      const row = document.createElement('div'); row.className = 'bt-row ' + (side === 'my' ? 'me' : 'foe');
      row.innerHTML = `<div class="bt-bubble"><div class="bt-av">${av}</div><span>${esc(pickL(p))}</span></div>`;
      t.appendChild(row);
      while (t.children.length > 2) t.removeChild(t.firstChild as Node);   // 超過 2 欄 → 最舊往上擠掉
      setTimeout(() => { row.style.opacity = '0'; setTimeout(() => row.remove(), 220); }, 2800);   // 靜置後自動淡出
    };
    // 以「卡片實際位置」為基準算特效座標（永遠對準目標卡正中）
    const cen = (el: HTMLElement | null) => { const fr = $('bt-field')!.getBoundingClientRect(); if (!el) return { x: fr.width / 2, y: fr.height / 2 }; const r = el.getBoundingClientRect(); return { x: r.left + r.width / 2 - fr.left, y: r.top + r.height / 2 - fr.top }; };
    const laserFx = (attEl: HTMLElement | null, defEl: HTMLElement | null, big: boolean, side: string, weak = false, miss = false) => { if (!attEl || !defEl) return; const a = cen(attEl), b = cen(defEl); if (miss) { const fr = $('bt-field')!.getBoundingClientRect(); b.x = side === 'my' ? fr.width + 80 : -80; b.y -= 14; } const dx = b.x - a.x, dy = b.y - a.y; const len = Math.hypot(dx, dy); const ang = Math.atan2(dy, dx) * 180 / Math.PI; const n = document.createElement('div'); n.className = 'bt-laser ' + (side === 'my' ? 'l-my' : 'l-foe') + (big ? ' big' : '') + (weak ? ' weak' : ''); n.style.left = a.x + 'px'; n.style.top = a.y + 'px'; n.style.width = len + 'px'; n.style.transform = 'rotate(' + ang + 'deg)'; n.innerHTML = '<i></i>'; $('bt-fx')!.appendChild(n); setTimeout(() => n.remove(), 550); };
    const slashFx = (defEl: HTMLElement | null, big: boolean) => { if (!defEl) return; const c = cen(defEl); const n = document.createElement('div'); n.className = 'bt-slash' + (big ? ' big' : ''); n.style.left = c.x + 'px'; n.style.top = c.y + 'px'; $('bt-fx')!.appendChild(n); setTimeout(() => n.remove(), 500); };
    const dmgNum = (defEl: HTMLElement | null, text: string, cls: string) => { if (!defEl) return; const c = cen(defEl); const n = document.createElement('div'); n.className = 'bt-dmg ' + cls; n.textContent = text; n.style.left = c.x + 'px'; n.style.top = c.y + 'px'; $('bt-fx')!.appendChild(n); setTimeout(() => n.remove(), 850); };
    // 近身衝刺：動態算到對方卡位置（ratio 0.82=疊到對方卡上、0.5=中間相撞）
    const lungeTo = (atkSide: string, atkK: number, defSide: string, defK: number, ratio: number) => { const aEl = U(atkSide, atkK), dEl = U(defSide, defK); if (!aEl || !dEl) return; const a = cen(aEl), b = cen(dEl); const dx = (b.x - a.x) * ratio, dy = (b.y - a.y) * ratio; aEl.style.zIndex = '8'; aEl.style.transform = `translate(${dx}px,${dy}px) scale(1.18)`; setTimeout(() => { if (aEl) { aEl.style.transform = ''; aEl.style.zIndex = ''; } }, 380); };
    const dodge = (side: string, k: number) => { const u = U(side, k); if (u) { u.classList.add('dodge'); setTimeout(() => u && u.classList.remove('dodge'), 520); } };
    const missHop = (side: string, k: number) => { const u = U(side, k); if (u) { u.classList.add('mhop'); setTimeout(() => u && u.classList.remove('mhop'), 440); } };
    const hitCard = (side: string, k: number) => { const u = U(side, k); if (u) { u.classList.add('hit'); setTimeout(() => u && u.classList.remove('hit'), 420); } };
    const applyHit = (defSide: string, defK: number, h: any) => { if (!h) return; const defEl = U(defSide, defK); if (h.dodge) { dmgNum(defEl, 'MISS', 'miss'); return; } hitCard(defSide, defK); dmgNum(defEl, '-' + h.dmg + (h.crit ? '!' : ''), h.crit ? 'crit' : (h.block ? 'block' : '')); };
    // ===== fxlab 招式移植：特效原語 =====
    const addFx = (cls: string, life: number) => { const n = document.createElement('div'); n.className = cls; $('bt-fx')!.appendChild(n); if (life) setTimeout(() => n.remove(), life); return n; };
    const fwdOf = (s: string) => s === 'my' ? 1 : -1;
    const frontPt = (elm: HTMLElement | null, side: string) => { const c = cen(elm); if (!elm) return c; const r = elm.getBoundingClientRect(); return { x: c.x + fwdOf(side) * (r.width / 2 - 24), y: c.y }; };
    const missPt = (b: any, side: string) => { const fr = $('bt-field')!.getBoundingClientRect(); return { x: side === 'my' ? fr.width + 80 : -80, y: b.y - 12 }; };
    const ringFx = (x: number, y: number, color: string, big: boolean) => { const n = addFx('bt-ring' + (big ? ' big' : ''), 640); n.style.left = x + 'px'; n.style.top = y + 'px'; if (color) n.style.borderColor = color; };
    const burstFx = (x: number, y: number, color: string, big: boolean) => { ringFx(x, y, color, big); const f = addFx('bt-flash' + (big ? ' big' : ''), 340); f.style.left = x + 'px'; f.style.top = y + 'px'; if (color) f.style.background = 'radial-gradient(circle,' + color + ',transparent 68%)'; };
    const flashFx = (x: number, y: number, color: string) => { const f = addFx('bt-flash huge', 360); f.style.left = x + 'px'; f.style.top = y + 'px'; f.style.background = 'radial-gradient(circle,#fff 12%,' + color + ' 46%,transparent 72%)'; ringFx(x, y, '#fff', true); };
