---
import Layout from '../layouts/Layout.astro';
/**
 * 普拉魂創鬥卡 · 大廳 /arena（Phase1 A 片：大廳 + 格納庫 + 創卡 + 開卡演出）
 * 手機優先手遊風。戰鬥/編成為下一片。
 */
---
<Layout title="普拉魂創鬥卡" noIndex={true} bareLayout={true}>
  <div class="ar-app" id="ar-app">

    <!-- 需登入 -->
    <div id="ar-login" class="ar-login" hidden>
      <div class="ar-login-box">
        <div class="ar-logo">⚔️</div>
        <h1>普拉魂創鬥卡</h1>
        <p>把你的鋼彈，變成戰鬥卡。</p>
        <a href="/account?next=/arena" class="ar-btn ar-btn-primary">登入 / 註冊開始玩</a>
        <a href="/" class="ar-btn ar-btn-ghost">回普拉魂</a>
      </div>
    </div>

    <!-- 主畫面 -->
    <div id="ar-main" hidden>
      <!-- 頂部狀態列 -->
      <header class="ar-top">
        <div class="ar-top-l">
          <span class="ar-avatar">🐶</span>
          <div>
            <div class="ar-name" id="ar-name">玩家</div>
            <div class="ar-rank" id="ar-rank">段位 F</div>
          </div>
        </div>
        <div class="ar-top-r">
          <span class="ar-cur">🔩 <b id="ar-parts">0</b></span>
          <span class="ar-cur">🪙 <b id="ar-coins">0</b></span>
          <a href="/" class="ar-cog" title="回普拉魂">⚙️</a>
        </div>
      </header>

      <!-- 內容區 -->
      <main class="ar-content">
        <!-- 大廳 -->
        <section id="tab-lobby" class="ar-tab">
          <div id="ar-fleet"></div>
        </section>

        <!-- 格納庫 -->
        <section id="tab-hangar" class="ar-tab" hidden>
          <h2 class="ar-h2">🎴 格納庫 <small id="ar-card-count"></small></h2>
          <div id="ar-cards" class="ar-grid"></div>
        </section>

        <!-- 其他分頁 placeholder -->
        <section id="tab-soon" class="ar-tab" hidden>
          <div class="ar-soon">🚧 即將推出</div>
        </section>
      </main>

      <!-- 浮動：拍照創卡（格納庫分頁顯示）-->
      <button id="ar-create-fab" class="ar-fab" hidden>＋ 拍照創卡</button>
      <input type="file" id="ar-file" accept="image/*" hidden />

      <!-- 跑馬燈（固定在 nav 上方）-->
      <div class="ar-marquee-bar"><span id="ar-marquee-text">📣 歡迎來到創鬥卡！拍下你的鋼彈成品，組成戰鬥卡出擊吧 ⚔️</span></div>

      <!-- 底部 nav -->
      <nav class="ar-nav">
        <button class="ar-nav-btn is-active" data-tab="lobby"><span class="ar-ni">🏠</span><span class="ar-nl">大廳</span></button>
        <button class="ar-nav-btn" data-tab="hangar"><span class="ar-ni">🎴</span><span class="ar-nl">格納庫</span></button>
        <button class="ar-en-center" id="ar-en-btn">
          <span class="ar-en-icon">⚡</span>
          <span class="ar-en-line"><b id="ar-en">20/20</b> · <span id="ar-en-time">已滿</span></span>
        </button>
        <button class="ar-nav-btn" data-soon="商店"><span class="ar-ni">🛒</span><span class="ar-nl">商店</span></button>
        <button class="ar-nav-btn" data-soon="戰績"><span class="ar-ni">📊</span><span class="ar-nl">戰績</span></button>
      </nav>
    </div>

    <!-- 開卡演出 overlay -->
    <div id="ar-reveal" class="ar-reveal" hidden></div>

    <!-- 卡片詳情 -->
    <div id="ar-detail" class="ar-modal" hidden></div>

    <!-- 編成 -->
    <div id="ar-equip" class="ar-modal" hidden></div>

    <!-- 戰鬥 -->
    <div id="ar-battle" class="ar-battle" hidden></div>

    <!-- toast -->
    <div id="ar-toast" class="ar-toast" hidden></div>
  </div>
</Layout>

<style is:global>
  :root { --ar-bg:#0a0e1a; --ar-card:#141a2e; --ar-card2:#1c2440; --ar-line:rgba(120,140,200,.18); --ar-text:#e8ecf6; --ar-dim:#8a93b0; --ar-blue:#3b82f6; --ar-red:#e23; }
  .ar-app { min-height:100vh; background:var(--ar-bg); color:var(--ar-text); font-family:"Noto Sans TC","PingFang TC",system-ui,sans-serif; max-width:520px; margin:0 auto; position:relative; }

  /* login */
  .ar-login { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; }
  .ar-login[hidden] { display:none; }
  .ar-fab[hidden] { display:none; }
  .ar-nav[hidden] { display:none; }
  .ar-login-box { text-align:center; }
  .ar-login-box .ar-logo { font-size:56px; }
  .ar-login-box h1 { font-size:24px; margin:10px 0 4px; }
  .ar-login-box p { color:var(--ar-dim); margin:0 0 24px; }
  .ar-btn { display:block; width:100%; max-width:280px; margin:10px auto 0; padding:13px; border-radius:999px; font-weight:700; text-decoration:none; text-align:center; border:none; cursor:pointer; font-size:15px; }
  .ar-btn-primary { background:var(--ar-red); color:#fff; }
  .ar-btn-ghost { background:transparent; color:var(--ar-dim); border:1px solid var(--ar-line); }

  /* top */
  .ar-top { position:sticky; top:0; z-index:20; display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:rgba(10,14,26,.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--ar-line); }
  .ar-top-l { display:flex; align-items:center; gap:10px; }
  .ar-avatar { width:38px; height:38px; border-radius:50%; background:var(--ar-card2); display:flex; align-items:center; justify-content:center; font-size:20px; }
  .ar-name { font-weight:700; font-size:14px; }
  .ar-rank { font-size:11px; color:var(--ar-dim); }
  .ar-top-r { display:flex; align-items:center; gap:10px; font-size:13px; }
  .ar-cur b { color:#fff; }
  .ar-cog { text-decoration:none; font-size:18px; }

  .ar-content { padding:14px 14px 124px; }
  .ar-h2 { font-size:16px; margin:4px 0 12px; }
  .ar-h2 small { color:var(--ar-dim); font-weight:400; font-size:12px; }

  /* fleet / ship */
  .ar-ship { background:linear-gradient(160deg,var(--ar-card),var(--ar-card2)); border:1px solid var(--ar-line); border-radius:16px; padding:14px; margin-bottom:14px; }
  .ar-ship-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .ar-ship-name { font-weight:800; font-size:16px; }
  .ar-ship-hp { font-size:12px; color:var(--ar-dim); }
  .ar-ship-hp b { color:#7ee0a0; font-size:14px; }
  .ar-slots { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:12px; }
  .ar-slot { aspect-ratio:3/4; border-radius:10px; background:var(--ar-bg); border:1px dashed var(--ar-line); display:flex; align-items:center; justify-content:center; overflow:hidden; position:relative; }
  .ar-slot img { width:100%; height:100%; object-fit:cover; }
  .ar-slot .ar-empty { color:var(--ar-dim); font-size:11px; text-align:center; padding:4px; }
  .ar-slot .ar-tbadge { position:absolute; left:4px; bottom:4px; }
  .ar-ship-acts { display:flex; gap:8px; }
  .ar-sortie { flex:1; padding:11px; border:none; border-radius:10px; background:var(--ar-red); color:#fff; font-weight:800; font-size:15px; cursor:pointer; }
  .ar-edit { padding:11px 16px; border:1px solid var(--ar-line); border-radius:10px; background:transparent; color:var(--ar-text); font-weight:700; font-size:14px; cursor:pointer; }

  .ar-tbadge { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; font-size:11px; font-weight:800; color:#fff; }
  .t-ranged { background:#2f7ae0; } .t-melee { background:#e0562f; } .t-evade { background:#9b2fe0; }

  .ar-marquee { margin-top:6px; padding:10px 14px; background:var(--ar-card); border:1px solid var(--ar-line); border-radius:10px; font-size:12.5px; color:var(--ar-dim); overflow:hidden; white-space:nowrap; }

  /* grid / cards */
  .ar-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  @media (max-width:380px){ .ar-grid { grid-template-columns:repeat(2,1fr); } }
  .ar-c { border-radius:12px; overflow:hidden; background:var(--ar-card); border:2px solid var(--ar-line); cursor:pointer; position:relative; }
  .ar-c-img { aspect-ratio:1/1; background:var(--ar-bg); overflow:hidden; }
  .ar-c-img img { width:100%; height:100%; object-fit:cover; }
  .ar-c-img .ph { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:30px; }
  .ar-c-body { padding:6px 7px 8px; }
  .ar-c-name { font-size:12px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ar-c-sub { display:flex; align-items:center; justify-content:space-between; margin-top:3px; }
  .ar-c-pow { font-size:11px; color:var(--ar-dim); }
  .ar-rar { position:absolute; top:5px; right:5px; font-size:10px; font-weight:800; padding:1px 6px; border-radius:6px; color:#101010; }
  .r-N{ background:#9aa3bd; } .r-R{ background:#5b86ff; color:#fff; } .r-SR{ background:#b15bff; color:#fff; } .r-SSR{ background:linear-gradient(135deg,#ffe07a,#ffb01f); }
  .c-N{ border-color:#444c66; } .c-R{ border-color:#5b86ff; } .c-SR{ border-color:#b15bff; } .c-SSR{ border-color:#ffc23d; box-shadow:0 0 14px rgba(255,194,61,.35); }
  .ar-empty-hangar { text-align:center; color:var(--ar-dim); padding:50px 16px; line-height:1.8; grid-column:1/-1; }

  .ar-soon { text-align:center; color:var(--ar-dim); padding:80px 16px; font-size:18px; }

  /* fab */
  .ar-fab { position:fixed; left:50%; transform:translateX(-50%); bottom:112px; z-index:30; padding:14px 30px; border:none; border-radius:999px; background:var(--ar-red); color:#fff; font-weight:800; font-size:16px; cursor:pointer; box-shadow:0 8px 24px rgba(238,34,51,.45); }

  /* 跑馬燈（固定在 nav 上方）*/
  .ar-marquee-bar { position:fixed; left:0; right:0; bottom:64px; max-width:520px; margin:0 auto; height:34px; line-height:34px; background:rgba(20,26,46,.97); border-top:1px solid var(--ar-line); overflow:hidden; white-space:nowrap; z-index:24; font-size:13px; color:var(--ar-dim); }
  .ar-marquee-bar span { display:inline-block; padding-left:100%; animation:ar-marq 18s linear infinite; }
  @keyframes ar-marq { 0%{ transform:translateX(0); } 100%{ transform:translateX(-100%); } }

  /* bottom nav（手機友善，加大）*/
  .ar-nav { position:fixed; left:0; right:0; bottom:0; max-width:520px; margin:0 auto; height:64px; display:flex; align-items:stretch; background:rgba(12,16,30,.98); backdrop-filter:blur(10px); border-top:1px solid var(--ar-line); z-index:25; }
  .ar-nav-btn { flex:1; background:transparent; border:none; color:var(--ar-dim); cursor:pointer; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; }
  .ar-ni { font-size:24px; line-height:1; }
  .ar-nl { font-size:11px; }
  .ar-nav-btn.is-active { color:#fff; }
  .ar-nav-btn.is-active .ar-ni { transform:translateY(-1px); }

  /* 中央 EN（30%，凸起圓鈕 + 回復倒數）*/
  .ar-en-center { flex:0 0 30%; background:transparent; border:none; cursor:pointer; position:relative; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; padding-bottom:7px; }
  .ar-en-icon { position:absolute; top:-26px; width:60px; height:60px; border-radius:50%; background:radial-gradient(circle at 50% 32%, #3a4d92, #141a2e); border:3px solid #ffd23d; box-shadow:0 0 18px rgba(255,210,61,.45); display:flex; align-items:center; justify-content:center; font-size:27px; }
  .ar-en-line { font-size:11px; color:var(--ar-dim); white-space:nowrap; }
  .ar-en-line b { color:#ffd23d; font-size:12px; }

  /* reveal */
  .ar-reveal { position:fixed; inset:0; z-index:60; background:rgba(0,0,0,.86); display:flex; align-items:center; justify-content:center; padding:24px; }
  .ar-reveal[hidden]{ display:none; }
  .ar-reveal-card { width:100%; max-width:300px; border-radius:18px; overflow:hidden; border:3px solid; background:var(--ar-card); animation:ar-pop .5s cubic-bezier(.2,1.2,.4,1); }
  @keyframes ar-pop { 0%{ transform:scale(.6) rotate(-6deg); opacity:0; } 100%{ transform:scale(1) rotate(0); opacity:1; } }
  .ar-rv-flash { position:absolute; inset:0; pointer-events:none; }
  .ar-rv-img { aspect-ratio:1/1; background:var(--ar-bg); }
  .ar-rv-img img { width:100%; height:100%; object-fit:cover; }
  .ar-rv-body { padding:14px 16px 18px; }
  .ar-rv-rar { font-size:13px; font-weight:800; }
  .ar-rv-name { font-size:20px; font-weight:800; margin:4px 0; }
  .ar-rv-flavor { font-size:12px; color:var(--ar-dim); margin-bottom:12px; }
  .ar-rv-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-bottom:10px; text-align:center; }
  .ar-rv-stat { background:var(--ar-bg); border-radius:8px; padding:6px 2px; }
  .ar-rv-stat b { display:block; font-size:15px; }
  .ar-rv-stat small { font-size:10px; color:var(--ar-dim); }
  .ar-rv-special { font-size:12.5px; background:var(--ar-bg); border-radius:8px; padding:8px 10px; }
  .ar-rv-special b { color:#ffd23d; }
  .ar-rv-close { display:block; width:100%; margin-top:14px; padding:12px; border:none; border-radius:999px; background:var(--ar-red); color:#fff; font-weight:800; cursor:pointer; }

  /* loading overlay */
  .ar-loading { position:fixed; inset:0; z-index:60; background:rgba(0,0,0,.8); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; color:#fff; }
  .ar-spin { width:46px; height:46px; border:4px solid rgba(255,255,255,.2); border-top-color:var(--ar-red); border-radius:50%; animation:ar-rot 1s linear infinite; }
  @keyframes ar-rot { to{ transform:rotate(360deg); } }

  /* detail modal */
  .ar-modal { position:fixed; inset:0; z-index:55; background:rgba(0,0,0,.7); display:flex; align-items:center; justify-content:center; padding:20px; }
  .ar-modal[hidden]{ display:none; }
  .ar-modal-box { width:100%; max-width:340px; background:var(--ar-card); border-radius:16px; overflow:hidden; border:2px solid var(--ar-line); }

  /* 編成 */
  .ar-eq-box { width:100%; max-width:380px; background:var(--ar-card); border-radius:16px; border:2px solid var(--ar-line); max-height:88vh; display:flex; flex-direction:column; }
  .ar-eq-head { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; border-bottom:1px solid var(--ar-line); }
  .x-btn { background:none; border:none; color:var(--ar-dim); font-size:20px; cursor:pointer; }
  .ar-eq-slots { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; padding:12px 16px 4px; }
  .ar-eq-slot { aspect-ratio:3/4; border-radius:10px; background:var(--ar-bg); border:1px dashed var(--ar-line); display:flex; align-items:center; justify-content:center; overflow:hidden; position:relative; font-size:24px; }
  .ar-eq-slot img { width:100%; height:100%; object-fit:cover; }
  .ar-eq-empty { color:var(--ar-dim); font-size:12px; }
  .ar-eq-hint { font-size:11px; color:var(--ar-dim); padding:6px 16px 8px; }
  .ar-eq-list { display:grid; grid-template-columns:repeat(auto-fill, minmax(90px,1fr)); gap:10px; padding:4px 16px 14px; overflow-y:auto; }
  .ar-eq-card { aspect-ratio:3/4; border-radius:10px; background:var(--ar-bg); border:2px solid var(--ar-line); overflow:hidden; position:relative; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .ar-eq-card img { width:100%; height:100%; object-fit:cover; }
  .ar-eq-card .ph { font-size:22px; }
  .ar-eq-card.on { border-color:#ffd23d; }
  .ar-eq-chk { position:absolute; inset:0; background:rgba(255,210,61,.28); display:flex; align-items:center; justify-content:center; font-size:24px; color:#fff; font-weight:800; }
  .ar-eq-card .ar-tbadge { position:absolute; left:3px; bottom:3px; width:18px; height:18px; font-size:10px; }
  .ar-eq-none { grid-column:1/-1; text-align:center; color:var(--ar-dim); padding:24px; }
  .ar-eq-box .ar-rv-close { margin:0 16px 16px; }

  /* 戰鬥 */
  .ar-battle { position:fixed; inset:0; z-index:65; background:rgba(0,0,0,.9); display:flex; align-items:center; justify-content:center; padding:18px; }
  .ar-battle[hidden]{ display:none; }
  .ar-bt-loading { color:#fff; text-align:center; display:flex; flex-direction:column; align-items:center; gap:12px; }
  .ar-bt-box { width:100%; max-width:430px; background:var(--ar-card); border:2px solid var(--ar-line); border-radius:16px; padding:16px; display:flex; flex-direction:column; max-height:90vh; }
  .ar-bt-bars { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
  .ar-bt-side { flex:1; text-align:center; font-size:12px; }
  .ar-bt-vs { font-weight:800; color:var(--ar-dim); }
  .ar-bar { height:12px; background:var(--ar-bg); border-radius:999px; overflow:hidden; margin:4px 0; }
  .ar-bar i { display:block; height:100%; background:linear-gradient(90deg,#3ddc84,#7ee0a0); transition:width .35s; }
  .ar-bar.foe i { background:linear-gradient(90deg,#ff5a5a,#ff8a8a); }
  /* 戰鬥・雙排佈陣 */
  .bt-field { position:relative; height:300px; background:radial-gradient(circle at 50% 45%, #1a2447, #070a14); border-radius:12px; overflow:hidden; margin-bottom:10px; }
  .bt-field.shake { animation:bt-shake .3s; }
  @keyframes bt-shake { 0%,100%{transform:translateX(0);} 20%{transform:translateX(-7px);} 40%{transform:translateX(7px);} 60%{transform:translateX(-5px);} 80%{transform:translateX(5px);} }
  .bt-u { position:absolute; width:24%; max-width:96px; aspect-ratio:3/4; border-radius:10px; overflow:hidden; border:2px solid var(--ar-line); background:var(--ar-card2); filter:brightness(.62); transition:top .32s cubic-bezier(.3,1.3,.5,1), left .32s cubic-bezier(.3,1.3,.5,1), right .32s cubic-bezier(.3,1.3,.5,1), transform .25s, filter .3s; z-index:2; }
  .bt-u img { width:100%; height:100%; object-fit:cover; }
  .bt-u.active { filter:brightness(1.05) drop-shadow(0 0 10px rgba(120,170,255,.85)); transform:scale(1.12); z-index:5; }
  .bt-u.hit { filter:brightness(1) saturate(2.5) sepia(.6) hue-rotate(-30deg); }
  .my-side.hit { animation:bt-recoil-l .4s; } .foe-side.hit { animation:bt-recoil-r .4s; }
  @keyframes bt-recoil-l { 30%{ transform:scale(1.12) translateX(-14px) rotate(-5deg);} }
  @keyframes bt-recoil-r { 30%{ transform:scale(1.12) translateX(14px) rotate(5deg);} }
  .my-side.lunge { transform:scale(1.18) translateX(40px); } .foe-side.lunge { transform:scale(1.18) translateX(-40px); }
  .my-side.dodge { transform:scale(1.12) translate(-14px,-34px); } .foe-side.dodge { transform:scale(1.12) translate(14px,-34px); }
  .bt-u.ult { filter:brightness(1.1) drop-shadow(0 0 14px rgba(255,210,61,.9)); transform:scale(1.1); z-index:6; }
  .bt-u.dim { filter:brightness(.28) grayscale(.7); }
  .bt-u.won { filter:brightness(1); }
  .bt-noimg { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:34px; }
  .bt-noimg.t-ranged{ background:#1c3a66; } .bt-noimg.t-melee{ background:#5a2a1c; } .bt-noimg.t-evade{ background:#3a1c5a; }
  .bt-tb { position:absolute; left:4px; bottom:16px; width:20px; height:20px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:800; color:#fff; z-index:2; }
  .bt-uname { position:absolute; left:0; right:0; bottom:0; font-size:9px; text-align:center; background:rgba(0,0,0,.6); padding:1px 2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .bt-fx { position:absolute; inset:0; pointer-events:none; z-index:7; }
  /* 特效座標由 JS 依目標卡中心點計算（left/top inline），永遠對準對方卡正中 */
  .bt-laser { position:absolute; height:6px; transform-origin:left center; z-index:7; }
  .bt-laser.big { height:13px; }
  .bt-laser i { display:block; width:100%; height:100%; border-radius:6px; transform-origin:left center; animation:bt-beam .5s ease-out; }
  .bt-laser.l-my i { background:linear-gradient(90deg,#9fe8ff,#2f9bff); box-shadow:0 0 12px #2f9bff; }
  .bt-laser.l-foe i { background:linear-gradient(90deg,#ffd0d0,#ff4d4d); box-shadow:0 0 12px #ff4d4d; }
  @keyframes bt-beam { 0%{ transform:scaleX(0); opacity:.5;} 45%{ transform:scaleX(1); opacity:1;} 100%{ transform:scaleX(1); opacity:0;} }
  .bt-slash { position:absolute; width:84px; height:8px; background:linear-gradient(90deg,transparent,#fff,transparent); filter:drop-shadow(0 0 6px #fff); animation:bt-slashk .45s ease-out; z-index:8; }
  .bt-slash.big { width:120px; height:12px; }
  @keyframes bt-slashk { 0%{ opacity:0; transform:translate(-50%,-50%) rotate(-44deg) scale(.3);} 40%{ opacity:1; transform:translate(-50%,-50%) rotate(-35deg) scale(1.15);} 100%{ opacity:0; transform:translate(-50%,-50%) rotate(-26deg) scale(1);} }
  .bt-dmg { position:absolute; font-size:22px; font-weight:900; color:#fff; text-shadow:0 2px 6px #000; animation:bt-pop .85s ease-out forwards; z-index:9; white-space:nowrap; }
  .bt-dmg.crit { font-size:32px; color:#ffd23d; } .bt-dmg.block { color:#9ad0ff; } .bt-dmg.miss { color:#cfcfcf; font-size:17px; }
  @keyframes bt-pop { 0%{ opacity:0; transform:translate(-50%,-20%) scale(.6);} 25%{ opacity:1; transform:translate(-50%,-80%) scale(1.1);} 100%{ opacity:0; transform:translate(-50%,-200%) scale(1);} }
  .bt-darken { position:absolute; inset:0; background:#000; opacity:0; transition:opacity .25s; z-index:4; pointer-events:none; }
  .bt-darken.on { opacity:.55; }
  .bt-banner { position:absolute; left:0; right:0; top:44%; text-align:center; font-size:22px; font-weight:900; color:#ffd23d; text-shadow:0 2px 12px #000; opacity:0; transform:scale(.6); transition:opacity .2s, transform .2s; z-index:8; pointer-events:none; }
  .bt-banner.on { opacity:1; transform:scale(1); }
  .bt-skip { display:block; margin:0 auto 8px; background:transparent; border:1px solid var(--ar-line); color:var(--ar-dim); padding:7px 18px; border-radius:999px; font-size:12px; cursor:pointer; }
  .ar-bt-result { text-align:center; font-size:24px; font-weight:800; margin:12px 0 6px; }
  .ar-bt-result.win { color:#ffd23d; } .ar-bt-result.lose { color:#9aa3bd; }
  .ar-bt-rw { text-align:center; font-size:14px; margin-bottom:12px; }
  .ar-bt-acts { display:flex; gap:8px; }

  .ar-toast { position:fixed; left:50%; bottom:100px; transform:translateX(-50%); z-index:70; background:rgba(0,0,0,.9); color:#fff; padding:10px 18px; border-radius:999px; font-size:13px; }
  .ar-toast[hidden]{ display:none; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id);
  const esc = (s: any) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const TYPE: any = { ranged: { t: '射', c: 't-ranged' }, melee: { t: '近', c: 't-melee' }, evade: { t: '閃', c: 't-evade' } };
  const RANK = (s: number) => 'F'; // MVP：簡單，之後做 F-SS

  let cards: any[] = [];
  let player: any = {};

  function toast(msg: string) {
    const t = $('ar-toast')!; t.textContent = msg; t.removeAttribute('hidden');
    setTimeout(() => t.setAttribute('hidden', ''), 1800);
  }

  // 進站：檢查登入
  (async () => {
    let me: any = null;
    try { const r = await fetch('/api/user/me', { credentials: 'include' }); if (r.ok) me = await r.json(); } catch {}
    if (!me || !me.ok) { $('ar-login')!.removeAttribute('hidden'); return; }
    $('ar-main')!.removeAttribute('hidden');
    $('ar-name')!.textContent = me.user.display_name || me.user.email.split('@')[0];
    await loadData();
  })();

  async function loadData() {
    try {
      const r = await fetch('/api/card/list', { credentials: 'include' });
      const d = await r.json();
      if (!d.ok) return;
      cards = d.cards || []; player = d.player || {};
      $('ar-parts')!.textContent = player.parts ?? 0;
      $('ar-coins')!.textContent = (player.coins ?? 0).toLocaleString();
      $('ar-rank')!.textContent = '段位 ' + RANK(player.rank_score || 0);
      renderFleet(); renderHangar();
    } catch {}
  }

  // 大廳：MVP 1 艘戰艦，顯示已編成的卡
  function renderFleet() {
    const byId: any = {}; cards.forEach((c) => byId[c.id] = c);
    const lineup = (player.ship_card_ids || []).map((id: string) => byId[id]).filter(Boolean);
    const hp = (player.ship_base_hp || 800) + lineup.reduce((s: number, c: any) => s + (c.hp || 0), 0);
    const slot = (c: any) => c
      ? `<div class="ar-slot">${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : '<span class="ar-empty">🤖</span>'}<span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span></div>`
      : `<div class="ar-slot"><span class="ar-empty">空格<br>點編成放卡</span></div>`;
    $('ar-fleet')!.innerHTML = `
      <div class="ar-ship">
        <div class="ar-ship-head"><span class="ar-ship-name">🚀 我的戰艦 <span style="font-size:11px;color:var(--ar-dim)">🛡️ 防守隊</span></span><span class="ar-ship-hp">HP <b>${hp.toLocaleString()}</b></span></div>
        <div class="ar-slots">${slot(lineup[0])}${slot(lineup[1])}${slot(lineup[2])}</div>
        <div class="ar-ship-acts">
          <button class="ar-sortie" id="ar-sortie">⚔️ 出擊</button>
          <button class="ar-edit" id="ar-edit">編成</button>
        </div>
      </div>`;
    $('ar-sortie')!.addEventListener('click', () => { if (!lineup.length) { toast('先按「編成」把卡放上戰艦'); return; } doBattle(); });
    $('ar-edit')!.addEventListener('click', openEquip);
  }

  function renderHangar() {
    $('ar-card-count')!.textContent = cards.length ? `（${cards.length} 張）` : '';
    if (!cards.length) {
      $('ar-cards')!.innerHTML = '<div class="ar-empty-hangar">還沒有戰鬥卡 🎴<br>按下方「＋ 拍照創卡」<br>拍你的鋼彈成品變成卡！</div>';
      return;
    }
    $('ar-cards')!.innerHTML = cards.map((c, i) => `
      <div class="ar-c c-${esc(c.rarity)}" data-i="${i}">
        <span class="ar-rar r-${esc(c.rarity)}">${esc(c.rarity)}</span>
        <div class="ar-c-img">${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : '<span class="ph">🤖</span>'}</div>
        <div class="ar-c-body">
          <div class="ar-c-name">${esc(c.name)}</div>
          <div class="ar-c-sub"><span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span><span class="ar-c-pow">戰力 ${(c.hp + c.atk + c.def + c.mob)}</span></div>
        </div>
      </div>`).join('');
    $('ar-cards')!.querySelectorAll('.ar-c').forEach((el) => el.addEventListener('click', () => showDetail(cards[parseInt((el as HTMLElement).dataset.i!, 10)])));
  }

  // 編成
  let equipSel: string[] = [];
  function openEquip() {
    equipSel = [...(player.ship_card_ids || [])].filter((id: string) => cards.some((c) => c.id === id)).slice(0, 3);
    const el = $('ar-equip')!;
    const byId: any = {}; cards.forEach((c) => byId[c.id] = c);
    const render = () => {
      const list = cards.length ? cards.map((c) => { const on = equipSel.includes(c.id); return `<div class="ar-eq-card ${on ? 'on' : ''}" data-id="${esc(c.id)}">${c.photo_url ? `<img src="${esc(c.photo_url)}"/>` : '<span class="ph">🤖</span>'}<span class="ar-tbadge ${TYPE[c.type]?.c}">${TYPE[c.type]?.t}</span>${on ? '<span class="ar-eq-chk">✓</span>' : ''}</div>`; }).join('') : '<div class="ar-eq-none">還沒有卡，先去格納庫創卡</div>';
      el.innerHTML = `<div class="ar-eq-box"><div class="ar-eq-head"><b>編成戰艦</b><button class="x-btn" id="ar-eq-x">✕</button></div><div class="ar-eq-hint">點卡片放上 / 取下（最多 3 張）　已選 <b style="color:#ffd23d">${equipSel.length}</b>/3　🛡️ 此艦同時為防守隊</div><div class="ar-eq-list">${list}</div><button class="ar-rv-close" id="ar-eq-save">儲存編成</button></div>`;
      $('ar-eq-x')!.addEventListener('click', closeEquip);
      $('ar-eq-save')!.addEventListener('click', saveEquip);
      el.querySelectorAll('.ar-eq-card').forEach((d) => d.addEventListener('click', () => {
        const id = (d as HTMLElement).dataset.id!;
        if (equipSel.includes(id)) equipSel = equipSel.filter((x) => x !== id);
        else if (equipSel.length < 3) equipSel.push(id);
        else { toast('最多 3 張'); return; }
        render();
      }));
    };
    el.removeAttribute('hidden'); render();
  }
  function closeEquip() { const el = $('ar-equip')!; el.setAttribute('hidden', ''); el.innerHTML = ''; }
  async function saveEquip() {
    try {
      const r = await fetch('/api/card/equip', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ card_ids: equipSel }) });
      const d = await r.json();
      if (!r.ok || !d.ok) { toast((d && d.message) || '儲存失敗'); return; }
      closeEquip(); toast('編成已儲存 ✅'); await loadData();
    } catch { toast('網路錯誤'); }
  }

  // 戰鬥
  async function doBattle() {
    const el = $('ar-battle')!;
    el.innerHTML = '<div class="ar-bt-loading"><div class="ar-spin"></div><div>出擊中…</div></div>';
    el.removeAttribute('hidden');
    let d: any = null;
    try { const r = await fetch('/api/card/battle', { method: 'POST', credentials: 'include' }); d = await r.json(); if (!r.ok || !d.ok) { el.setAttribute('hidden', ''); el.innerHTML = ''; toast((d && d.message) || '出擊失敗'); return; } }
    catch { el.setAttribute('hidden', ''); el.innerHTML = ''; toast('網路錯誤'); return; }
    animateBattle(d);
  }
  function animateBattle(d: any) {
    const el = $('ar-battle')!;
    const myMax = d.my.maxHP, foeMax = d.foe.maxHP;
    const myTeam = d.my.team || [], foeTeam = d.foe.team || [];
    const tcls = (t: string) => t === 'ranged' ? 't-ranged' : t === 'melee' ? 't-melee' : 't-evade';
    const tlab = (t: string) => ({ ranged: '射', melee: '近', evade: '閃' } as any)[t] || '?';
    const unit = (c: any, side: string, k: number) => `<div class="bt-u ${side}-side" id="bt-${side}-${k}">${c.photo ? `<img src="${esc(c.photo)}"/>` : `<div class="bt-noimg ${tcls(c.type)}">${side === 'foe' ? '👾' : '🤖'}</div>`}<span class="bt-tb ${tcls(c.type)}">${tlab(c.type)}</span><span class="bt-uname">${esc(c.name)}</span></div>`;
    el.innerHTML = `<div class="ar-bt-box">
      <div class="ar-bt-bars"><div class="ar-bt-side"><span>我方</span><div class="ar-bar"><i id="bt-my" style="width:100%"></i></div><small id="bt-myn">${myMax}</small></div><div class="ar-bt-vs" id="bt-round">VS</div><div class="ar-bt-side"><span>${esc(d.foe.name)}</span><div class="ar-bar foe"><i id="bt-foe" style="width:100%"></i></div><small id="bt-foen">${foeMax}</small></div></div>
      <div class="bt-field" id="bt-field"><div class="bt-darken" id="bt-darken"></div>${myTeam.map((c: any, k: number) => unit(c, 'my', k)).join('')}${foeTeam.map((c: any, k: number) => unit(c, 'foe', k)).join('')}<div class="bt-fx" id="bt-fx"></div><div class="bt-banner" id="bt-banner"></div></div>
      <button class="bt-skip" id="bt-skip">跳過 ⏩</button>
      <div id="bt-end"></div>
    </div>`;
    const lines = d.log || []; let i = 0; const timers: any[] = []; let skipped = false; let aMy = 0, aFoe = 0;
    const SLOT = ['4%', '37%', '70%'];
    const U = (side: string, k: number) => $(`bt-${side}-${k}`);
    const place = (side: string, k: number, active: boolean) => { const u = U(side, k); if (!u) return; u.classList.remove('hit', 'dodge', 'lunge', 'ult', 'dim', 'won'); u.classList.toggle('active', active); u.style.top = active ? '36%' : SLOT[k]; if (side === 'my') u.style.left = active ? '13%' : '3%'; else u.style.right = active ? '13%' : '3%'; };
    const reset = () => { [0, 1, 2].forEach((k) => { place('my', k, false); place('foe', k, false); }); $('bt-fx')!.innerHTML = ''; };
    const setHP = (my: number, foe: number) => { ($('bt-my') as HTMLElement).style.width = Math.max(0, Math.round(my / myMax * 100)) + '%'; ($('bt-foe') as HTMLElement).style.width = Math.max(0, Math.round(foe / foeMax * 100)) + '%'; $('bt-myn')!.textContent = String(my); $('bt-foen')!.textContent = String(foe); };
    const shake = () => { const f = $('bt-field')!; f.classList.add('shake'); setTimeout(() => f.classList.remove('shake'), 320); };
    // 以「卡片實際位置」為基準算特效座標（永遠對準目標卡正中）
    const cen = (el: HTMLElement | null) => { const fr = $('bt-field')!.getBoundingClientRect(); if (!el) return { x: fr.width / 2, y: fr.height / 2 }; const r = el.getBoundingClientRect(); return { x: r.left + r.width / 2 - fr.left, y: r.top + r.height / 2 - fr.top }; };
    const laserFx = (attEl: HTMLElement | null, defEl: HTMLElement | null, big: boolean, side: string) => { if (!attEl || !defEl) return; const a = cen(attEl), b = cen(defEl); const dx = b.x - a.x, dy = b.y - a.y; const len = Math.hypot(dx, dy); const ang = Math.atan2(dy, dx) * 180 / Math.PI; const n = document.createElement('div'); n.className = 'bt-laser ' + (side === 'my' ? 'l-my' : 'l-foe') + (big ? ' big' : ''); n.style.left = a.x + 'px'; n.style.top = a.y + 'px'; n.style.width = len + 'px'; n.style.transform = 'rotate(' + ang + 'deg)'; n.innerHTML = '<i></i>'; $('bt-fx')!.appendChild(n); setTimeout(() => n.remove(), 550); };
    const slashFx = (defEl: HTMLElement | null, big: boolean) => { if (!defEl) return; const c = cen(defEl); const n = document.createElement('div'); n.className = 'bt-slash' + (big ? ' big' : ''); n.style.left = c.x + 'px'; n.style.top = c.y + 'px'; $('bt-fx')!.appendChild(n); setTimeout(() => n.remove(), 500); };
    const dmgNum = (defEl: HTMLElement | null, text: string, cls: string) => { if (!defEl) return; const c = cen(defEl); const n = document.createElement('div'); n.className = 'bt-dmg ' + cls; n.textContent = text; n.style.left = c.x + 'px'; n.style.top = c.y + 'px'; $('bt-fx')!.appendChild(n); setTimeout(() => n.remove(), 850); };
    const lunge = (side: string, k: number) => { const u = U(side, k); if (u) { u.classList.add('lunge'); setTimeout(() => u && u.classList.remove('lunge'), 400); } };
    const dodge = (side: string, k: number) => { const u = U(side, k); if (u) { u.classList.add('dodge'); setTimeout(() => u && u.classList.remove('dodge'), 520); } };
    const hitCard = (side: string, k: number) => { const u = U(side, k); if (u) { u.classList.add('hit'); setTimeout(() => u && u.classList.remove('hit'), 420); } };
    const applyHit = (defSide: string, defK: number, h: any) => { if (!h) return; const defEl = U(defSide, defK); if (h.dodge) { dmgNum(defEl, 'MISS', 'miss'); return; } hitCard(defSide, defK); dmgNum(defEl, '-' + h.dmg + (h.crit ? '!' : ''), h.crit ? 'crit' : (h.block ? 'block' : '')); };
    const attack = (atkSide: string, atkType: string, atkK: number, defSide: string, defK: number, h: any) => {
      const big = !!(h && h.crit);
      const attEl = U(atkSide, atkK), defEl = U(defSide, defK);
      if (atkType === 'ranged') laserFx(attEl, defEl, big, atkSide);
      else if (atkType === 'melee') { lunge(atkSide, atkK); slashFx(defEl, big); }
      else laserFx(attEl, defEl, big, atkSide);
      if (big) shake();
      applyHit(defSide, defK, h);
    };
    const end = () => {
      reset();
      const loseSide = d.win ? 'foe' : 'my', winSide = d.win ? 'my' : 'foe';
      [0, 1, 2].forEach((k) => { const lu = U(loseSide, k); if (lu) lu.classList.add('dim'); const wu = U(winSide, k); if (wu) wu.classList.add('won'); });
      $('bt-darken')!.classList.remove('on'); $('bt-banner')!.classList.remove('on');
      const rw = d.rewards; const sk = $('bt-skip'); if (sk) sk.style.display = 'none';
      $('bt-end')!.innerHTML = `<div class="ar-bt-result ${d.win ? 'win' : 'lose'}">${d.win ? '🎉 勝利！' : '💧 雖敗猶榮'}</div><div class="ar-bt-rw">🔩+${rw.parts}　🪙+${rw.coins}　段位 ${rw.rank_delta >= 0 ? '+' : ''}${rw.rank_delta}</div><div class="ar-bt-acts"><button class="ar-edit" id="bt-again">再戰</button><button class="ar-rv-close" id="bt-close" style="flex:1">返回大廳</button></div>`;
      $('bt-again')!.addEventListener('click', () => doBattle());
      $('bt-close')!.addEventListener('click', () => { el.setAttribute('hidden', ''); el.innerHTML = ''; loadData(); });
    };
    const playUlt = (ult: any) => {
      const side = ult.side, other = side === 'my' ? 'foe' : 'my';
      $('bt-darken')!.classList.add('on');
      $('bt-banner')!.textContent = '⚡ 覺醒・' + ult.name; $('bt-banner')!.classList.add('on');
      const team = side === 'my' ? myTeam : foeTeam;
      [0, 1, 2].forEach((k) => { const u = U(side, k); if (u) u.classList.add('ult'); });
      [0, 1, 2].forEach((k) => timers.push(setTimeout(() => { const t = team[k] ? team[k].type : 'ranged'; const aEl = U(side, k), dEl = U(other, k); if (t === 'melee') { lunge(side, k); slashFx(dEl, true); } else laserFx(aEl, dEl, true, side); }, k * 140)));
      shake();
      timers.push(setTimeout(() => { [0, 1, 2].forEach((k) => hitCard(other, k)); dmgNum(U(other, 1) || U(other, 0), '-' + ult.dmg + '!!', 'crit'); shake(); }, 580));
      timers.push(setTimeout(() => { $('bt-darken')!.classList.remove('on'); $('bt-banner')!.classList.remove('on'); [0, 1, 2].forEach((k) => { const u = U(side, k); if (u) u.classList.remove('ult'); }); }, 1500));
    };
    const play = () => {
      if (skipped) return;
      if (i >= lines.length) { end(); return; }
      const ev = lines[i++];
      if (ev.intro) { $('bt-round')!.textContent = '開戰！'; setHP(ev.myHP, ev.foeHP); reset(); timers.push(setTimeout(play, 700)); return; }
      $('bt-round')!.textContent = '第 ' + ev.round + ' 回';
      reset(); aMy = ev.myIdx; aFoe = ev.foeIdx;
      place('my', aMy, true); place('foe', aFoe, true);
      timers.push(setTimeout(() => {
        const myType = (myTeam[aMy] || {}).type, foeType = (foeTeam[aFoe] || {}).type;
        if (ev.rps === 1) {
          if (myType === 'evade') { if (foeType === 'ranged') laserFx(U('foe', aFoe), U('my', aMy), false, 'foe'); else slashFx(U('my', aMy), false); dodge('my', aMy); timers.push(setTimeout(() => { lunge('my', aMy); slashFx(U('foe', aFoe), !!(ev.toFoe && ev.toFoe.crit)); applyHit('foe', aFoe, ev.toFoe); }, 300)); }
          else attack('my', myType, aMy, 'foe', aFoe, ev.toFoe);
        } else if (ev.rps === -1) {
          if (foeType === 'evade') { if (myType === 'ranged') laserFx(U('my', aMy), U('foe', aFoe), false, 'my'); else slashFx(U('foe', aFoe), false); dodge('foe', aFoe); timers.push(setTimeout(() => { lunge('foe', aFoe); slashFx(U('my', aMy), !!(ev.toMe && ev.toMe.crit)); applyHit('my', aMy, ev.toMe); }, 300)); }
          else attack('foe', foeType, aFoe, 'my', aMy, ev.toMe);
        } else {
          attack('my', myType, aMy, 'foe', aFoe, ev.toFoe);
          attack('foe', foeType, aFoe, 'my', aMy, ev.toMe);
        }
        setHP(ev.myHP, ev.foeHP);
        if (ev.ult) timers.push(setTimeout(() => playUlt(ev.ult), 520));
      }, 400));
      timers.push(setTimeout(play, ev.ult ? 1900 : 1100));
    };
    $('bt-skip')!.addEventListener('click', () => { skipped = true; timers.forEach(clearTimeout); const last = lines[lines.length - 1]; if (last) setHP(last.myHP, last.foeHP); end(); });
    timers.push(setTimeout(play, 350));
  }

  // tabs
  document.querySelectorAll('.ar-nav-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const soon = (b as HTMLElement).dataset.soon;
      if (soon) { toast(soon + ' 即將推出 🚧'); return; }
      const tab = (b as HTMLElement).dataset.tab!;
      document.querySelectorAll('.ar-nav-btn').forEach((x) => x.classList.toggle('is-active', x === b));
      $('tab-lobby')!.toggleAttribute('hidden', tab !== 'lobby');
      $('tab-hangar')!.toggleAttribute('hidden', tab !== 'hangar');
      $('ar-create-fab')!.toggleAttribute('hidden', tab !== 'hangar');
    });
  });

  $('ar-en-btn')!.addEventListener('click', () => toast('EN 體力系統開發中 ⚡'));

  // 創卡
  $('ar-create-fab')!.addEventListener('click', () => ($('ar-file') as HTMLInputElement).click());
  ($('ar-file') as HTMLInputElement).addEventListener('change', async function () {
    const f = this.files?.[0]; this.value = '';
    if (!f) return;
    showLoading();
    try {
      const img = await resize(f);
      const r = await fetch('/api/card/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ image: img }) });
      let d: any = null; try { d = await r.json(); } catch {}
      hideLoading();
      if (!r.ok || !d || !d.ok) { toast((d && d.message) || (r.status >= 500 ? 'AI 忙線中，稍後再試' : '生成失敗')); return; }
      reveal(d.card);
      await loadData();
    } catch { hideLoading(); toast('讀圖或網路錯誤'); }
  });

  function resize(f: File): Promise<{ mime: string; base64: string }> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(f); const im = new Image();
      im.onload = () => {
        URL.revokeObjectURL(url);
        const MAX = 1280; let w = im.naturalWidth || im.width, h = im.naturalHeight || im.height;
        if (Math.max(w, h) > MAX) { const s = MAX / Math.max(w, h); w = Math.round(w * s); h = Math.round(h * s); }
        try { const c = document.createElement('canvas'); c.width = w; c.height = h; c.getContext('2d')!.drawImage(im, 0, 0, w, h); resolve({ mime: 'image/jpeg', base64: c.toDataURL('image/jpeg', 0.85).split(',')[1] || '' }); } catch (e) { reject(e); }
      };
      im.onerror = () => { URL.revokeObjectURL(url); reject(new Error('讀圖失敗')); };
      im.src = url;
    });
  }

  let loadingEl: HTMLElement | null = null;
  function showLoading() { loadingEl = document.createElement('div'); loadingEl.className = 'ar-loading'; loadingEl.innerHTML = '<div class="ar-spin"></div><div>AI 組裝中…</div>'; document.body.appendChild(loadingEl); }
  function hideLoading() { if (loadingEl) { loadingEl.remove(); loadingEl = null; } }

  // 開卡演出
  function reveal(c: any) {
    const pow = c.hp + c.atk + c.def + c.mob;
    const rarLabel: any = { N: '★ N', R: '★★ R', SR: '★★★ SR', SSR: '☆☆☆☆ SSR ☆☆☆☆' };
    const el = $('ar-reveal')!;
    el.innerHTML = `
      <div class="ar-reveal-inner">
        <div class="ar-reveal-card c-${esc(c.rarity)}">
          <div class="ar-rv-img">${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : ''}</div>
          <div class="ar-rv-body">
            <div class="ar-rv-rar r-${esc(c.rarity)}" style="color:inherit">${rarLabel[c.rarity] || c.rarity}　<span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span>　🌍${esc(c.terrain)}</div>
            <div class="ar-rv-name">${esc(c.name)}</div>
            <div class="ar-rv-flavor">${esc(c.flavor)}</div>
            <div class="ar-rv-stats">
              <div class="ar-rv-stat"><b>${c.hp}</b><small>HP</small></div>
              <div class="ar-rv-stat"><b>${c.atk}</b><small>攻</small></div>
              <div class="ar-rv-stat"><b>${c.def}</b><small>防</small></div>
              <div class="ar-rv-stat"><b>${c.mob}</b><small>機動</small></div>
            </div>
            <div class="ar-rv-special">💥 <b>${esc(c.special_name)}</b>　${esc(c.special_desc)}</div>
            <button class="ar-rv-close" id="ar-rv-close">收進格納庫！（戰力 ${pow}）</button>
          </div>
        </div>
      </div>`;
    el.removeAttribute('hidden');
    $('ar-rv-close')!.addEventListener('click', () => { el.setAttribute('hidden', ''); el.innerHTML = ''; });
  }

  // 卡詳情
  function showDetail(c: any) {
    const pow = c.hp + c.atk + c.def + c.mob;
    const el = $('ar-detail')!;
    el.innerHTML = `
      <div class="ar-modal-box c-${esc(c.rarity)}">
        <div class="ar-rv-img" style="position:relative"><span class="ar-rar r-${esc(c.rarity)}">${esc(c.rarity)}</span>${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : ''}</div>
        <div class="ar-rv-body">
          <div class="ar-rv-name">${esc(c.name)} <span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span></div>
          <div class="ar-rv-flavor">${esc(c.flavor)} · 🌍${esc(c.terrain)} · 戰歷 ${c.wins}/${c.battles}</div>
          <div class="ar-rv-stats">
            <div class="ar-rv-stat"><b>${c.hp}</b><small>HP</small></div>
            <div class="ar-rv-stat"><b>${c.atk}</b><small>攻</small></div>
            <div class="ar-rv-stat"><b>${c.def}</b><small>防</small></div>
            <div class="ar-rv-stat"><b>${c.mob}</b><small>機動</small></div>
          </div>
          <div class="ar-rv-special">💥 <b>${esc(c.special_name)}</b>　${esc(c.special_desc)}</div>
          <button class="ar-rv-close" id="ar-dt-close">關閉（戰力 ${pow}）</button>
        </div>
      </div>`;
    el.removeAttribute('hidden');
    $('ar-dt-close')!.addEventListener('click', () => { el.setAttribute('hidden', ''); el.innerHTML = ''; });
    el.addEventListener('click', (e) => { if (e.target === el) { el.setAttribute('hidden', ''); el.innerHTML = ''; } });
  }
</script>
