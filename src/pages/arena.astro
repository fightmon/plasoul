        let resolveAt = 280;
        if (ev.rps === 1) {
          if (myType === 'evade') { if (foeType === 'ranged') laserFx(U('foe', aFoe), U('my', aMy), false, 'foe', false, true); else slashFx(U('my', aMy), false); dodge('my', aMy); dmgNum(U('my', aMy), '閃避', 'miss'); timers.push(setTimeout(() => { const cm = !!(ev.toFoe && ev.toFoe.dodge); lungeTo('my', aMy, 'foe', aFoe, cm ? 0.58 : 0.82); if (cm) timers.push(setTimeout(() => missHop('foe', aFoe), 170)); else timers.push(setTimeout(() => slashFx(U('foe', aFoe), !!(ev.toFoe && ev.toFoe.crit)), 200)); timers.push(setTimeout(() => { applyHit('foe', aFoe, ev.toFoe); if (!ev.ult) setHP(ev.myHP, ev.foeHP); }, 300)); }, 320)); resolveAt = -1; }
          else resolveAt = attack('my', myType, aMy, 'foe', aFoe, ev.toFoe);
        } else if (ev.rps === -1) {
          if (foeType === 'evade') { if (myType === 'ranged') laserFx(U('my', aMy), U('foe', aFoe), false, 'my', false, true); else slashFx(U('foe', aFoe), false); dodge('foe', aFoe); dmgNum(U('foe', aFoe), '閃避', 'miss'); timers.push(setTimeout(() => { const cm = !!(ev.toMe && ev.toMe.dodge); lungeTo('foe', aFoe, 'my', aMy, cm ? 0.58 : 0.82); if (cm) timers.push(setTimeout(() => missHop('my', aMy), 170)); else timers.push(setTimeout(() => slashFx(U('my', aMy), !!(ev.toMe && ev.toMe.crit)), 200)); timers.push(setTimeout(() => { applyHit('my', aMy, ev.toMe); if (!ev.ult) setHP(ev.myHP, ev.foeHP); }, 300)); }, 320)); resolveAt = -1; }
          else resolveAt = attack('foe', foeType, aFoe, 'my', aMy, ev.toMe);
        } else {
          const bothMelee = myType === 'melee' && foeType === 'melee';
          const r = bothMelee ? 0.5 : 0.82;
          const d1 = attack('my', myType, aMy, 'foe', aFoe, ev.toFoe, r);
          const d2 = attack('foe', foeType, aFoe, 'my', aMy, ev.toMe, r);
          resolveAt = Math.max(d1, d2);
        }
        // 血條在命中瞬間才更新（與斬擊/雷射同步）
        if (ev.ult) timers.push(setTimeout(() => { playUlt(ev.ult); timers.push(setTimeout(() => setHP(ev.myHP, ev.foeHP), 600)); }, 520));
        else if (resolveAt >= 0) timers.push(setTimeout(() => setHP(ev.myHP, ev.foeHP), resolveAt));
        // 放話（依語氣）
        if (!ev.ult) {
          let sp: string | null = null, situ = 'atk';
          if (ev.rps === 1 && myType === 'evade') { sp = 'my'; situ = 'dodge'; }
          else if (ev.rps === -1 && foeType === 'evade') { sp = 'foe'; situ = 'dodge'; }
          else { const w = ev.rps === -1 ? 'foe' : 'my'; const crit = (ev.toFoe && ev.toFoe.crit) || (ev.toMe && ev.toMe.crit); if (crit) { sp = w; situ = 'crit'; } else if (Math.random() < 0.4) { sp = w; situ = 'atk'; } }
          if (sp) timers.push(setTimeout(() => say(sp as string, situ), 260));
        }
        // 下一回合：依本回合招式長度自適應 + 整體放慢（看得清楚）
        let pace = resolveAt >= 0 ? resolveAt : 760;   // 閃避反擊約 760
        if (ev.ult) pace = Math.max(pace, 1400);
        timers.push(setTimeout(play, pace + 820));
      }, 400));
    };
    $('bt-skip')!.addEventListener('click', () => { skipped = true; timers.forEach(clearTimeout); const last = lines[lines.length - 1]; if (last) setHP(last.myHP, last.foeHP); end(); });
    timers.push(setTimeout(play, 350));
  }

  // 戰績
  function pct(n: number, d: number) { return d ? Math.round((n / d) * 100) : 0; }
  async function renderRecord() {
    const w = player.wins || 0, l = player.losses || 0, tot = w + l, wr = pct(w, tot);
    const fought = cards.filter((c) => (c.battles || 0) > 0).sort((a, b) => (b.battles || 0) - (a.battles || 0));
    const mvp = fought.slice().sort((a, b) => (b.wins || 0) - (a.wins || 0) || pct(b.wins, b.battles) - pct(a.wins, a.battles))[0];
    const ov = `
      <div class="ar-rec-ov">
        <div class="ar-rec-stat"><b id="ar-myrank">—</b><span>名次</span></div>
        <div class="ar-rec-stat"><b>${RANK(player.rank_score)}</b><span>牌位 ${player.rank_score || 0}</span></div>
        <div class="ar-rec-stat"><b>${w}</b><span>勝場</span></div>
        <div class="ar-rec-stat"><b>${wr}%</b><span>勝率</span></div>
      </div>`;
    const mvpHtml = mvp ? `
      <div class="ar-rec-mvp">
        <div class="ar-rec-mvp-img">${mvp.photo_url ? `<img src="${esc(mvp.photo_url)}" alt=""/>` : '<span>🤖</span>'}</div>
        <div class="ar-rec-mvp-info"><div class="ar-rec-mvp-tag">🏆 MVP 機體</div><div class="ar-rec-mvp-name">${esc(mvp.name)}</div><div class="ar-rec-mvp-sub">${mvp.wins || 0} 勝 / ${mvp.battles || 0} 戰 · 勝率 ${pct(mvp.wins, mvp.battles)}%</div></div>
      </div>` : '';
    const rows = fought.length ? fought.map((c) => `
      <div class="ar-rec-row">
        <div class="ar-rec-c">${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : '<span>🤖</span>'}<span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span></div>
        <div class="ar-rec-cn"><div class="ar-rec-cname">${esc(c.name)}</div><div class="ar-rec-cbar"><i style="width:${pct(c.wins, c.battles)}%"></i></div></div>
        <div class="ar-rec-cstat"><b>${pct(c.wins, c.battles)}%</b><span>${c.wins || 0}/${c.battles || 0}</span></div>
      </div>`).join('') : '<div class="ar-empty-hangar">還沒有出擊紀錄 ⚔️<br>到大廳按「出擊」開始你的第一場戰鬥！</div>';
    $('ar-record')!.innerHTML = `<h2 class="ar-h2">🏆 天梯</h2>${ov}
      <div class="ar-rec-h">排行榜 Top 30</div>
      <div class="ar-lb" id="ar-lb"><div class="ar-bt-loading" style="padding:24px"><div class="ar-spin"></div></div></div>
      <div class="ar-rec-h" style="margin-top:18px">我的機體戰績</div>${mvpHtml}<div class="ar-rec-list">${rows}</div>`;
    try {
      const r = await fetch('/api/card/ladder', { credentials: 'include' });
      const d = await r.json();
      if (d.ok) {
        const myr = document.getElementById('ar-myrank'); if (myr) myr.textContent = d.me.rank ? '#' + d.me.rank : '—';
        const board = (d.top || []).map((row: any) => `<div class="ar-lb-row${row.me ? ' me' : ''}"><span class="ar-lb-rank">${row.rank}</span><div class="ar-lb-info"><div class="ar-lb-name">${esc(row.name)}${row.me ? ' (我)' : ''}</div><div class="ar-lb-fleet">${(row.fleet || []).map((c: any) => `<span class="ar-tbadge ${TYPE[c.type]?.c || ''}" style="width:15px;height:15px;font-size:9px">${TYPE[c.type]?.t || '?'}</span>`).join('')}</div></div><span class="ar-lb-score">${row.rank_score}</span></div>`).join('');
        const lb = document.getElementById('ar-lb'); if (lb) lb.innerHTML = board || '<div class="ar-empty-hangar">尚無排名</div>';
      }
    } catch {}
  }

  // tabs
  document.querySelectorAll('.ar-nav-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const soon = (b as HTMLElement).dataset.soon;
      if (soon) { toast(soon + ' 即將推出 🚧'); return; }
      const tab = (b as HTMLElement).dataset.tab!;
      document.querySelectorAll('.ar-nav-btn').forEach((x) => x.classList.toggle('is-active', x === b));
      document.querySelectorAll('.ar-tab').forEach((s) => s.toggleAttribute('hidden', s.id !== 'tab-' + tab));
      $('ar-create-fab')!.toggleAttribute('hidden', tab !== 'hangar');
      if (tab === 'record') renderRecord();
    });
  });

  $('ar-en-btn')!.addEventListener('click', () => toast('EN 體力系統開發中 ⚡'));

  // 創卡
  $('ar-create-fab')!.addEventListener('click', () => ($('ar-file') as HTMLInputElement).click());
  ($('ar-file') as HTMLInputElement).addEventListener('change', async function () {
    const f = this.files?.[0]; this.value = '';
    if (!f) return;
    showLoading();
    try {
      const img = await resize(f);
      const r = await fetch('/api/card/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ image: img }) });
      let d: any = null; try { d = await r.json(); } catch {}
      hideLoading();
      if (!r.ok || !d || !d.ok) { toast((d && d.message) || (r.status >= 500 ? 'AI 忙線中，稍後再試' : '生成失敗')); return; }
      reveal(d.card);
      await loadData();
    } catch { hideLoading(); toast('讀圖或網路錯誤'); }
  });

  function resize(f: File): Promise<{ mime: string; base64: string }> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(f); const im = new Image();
      im.onload = () => {
        URL.revokeObjectURL(url);
        const MAX = 1280; let w = im.naturalWidth || im.width, h = im.naturalHeight || im.height;
        if (Math.max(w, h) > MAX) { const s = MAX / Math.max(w, h); w = Math.round(w * s); h = Math.round(h * s); }
        try { const c = document.createElement('canvas'); c.width = w; c.height = h; c.getContext('2d')!.drawImage(im, 0, 0, w, h); resolve({ mime: 'image/jpeg', base64: c.toDataURL('image/jpeg', 0.85).split(',')[1] || '' }); } catch (e) { reject(e); }
      };
      im.onerror = () => { URL.revokeObjectURL(url); reject(new Error('讀圖失敗')); };
      im.src = url;
    });
  }

  let loadingEl: HTMLElement | null = null;
  function showLoading() { loadingEl = document.createElement('div'); loadingEl.className = 'ar-loading'; loadingEl.innerHTML = '<div class="ar-spin"></div><div>AI 組裝中…</div>'; document.body.appendChild(loadingEl); }
  function hideLoading() { if (loadingEl) { loadingEl.remove(); loadingEl = null; } }

  // 開卡演出
  function reveal(c: any) {
    const pow = c.hp + c.atk + c.def + c.mob;
    const rarLabel: any = { N: '★ N', R: '★★ R', SR: '★★★ SR', SSR: '☆☆☆☆ SSR ☆☆☆☆' };
    const el = $('ar-reveal')!;
    el.innerHTML = `
      <div class="ar-reveal-inner">
        <div class="ar-reveal-card c-${esc(c.rarity)}">
          <div class="ar-rv-img">${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : ''}</div>
          <div class="ar-rv-body">
            <div class="ar-rv-rar r-${esc(c.rarity)}" style="color:inherit">${rarLabel[c.rarity] || c.rarity}　<span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span>　🌍${esc(c.terrain)}</div>
            <div class="ar-rv-name">${esc(c.name)}</div>
            <div class="ar-rv-flavor">${esc(c.flavor)}</div>
            <div class="ar-rv-stats">
              <div class="ar-rv-stat"><b>${c.hp}</b><small>HP</small></div>
              <div class="ar-rv-stat"><b>${c.atk}</b><small>攻</small></div>
              <div class="ar-rv-stat"><b>${c.def}</b><small>防</small></div>
              <div class="ar-rv-stat"><b>${c.mob}</b><small>機動</small></div>
            </div>
            <div class="ar-rv-special">💥 <b>${esc(c.special_name)}</b>　${esc(c.special_desc)}</div>
            <button class="ar-rv-close" id="ar-rv-close">收進格納庫！（戰力 ${pow}）</button>
          </div>
        </div>
      </div>`;
    el.removeAttribute('hidden');
    $('ar-rv-close')!.addEventListener('click', () => { el.setAttribute('hidden', ''); el.innerHTML = ''; });
  }

  // 卡詳情
  function showDetail(c: any) {
    const pow = c.hp + c.atk + c.def + c.mob;
    const el = $('ar-detail')!;
    const czMoves = new Set<string>(movesOf(c, c.type));   // 目前啟用的招式（全掛時=整池）
    el.innerHTML = `
      <div class="ar-modal-box c-${esc(c.rarity)}">
        <div class="ar-rv-img" style="position:relative"><span class="ar-rar r-${esc(c.rarity)}">${esc(c.rarity)}</span>${c.photo_url ? `<img src="${esc(c.photo_url)}" alt=""/>` : ''}</div>
        <div class="ar-rv-body">
          <div class="ar-rv-name">${esc(c.name)} <span class="ar-tbadge ${TYPE[c.type]?.c || ''}">${TYPE[c.type]?.t || '?'}</span></div>
          <div class="ar-rv-flavor">${esc(c.flavor)} · 🌍${esc(c.terrain)} · 戰歷 ${c.wins}/${c.battles}</div>
          <div class="ar-rv-stats">
            <div class="ar-rv-stat"><b>${c.hp}</b><small>HP</small></div>
            <div class="ar-rv-stat"><b>${c.atk}</b><small>攻</small></div>
            <div class="ar-rv-stat"><b>${c.def}</b><small>防</small></div>
            <div class="ar-rv-stat"><b>${c.mob}</b><small>機動</small></div>
          </div>
          <div class="ar-rv-special">💥 <b>${esc(c.special_name)}</b>　${esc(c.special_desc)}</div>
          <div class="ar-cz">
            <div class="ar-cz-h">🗣️ 語氣 <small>單選一種</small></div>
            <div class="ar-cz-row" id="cz-tones">
              <button class="ar-cz-chip${!c.tone_id ? ' on' : ''}" data-tk="">預設</button>
              ${TONE_KEYS.map((k) => `<button class="ar-cz-chip${c.tone_id === k ? ' on' : ''}" data-tk="${esc(k)}">${esc(toneName(k))}</button>`).join('')}
            </div>
            ${MOVE_POOL[c.type] ? `
            <div class="ar-cz-h">⚔️ 招式 <small>可全掛，至少留一招</small></div>
            <div class="ar-cz-row" id="cz-moves">
              ${MOVE_POOL[c.type].map((m: string) => `<button class="ar-cz-chip${czMoves.has(m) ? ' on' : ''}" data-mv="${esc(m)}">${esc(MOVE_NAME[m] || m)}</button>`).join('')}
            </div>` : '<div class="ar-cz-note">閃避型以「閃避反擊」為主，暫無招式可選。</div>'}
            <button class="ar-edit" id="cz-save" style="width:100%;margin-top:10px">💾 儲存自訂</button>
          </div>
          <button class="ar-rv-close" id="ar-dt-close">關閉（戰力 ${pow}）</button>
        </div>
      </div>`;
    el.removeAttribute('hidden');
    let czTone = c.tone_id || '';
    // 語氣單選
    el.querySelectorAll('#cz-tones .ar-cz-chip').forEach((b) => b.addEventListener('click', () => {
      czTone = (b as HTMLElement).dataset.tk || '';
      el.querySelectorAll('#cz-tones .ar-cz-chip').forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
    }));
    // 招式多選（至少一招）
    el.querySelectorAll('#cz-moves .ar-cz-chip').forEach((b) => b.addEventListener('click', () => {
      const mv = (b as HTMLElement).dataset.mv!;
      if (czMoves.has(mv)) { if (czMoves.size <= 1) { toast('至少要留一招'); return; } czMoves.delete(mv); b.classList.remove('on'); }
      else { czMoves.add(mv); b.classList.add('on'); }
    }));
    $('cz-save')?.addEventListener('click', async () => {
      const pool: string[] = MOVE_POOL[c.type] || [];
      const arr = Array.from(czMoves);
      const movesPayload = pool.length && arr.length && arr.length < pool.length ? arr : null;   // 全掛/空 → null
      const btn = $('cz-save') as HTMLButtonElement; if (btn) { btn.disabled = true; btn.textContent = '儲存中…'; }
      try {
        const r = await fetch('/api/card/customize', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ card_id: c.id, tone_id: czTone || null, moves: movesPayload }) });
        const j = await r.json();
        if (!r.ok || !j.ok) { toast((j && j.message) || '儲存失敗'); if (btn) { btn.disabled = false; btn.textContent = '💾 儲存自訂'; } return; }
        c.tone_id = j.tone_id || null; c.moves = j.moves || null;   // 同步本地（下場戰鬥即生效）
        toast('已儲存 ✅'); el.setAttribute('hidden', ''); el.innerHTML = '';
      } catch { toast('網路錯誤'); if (btn) { btn.disabled = false; btn.textContent = '💾 儲存自訂'; } }
    });
    $('ar-dt-close')!.addEventListener('click', () => { el.setAttribute('hidden', ''); el.innerHTML = ''; });
    el.addEventListener('click', (e) => { if (e.target === el) { el.setAttribute('hidden', ''); el.innerHTML = ''; } });
  }
</script>
