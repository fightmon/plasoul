</style>

<script>
  /* ============================================
     Fetch stats + render
     + 系列展開/收起 toggle
     ============================================ */
  type StatsResponse = {
    ok: boolean;
    counts: Record<string, number>;
    source_count: number;
    total_count: number;
  };

  function formatNum(n: number): string {
    if (n >= 1000) return (Math.floor(n / 100) / 10) + 'k';
    return String(n);
  }

  async function loadStats() {
    try {
      const res = await fetch('/api/public/stats');
      if (!res.ok) return;
      const data: StatsResponse = await res.json();
      if (!data.ok) return;

      // 主要 4 個顯著數字
      const statMap: Record<string, number> = {
        hg: data.counts.HG || 0,
        rg: data.counts.RG || 0,
        mg: data.counts.MG || 0,
        source: data.source_count || 0,
      };
      for (const key of Object.keys(statMap)) {
        const el = document.querySelector('[data-stat="' + key + '"]');
        if (el) el.textContent = formatNum(statMap[key]);
      }

      // 各系列卡片角落筆數
      const seriesEls = document.querySelectorAll<HTMLElement>('[data-series-count]');
      seriesEls.forEach((el) => {
        const key = el.getAttribute('data-series-count');
        if (!key) return;
        const count = (data.counts as Record<string, number>)[key] || 0;
        el.textContent = formatNum(count);
      });
    } catch (e) {
      // silent fail — UI 已有 placeholder "—"
      console.warn('[stats] fetch failed', e);
    }
  }

  /* === 系列「展開/收起」 toggle === */
  function bindSeriesToggle() {
    const btn = document.getElementById('ps-series-toggle');
    const more = document.getElementById('ps-series-more');
    if (!btn || !more) return;
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) {
        more.setAttribute('hidden', '');
      } else {
        more.removeAttribute('hidden');
      }
    });
  }

  loadStats();
  bindSeriesToggle();
</script>
