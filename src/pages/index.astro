---
import Layout from "../layouts/Layout.astro";

/**
 * 首頁
 * - Hero: GAME8LA 風（深色 + 科幻網格 + 雙 CTA）
 * - Stats: GAME8LA 風 4 格大字
 * - 系列按鈕: 6 核心 + 收起展開 6 個次要
 *
 * 統計數字 client-side fetch /api/public/stats（避免 build time 寫死）
 */

// 系列定義（首屏顯示 + 收起展開）
const PRIMARY_SERIES = [
  { key: "HG", label: "HG", desc: "High Grade" },
  { key: "RG", label: "RG", desc: "Real Grade" },
  { key: "MG", label: "MG", desc: "Master Grade" },
  { key: "MGSD", label: "MGSD", desc: "Master Grade SD" },
  { key: "PG", label: "PG", desc: "Perfect Grade" },
  { key: "SD", label: "SD", desc: "Super Deformed" },
];

const SECONDARY_SERIES = [
  { key: "MGEX", label: "MGEX" },
  { key: "ETC", label: "ETC/Gunpla" },
  { key: "ROBOT", label: "ROBOT魂" },
  { key: "METAL_ROBOT", label: "METAL ROBOT魂" },
  { key: "CHOGOKIN", label: "超合金" },
  { key: "OTHER", label: "其他" },
];
---

<Layout
  title="普拉魂 PuraSoul · 鋼普拉找便宜"
  description="玩家社群實際交易參考價，每天更新。普拉魂幫你嗅出賣家自售價。"
  hideHeaderSearch={false}
>
  <main class="ps-home">
    {/* ============================================
        Hero (GAME8LA 風)
        ============================================ */}
    <section class="ps-hero" aria-label="hero">
      <div class="ps-hero-bg" aria-hidden="true"></div>
      <div class="ps-hero-inner">
        <div class="ps-hero-content">
          <span class="ps-eyebrow ps-eyebrow--hero">
            <span class="ps-eyebrow-dot" aria-hidden="true"></span>
            每日更新 · 玩家社群實時參考價
          </span>
          <h1 class="ps-hero-title">
            普拉犬，<span class="ps-hero-title-accent">幫你嗅出</span><br />賣家自售價
          </h1>
          <p class="ps-hero-subtitle">
            收錄各大社群實際交易價 · HG / RG / MG 全系列<br />
            不漏接任何一筆便宜貨
          </p>
          <div class="ps-hero-ctas">
            <a href="/search" class="ps-cta ps-cta-primary">
              立即搜尋鋼彈
              <span class="ps-cta-arrow">→</span>
            </a>
            <a href="/search?sort=newest" class="ps-cta ps-cta-secondary">
              最新賣家動態
              <span class="ps-cta-arrow">→</span>
            </a>
          </div>
        </div>
        <div class="ps-hero-visual" aria-hidden="true">
          <div class="ps-blob">
            <span class="ps-blob-label">鋼普拉模型示意</span>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================
        Stats (GAME8LA 風 4 格大字)
        ============================================ */}
    <section class="ps-stats" aria-label="資料統計">
      <div class="ps-section-head">
        <span class="ps-eyebrow">STATS</span>
        <h2 class="ps-section-title">即時資料量級</h2>
      </div>
      <div class="ps-stats-inner">
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="hg">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">🎴</span> HG 筆數</div>
        </div>
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="rg">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">🎯</span> RG 筆數</div>
        </div>
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="mg">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">💎</span> MG 筆數</div>
        </div>
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="source">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">📡</span> 賣家連結</div>
        </div>
      </div>
    </section>

    {/* ============================================
        登入區塊（W5 用戶系統完成才開放）
        ============================================
        <section class="ps-login-cta">…</section>
    */}

    {/* ============================================
        系列按鈕
        ============================================ */}
    <section class="ps-series" aria-label="依系列瀏覽">
      <div class="ps-section-head">
        <span class="ps-eyebrow">SERIES</span>
        <h2 class="ps-section-title">依系列瀏覽</h2>
      </div>
      <div class="ps-series-grid">
        {PRIMARY_SERIES.map((s) => (
          <a href={`/search?series=${encodeURIComponent(s.key)}`} class="ps-series-btn" data-series={s.key}>
            <span class="ps-series-label">{s.label}</span>
            {s.desc && <span class="ps-series-desc">{s.desc}</span>}
            <span class="ps-series-count" data-series-count={s.key}>—</span>
          </a>
        ))}
      </div>
      <button
        type="button"
        id="ps-series-toggle"
        class="ps-series-toggle"
        aria-expanded="false"
        aria-controls="ps-series-more"
      >
        <span class="ps-series-toggle-open">展開更多系列 ↓</span>
        <span class="ps-series-toggle-close">收起 ↑</span>
      </button>
      <div id="ps-series-more" class="ps-series-grid ps-series-more" hidden>
        {SECONDARY_SERIES.map((s) => (
          <a href={`/search?series=${encodeURIComponent(s.key)}`} class="ps-series-btn ps-series-btn-sm">
            <span class="ps-series-label">{s.label}</span>
            <span class="ps-series-count" data-series-count={s.key}>—</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .ps-home {
    min-height: 100vh;
    /* 確保不被任何 parent 限寬 / 加 margin */
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }
  /* 確保 hero 是真正的邊到邊（防禦：避免 parent 留 padding/margin） */
  .ps-hero,
  .ps-stats {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    border-radius: 0;
    border-left: none;
    border-right: none;
  }

  /* ============================================
     共用：Eyebrow pill 章節小標
     ============================================ */
  .ps-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--accent-amber-soft);
    color: var(--accent-amber);
    border: 1px solid rgba(212, 146, 90, 0.28);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    margin-bottom: 14px;
  }
  .ps-eyebrow--hero {
    background: rgba(255, 255, 255, 0.06);
    color: var(--accent-amber);
    border-color: rgba(212, 146, 90, 0.32);
  }
  .ps-eyebrow-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent-amber);
    box-shadow: 0 0 8px var(--accent-amber-glow);
  }

  /* ============================================
     共用：Section Head
     ============================================ */
  .ps-section-head {
    max-width: 1200px;
    margin: 0 auto 24px;
    padding: 0;
  }
  .ps-section-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }

  /* ============================================
     Hero（兩欄：左大字 + 右 blob 圖位）
     ============================================ */
  .ps-hero {
    position: relative;
    background: var(--hero-bg);
    overflow: hidden;
    padding: clamp(56px, 9vw, 96px) 16px;
  }
  .ps-hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse 60vw 40vh at 15% 30%, var(--accent-amber-glow) 0%, transparent 55%),
      radial-gradient(ellipse 50vw 35vh at 85% 75%, rgba(127, 184, 154, 0.14) 0%, transparent 55%),
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 48px 48px, 48px 48px;
    pointer-events: none;
  }
  .ps-hero-inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .ps-hero-inner {
      grid-template-columns: 6fr 5fr;
      gap: 64px;
    }
  }

  .ps-hero-content { text-align: center; }
  @media (min-width: 1024px) {
    .ps-hero-content { text-align: left; }
  }

  .ps-hero-title {
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 800;
    color: var(--hero-text);
    line-height: 1.2;
    margin: 0 0 18px;
    letter-spacing: -0.5px;
  }
  .ps-hero-title-accent {
    color: var(--hero-bg-glow);
    text-shadow: 0 0 32px var(--accent-amber-glow);
  }
  .ps-hero-subtitle {
    font-size: clamp(15px, 1.6vw, 17px);
    color: var(--hero-text-secondary);
    margin: 0 auto 32px;
    line-height: 1.75;
    max-width: 480px;
  }
  @media (min-width: 1024px) {
    .ps-hero-subtitle { margin-left: 0; margin-right: 0; }
  }

  .ps-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  @media (min-width: 1024px) {
    .ps-hero-ctas { justify-content: flex-start; }
  }

  /* === Hero visual：blob placeholder（之後填鋼普拉模型圖）=== */
  .ps-hero-visual {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 5;
    margin: 0 auto;
  }
  .ps-blob {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-blob-1);
    background:
      radial-gradient(circle at 32% 28%, rgba(212, 146, 90, 0.45) 0%, transparent 55%),
      radial-gradient(circle at 70% 70%, rgba(127, 184, 154, 0.32) 0%, transparent 50%),
      linear-gradient(140deg, var(--hero-bg-warm-1) 0%, var(--hero-bg-warm-2) 100%);
    border: 1px solid rgba(212, 146, 90, 0.20);
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: ps-blob-float 6s ease-in-out infinite;
  }
  .ps-blob-label {
    color: var(--hero-text-muted);
    font-size: 14px;
    letter-spacing: 3px;
    font-weight: 500;
  }
  @keyframes ps-blob-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-8px) rotate(-1deg); }
  }
  @media (max-width: 1023px) {
    .ps-hero-visual { max-width: 320px; aspect-ratio: 1; }
  }
  /* 手機版：blob 還沒填圖前先收起來，省半個螢幕的滾動 */
  @media (max-width: 768px) {
    .ps-hero { padding: clamp(40px, 7vw, 64px) 16px clamp(32px, 6vw, 48px); }
    .ps-hero-visual { display: none; }
    .ps-hero-content { padding: 0; }
  }

  /* ============================================
     CTA
     ============================================ */
  .ps-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: transform 0.18s, box-shadow 0.18s, background-color 0.18s, border-color 0.18s;
    border: 1.5px solid transparent;
  }
  .ps-cta:hover { transform: translateY(-2px); }
  .ps-cta-arrow { transition: transform 0.18s; }
  .ps-cta:hover .ps-cta-arrow { transform: translateX(2px); }

  .ps-cta-primary {
    background: var(--hero-cta-primary-bg);
    color: var(--hero-cta-primary-text);
    box-shadow: 0 8px 20px var(--accent-amber-glow);
  }
  .ps-cta-primary:hover {
    background: var(--hero-cta-primary-bg-hover);
    box-shadow: 0 12px 28px var(--accent-amber-glow);
  }

  .ps-cta-secondary {
    background: rgba(255, 255, 255, 0.04);
    color: var(--hero-cta-secondary-text);
    border-color: var(--hero-cta-secondary-border);
  }
  .ps-cta-secondary:hover {
    background: var(--accent-amber-soft);
    border-color: var(--accent-amber);
  }

  /* ============================================
     Stats（4 漸層卡 暗底暖光暈）
     ============================================ */
  .ps-stats {
    padding: clamp(48px, 7vw, 72px) 16px clamp(24px, 4vw, 32px);
  }
  .ps-stats > .ps-section-head {
    max-width: 1200px;
    padding: 0;
  }
  .ps-stats-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  /* 純字版 stat（拿掉卡片，只保留圖示 + 數字 + 標籤）*/
  .ps-stat {
    text-align: center;
  }
  .ps-stat-num {
    font-size: clamp(30px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--accent-amber);
    line-height: 1;
    margin-bottom: 6px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.5px;
  }
  .ps-stat-num::after {
    content: "+";
    font-size: 0.55em;
    opacity: 0.7;
    margin-left: 2px;
    font-weight: 700;
  }
  .ps-stat-label {
    font-size: 13px;
    color: var(--color-text-secondary);
    letter-spacing: 0.3px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .ps-stat-icon {
    font-size: 14px;
    line-height: 1;
    opacity: 0.85;
  }

  /* ============================================
     Series（卡片格 + 暖光 hover）
     ============================================ */
  .ps-series {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 72px) 16px clamp(56px, 7vw, 80px);
  }
  .ps-series-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
  }
  .ps-series-more { margin-top: 14px; }

  .ps-series-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 6px;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 16px;
    background: var(--color-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s, background-color 0.18s;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .ps-series-btn::before {
    content: "";
    position: absolute;
    top: -20%; right: -20%;
    width: 60%; height: 60%;
    background: radial-gradient(circle, var(--accent-amber-glow) 0%, transparent 70%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .ps-series-btn:hover {
    transform: translateY(-3px);
    border-color: var(--accent-amber);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.14);
  }
  .ps-series-btn:hover::before { opacity: 1; }

  .ps-series-btn-sm { padding: 16px 16px; gap: 4px; }

  .ps-series-label {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 1px;
    position: relative;
    z-index: 1;
  }
  .ps-series-btn-sm .ps-series-label { font-size: 17px; }

  .ps-series-desc {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    position: relative;
    z-index: 1;
    line-height: 1.4;
  }

  .ps-series-count {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    position: relative;
    z-index: 1;
    margin-top: 4px;
  }
  .ps-series-count::after {
    content: "筆";
    font-size: 0.85em;
    margin-left: 2px;
  }

  .ps-series-toggle {
    display: block;
    margin: 24px auto 0;
    padding: 10px 24px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .ps-series-toggle:hover {
    background: var(--accent-amber-soft);
    color: var(--accent-amber);
    border-color: var(--accent-amber);
  }
  .ps-series-toggle-close { display: none; }
  .ps-series-toggle[aria-expanded="true"] .ps-series-toggle-open { display: none; }
  .ps-series-toggle[aria-expanded="true"] .ps-series-toggle-close { display: inline; }

  /* ============================================
     Responsive — 系列格分段降欄 6 → 4 → 3 → 2
     ============================================ */
  @media (max-width: 1024px) {
    .ps-series-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .ps-stats-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .ps-stat-num { font-size: clamp(28px, 7vw, 36px); }
    .ps-stat-label { font-size: 12px; }
    .ps-series-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .ps-series-btn { padding: 16px 12px; }
    .ps-series-label { font-size: 19px; }
  }

  @media (max-width: 480px) {
    .ps-cta {
      padding: 12px 22px;
      font-size: 14px;
    }
    .ps-hero-ctas {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
    }
    .ps-hero-ctas .ps-cta {
      width: 100%;
      justify-content: center;
    }
    .ps-series-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>

<script>
  /* ============================================
     Fetch stats + render
     + 系列展開/收起 toggle
     ============================================ */
  type StatsResponse = {
    ok: boolean;
    counts: Record<string, number>;
    source_count: number;
    total_count: number;
  };

  function formatNum(n: number): string {
    if (n >= 1000) return (Math.floor(n / 100) / 10) + 'k';
    return String(n);
  }

  async function loadStats() {
    try {
      const res = await fetch('/api/public/stats');
      if (!res.ok) return;
      const data: StatsResponse = await res.json();
      if (!data.ok) return;

      // 主要 4 個顯著數字
      const statMap: Record<string, number> = {
        hg: data.counts.HG || 0,
        rg: data.counts.RG || 0,
        mg: data.counts.MG || 0,
        source: data.source_count || 0,
      };
      for (const key of Object.keys(statMap)) {
        const el = document.querySelector('[data-stat="' + key + '"]');
        if (el) el.textContent = formatNum(statMap[key]);
      }

      // 各系列卡片角落筆數
      const seriesEls = document.querySelectorAll<HTMLElement>('[data-series-count]');
      seriesEls.forEach((el) => {
        const key = el.getAttribute('data-series-count');
        if (!key) return;
        const count = (data.counts as Record<string, number>)[key] || 0;
        el.textContent = formatNum(count);
      });
    } catch (e) {
      // silent fail — UI 已有 placeholder "—"
      console.warn('[stats] fetch failed', e);
    }
  }

  /* === 系列「展開/收起」 toggle === */
  function bindSeriesToggle() {
    const btn = document.getElementById('ps-series-toggle');
    const more = document.getElementById('ps-series-more');
    if (!btn || !more) return;
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) {
        more.setAttribute('hidden', '');
      } else {
        more.removeAttribute('hidden');
      }
    });
  }

  loadStats();
  bindSeriesToggle();
</script>
