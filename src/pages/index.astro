---
import Layout from "../layouts/Layout.astro";
import SnipeFx from "../components/SnipeFx.astro";
import { getCollection } from "astro:content";

const latestDevlog = (await getCollection("devlog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)[0];

/**
 * 首頁
 * - Hero: GAME8LA 風（深色 + 科幻網格 + 雙 CTA）
 * - Stats: GAME8LA 風 4 格大字
 * - 系列按鈕: 6 核心 + 收起展開 6 個次要
 *
 * 統計數字 client-side fetch /api/public/stats（避免 build time 寫死）
 */

// 系列定義（首屏顯示 + 收起展開）
const PRIMARY_SERIES = [
  { key: "HG", label: "HG", desc: "High Grade" },
  { key: "RG", label: "RG", desc: "Real Grade" },
  { key: "MG", label: "MG", desc: "Master Grade" },
  { key: "MGSD", label: "MGSD", desc: "Master Grade SD" },
  { key: "PG", label: "PG", desc: "Perfect Grade" },
  { key: "SD", label: "SD", desc: "Super Deformed" },
];

const SECONDARY_SERIES = [
  { key: "MGEX", label: "MGEX" },
  { key: "ETC", label: "ETC/Gunpla" },
  { key: "ROBOT", label: "ROBOT魂" },
  { key: "METAL_ROBOT", label: "METAL ROBOT魂" },
  { key: "CHOGOKIN", label: "超合金" },
  { key: "OTHER", label: "其他" },
];
---

<Layout
  title="普拉魂 PuraSoul · 鋼普拉找便宜"
  description="玩家社群實際交易參考價，每天更新。普拉魂幫你嗅出賣家自售價。"
  hideHeaderSearch={false}
>
  <main class="ps-home">
    {/* ============================================
        Hero (GAME8LA 風)
        ============================================ */}
    <section class="ps-hero" aria-label="hero">
      <div class="ps-hero-bg" aria-hidden="true"></div>
      <div class="ps-hero-inner">
        <div class="ps-hero-content">
          <span class="ps-eyebrow ps-eyebrow--hero">
            <span class="ps-eyebrow-dot" aria-hidden="true"></span>
            🎴 創鬥卡 ARENA · 用你的模型對戰
          </span>
          <h1 class="ps-hero-title">
            拍下你的模型，<br /><span class="ps-hero-title-accent">生成專屬戰鬥卡</span>
          </h1>
          <p class="ps-hero-subtitle">
            拍照 → 生成能力卡 → 組艦對戰<br />
            炫耀你親手做的鋼彈／鋼普拉模型
          </p>
          <div class="ps-hero-ctas">
            <a href="/arena" class="ps-cta ps-cta-primary">
              進入競技場
              <span class="ps-cta-arrow">→</span>
            </a>
          </div>
        </div>
        <div class="ps-hero-visual" aria-hidden="true">
          <div class="ps-blob">
            <span class="ps-blob-label">戰鬥卡示意</span>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================
        找便宜帶（比價搜尋；定位翻轉後移到遊戲 hero 下方）
        ============================================ */}
    <section class="ps-game-band" aria-label="找便宜">
      <div class="ps-game-bg" aria-hidden="true"></div>
      <div class="ps-game-inner">
        <div class="ps-game-content">
          <span class="ps-game-eyebrow">🐶 每日更新 · 玩家社群實時參考價</span>
          <h2 class="ps-game-title">普拉犬，幫你<span class="ps-game-accent">嗅出賣家自售價</span></h2>
          <p class="ps-game-sub">收錄各大社群實際交易價 · HG / RG / MG 全系列，不漏接任何一筆便宜貨</p>
          <form action="/search" method="get" class="ps-hero-search" role="search">
            <input type="search" name="q" class="ps-hero-search-input" placeholder="輸入型號或名稱，例：RX-78-2、自由、牛鋼" aria-label="搜尋鋼彈" autocomplete="off" />
            <button type="submit" class="ps-hero-search-btn">搜尋 <span class="ps-cta-arrow">→</span></button>
          </form>
          <a href="/search?sort=newest" class="ps-cta ps-cta-secondary" style="margin-top:14px;">最新賣家動態 <span class="ps-cta-arrow">→</span></a>
        </div>
      </div>
    </section>

    {/* ============================================
        開發日誌（最新一篇 teaser）
        ============================================ */}
    {latestDevlog && (
      <section class="ps-devlog" aria-label="開發日誌">
        <div class="ps-devlog-inner">
          <div class="ps-section-head ps-devlog-head">
            <span class="ps-eyebrow">DEVLOG</span>
            <h2 class="ps-section-title">開發日誌</h2>
            <p class="ps-devlog-lede">一個人把創鬥卡一招一招做出來的碎碎念。</p>
          </div>
          <a class="ps-devlog-card" href={`/devlog/${latestDevlog.id}`}>
            <div class="ps-devlog-cover snipe-demo" data-variant={latestDevlog.data.cover} data-size="thumb"></div>
            <div class="ps-devlog-text">
              <div class="ps-devlog-date">{latestDevlog.data.date.toISOString().slice(0, 10)} · 最新</div>
              <h3 class="ps-devlog-title">{latestDevlog.data.title}</h3>
              <p class="ps-devlog-sum">{latestDevlog.data.summary}</p>
              <span class="ps-devlog-more">讀這篇 →</span>
            </div>
          </a>
          <a class="ps-devlog-all" href="/devlog">看全部開發日誌 →</a>
        </div>
      </section>
    )}

    {/* ============================================
        Stats (GAME8LA 風 4 格大字)
        ============================================ */}
    <section class="ps-stats" aria-label="資料統計">
      <div class="ps-section-head">
        <span class="ps-eyebrow">STATS</span>
        <h2 class="ps-section-title">即時資料量級</h2>
      </div>
      <div class="ps-stats-inner">
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="hg">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">🎴</span> HG 筆數</div>
        </div>
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="rg">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">🎯</span> RG 筆數</div>
        </div>
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="mg">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">💎</span> MG 筆數</div>
        </div>
        <div class="ps-stat">
          <div class="ps-stat-num" data-stat="source">—</div>
          <div class="ps-stat-label"><span class="ps-stat-icon" aria-hidden="true">📡</span> 賣家連結</div>
        </div>
      </div>
    </section>

    {/* ============================================
        登入區塊（W5 用戶系統完成才開放）
        ============================================
        <section class="ps-login-cta">…</section>
    */}

    {/* ============================================
        系列按鈕
        ============================================ */}
    <section class="ps-series" aria-label="依系列瀏覽">
      <div class="ps-section-head">
        <span class="ps-eyebrow">SERIES</span>
        <h2 class="ps-section-title">依系列瀏覽</h2>
      </div>
      <div class="ps-series-grid">
        {PRIMARY_SERIES.map((s) => (
          <a href={`/search?series=${encodeURIComponent(s.key)}`} class="ps-series-btn" data-series={s.key}>
            <span class="ps-series-label">{s.label}</span>
            {s.desc && <span class="ps-series-desc">{s.desc}</span>}
            <span class="ps-series-count" data-series-count={s.key}>—</span>
          </a>
        ))}
      </div>
      <button
        type="button"
        id="ps-series-toggle"
        class="ps-series-toggle"
        aria-expanded="false"
        aria-controls="ps-series-more"
      >
        <span class="ps-series-toggle-open">展開更多系列 ↓</span>
        <span class="ps-series-toggle-close">收起 ↑</span>
      </button>
      <div id="ps-series-more" class="ps-series-grid ps-series-more" hidden>
        {SECONDARY_SERIES.map((s) => (
          <a href={`/search?series=${encodeURIComponent(s.key)}`} class="ps-series-btn ps-series-btn-sm">
            <span class="ps-series-label">{s.label}</span>
            <span class="ps-series-count" data-series-count={s.key}>—</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <SnipeFx />
</Layout>

<style>
  .ps-home {
    min-height: 100vh;
    /* 確保不被任何 parent 限寬 / 加 margin */
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }
  /* 確保 hero 是真正的邊到邊（防禦：避免 parent 留 padding/margin） */
  .ps-hero,
  .ps-stats {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    border-radius: 0;
    border-left: none;
    border-right: none;
  }

  /* ============================================
     共用：Eyebrow pill 章節小標
     ============================================ */
  .ps-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--accent-amber-soft);
    color: var(--color-primary-dark);
    border: 1px solid rgba(21, 119, 224, 0.30);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    margin-bottom: 14px;
  }
  .ps-eyebrow--hero {
    background: rgba(255, 255, 255, 0.08);
    color: #A9C7FF;
    border-color: rgba(21, 119, 224, 0.40);
  }
  .ps-eyebrow-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent-amber);
    box-shadow: 0 0 8px var(--accent-amber-glow);
  }

  /* ============================================
     共用：Section Head
     ============================================ */
  .ps-section-head {
    max-width: 1200px;
    margin: 0 auto 24px;
    padding: 0;
  }
  .ps-section-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }

  /* ============================================
     Hero（兩欄：左大字 + 右 blob 圖位）
     ============================================ */
  .ps-hero {
    position: relative;
    background: var(--hero-bg);
    overflow: hidden;
    padding: clamp(56px, 9vw, 96px) 16px;
  }
  .ps-hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse 60vw 40vh at 15% 30%, var(--accent-amber-glow) 0%, transparent 55%),
      radial-gradient(ellipse 50vw 35vh at 85% 75%, rgba(228, 0, 43, 0.12) 0%, transparent 55%),
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 48px 48px, 48px 48px;
    pointer-events: none;
  }
  .ps-hero-inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .ps-hero-inner {
      grid-template-columns: 6fr 5fr;
      gap: 64px;
    }
  }

  .ps-hero-content { text-align: center; }
  @media (min-width: 1024px) {
    .ps-hero-content { text-align: left; }
  }

  .ps-hero-title {
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 800;
    color: var(--hero-text);
    line-height: 1.2;
    margin: 0 0 18px;
    letter-spacing: -0.5px;
  }
  .ps-hero-title-accent {
    color: var(--hero-bg-glow);
    text-shadow: 0 0 32px rgba(228, 0, 43, 0.5);
  }
  .ps-hero-subtitle {
    font-size: clamp(15px, 1.6vw, 17px);
    color: var(--hero-text-secondary);
    margin: 0 auto 32px;
    line-height: 1.75;
    max-width: 480px;
  }
  @media (min-width: 1024px) {
    .ps-hero-subtitle { margin-left: 0; margin-right: 0; }
  }

  /* === Hero 搜尋框（首頁直接搜）=== */
  .ps-hero-search {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 540px;
    margin: 0 auto 14px;
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-pill);
    padding: 6px 6px 6px 18px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.38);
  }
  .ps-hero-search:focus-within {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 0 3px rgba(21, 119, 224, 0.45);
  }
  @media (min-width: 1024px) {
    .ps-hero-search { margin-left: 0; margin-right: 0; }
  }
  .ps-hero-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: #1d1d1f;
    padding: 11px 0;
    font-family: inherit;
  }
  .ps-hero-search-input::placeholder { color: #8a8a90; }
  .ps-hero-search-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--hero-cta-primary-bg);
    color: #fff;
    border: none;
    border-radius: var(--radius-pill);
    padding: 12px 24px;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    font-family: inherit;
    transition: background-color 0.15s, transform 0.15s;
  }
  .ps-hero-search-btn:hover { background: var(--hero-cta-primary-bg-hover); transform: translateY(-1px); }
  .ps-hero-search-btn:hover .ps-cta-arrow { transform: translateX(2px); }

  .ps-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  @media (min-width: 1024px) {
    .ps-hero-ctas { justify-content: flex-start; }
  }

  /* === Hero visual：blob placeholder（之後填鋼普拉模型圖）=== */
  .ps-hero-visual {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 5;
    margin: 0 auto;
  }
  .ps-blob {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-blob-1);
    background:
      radial-gradient(circle at 32% 28%, rgba(30, 80, 229, 0.45) 0%, transparent 55%),
      radial-gradient(circle at 70% 70%, rgba(228, 0, 43, 0.32) 0%, transparent 50%),
      linear-gradient(140deg, var(--hero-bg-warm-1) 0%, var(--hero-bg-warm-2) 100%);
    border: 1px solid rgba(30, 80, 229, 0.25);
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: ps-blob-float 6s ease-in-out infinite;
  }
  .ps-blob-label {
    color: var(--hero-text-muted);
    font-size: 14px;
    letter-spacing: 3px;
    font-weight: 500;
  }
  @keyframes ps-blob-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-8px) rotate(-1deg); }
  }
  @media (max-width: 1023px) {
    .ps-hero-visual { max-width: 320px; aspect-ratio: 1; }
  }
  /* 手機版：blob 還沒填圖前先收起來，省半個螢幕的滾動 */
  @media (max-width: 768px) {
    .ps-hero { padding: clamp(40px, 7vw, 64px) 16px clamp(32px, 6vw, 48px); }
    .ps-hero-visual { display: none; }
    .ps-hero-content { padding: 0; }
  }

  /* ============================================
     CTA
     ============================================ */
  .ps-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: transform 0.18s, box-shadow 0.18s, background-color 0.18s, border-color 0.18s;
    border: 1.5px solid transparent;
  }
  .ps-cta:hover { transform: translateY(-2px); }
  .ps-cta-arrow { transition: transform 0.18s; }
  .ps-cta:hover .ps-cta-arrow { transform: translateX(2px); }

  .ps-cta-primary {
    background: var(--hero-cta-primary-bg);
    color: var(--hero-cta-primary-text);
    box-shadow: 0 8px 20px var(--accent-amber-glow);
  }
  .ps-cta-primary:hover {
    background: var(--hero-cta-primary-bg-hover);
    box-shadow: 0 12px 28px var(--accent-amber-glow);
  }

  .ps-cta-secondary {
    background: rgba(255, 255, 255, 0.04);
    color: var(--hero-cta-secondary-text);
    border-color: var(--hero-cta-secondary-border);
  }
  .ps-cta-secondary:hover {
    background: var(--accent-amber-soft);
    border-color: var(--accent-amber);
  }

  /* ============================================
     創鬥卡主軸帶
     ============================================ */
  .ps-game-band {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #0c1020;
    padding: clamp(44px, 6vw, 76px) 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .ps-game-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse 50vw 40vh at 82% 28%, rgba(228, 0, 43, 0.22) 0%, transparent 60%),
      radial-gradient(ellipse 40vw 30vh at 8% 82%, rgba(30, 80, 229, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .ps-game-inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 48px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .ps-game-inner { grid-template-columns: 1.2fr 1fr; }
  }
  .ps-game-content { text-align: center; }
  @media (min-width: 900px) {
    .ps-game-content { text-align: left; }
  }
  .ps-game-eyebrow {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(228, 0, 43, 0.16);
    color: #ff9aa8;
    border: 1px solid rgba(228, 0, 43, 0.40);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
  }
  .ps-game-title {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: #fff;
    line-height: 1.25;
    margin: 0 0 14px;
    letter-spacing: -0.5px;
  }
  .ps-game-accent { color: #ff4d5e; text-shadow: 0 0 28px rgba(228, 0, 43, 0.6); }
  .ps-game-sub {
    font-size: clamp(14px, 1.6vw, 17px);
    color: #aeb8d0;
    margin: 0 auto 26px;
    max-width: 460px;
    line-height: 1.7;
  }
  @media (min-width: 900px) {
    .ps-game-sub { margin-left: 0; margin-right: 0; }
  }
  .ps-game-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #ff5566, #e4002b);
    color: #fff;
    border-radius: 999px;
    padding: 14px 30px;
    font-weight: 800;
    font-size: 16px;
    text-decoration: none;
    box-shadow: 0 10px 28px rgba(228, 0, 43, 0.45);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .ps-game-cta:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(228, 0, 43, 0.6); }
  .ps-game-cta:hover .ps-cta-arrow { transform: translateX(2px); }
  .ps-game-cards { display: flex; justify-content: center; gap: 14px; perspective: 800px; }
  .ps-gc {
    width: 84px;
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 8px;
    font-weight: 900;
    font-size: 15px;
    color: #101010;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
  }
  .ps-gc-1 { background: linear-gradient(135deg, #ffe07a, #ffb01f); transform: rotate(-8deg) translateY(6px); }
  .ps-gc-2 { background: linear-gradient(135deg, #d6a3ff, #b15bff); color: #fff; transform: rotate(0) translateY(-6px); z-index: 1; }
  .ps-gc-3 { background: linear-gradient(135deg, #9fc0ff, #5b86ff); color: #fff; transform: rotate(8deg) translateY(6px); }
  @media (max-width: 480px) { .ps-gc { width: 68px; font-size: 13px; } }

  /* ============================================
     開發日誌 teaser
     ============================================ */
  .ps-devlog { padding: clamp(40px, 6vw, 64px) 16px; }
  .ps-devlog-inner { max-width: 1200px; margin: 0 auto; }
  .ps-devlog-head { margin-bottom: 20px; }
  .ps-devlog-lede { margin: 8px 0 0; color: var(--color-text-secondary); font-size: 14px; }
  .ps-devlog-card {
    display: grid; grid-template-columns: 1fr; gap: 0;
    background: var(--color-card); border: 1px solid var(--color-border-subtle);
    border-radius: 16px; overflow: hidden; text-decoration: none; color: var(--color-text);
    box-shadow: var(--shadow-sm); transition: transform .18s, border-color .18s, box-shadow .18s;
  }
  .ps-devlog-card:hover { transform: translateY(-3px); border-color: var(--accent-amber); box-shadow: 0 12px 30px rgba(0,0,0,.16); }
  @media (min-width: 760px) { .ps-devlog-card { grid-template-columns: 4fr 5fr; } }
