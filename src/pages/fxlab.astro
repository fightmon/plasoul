    };
    const NAMES = Object.keys(FX);

    document.querySelectorAll('.fl-btn').forEach((b) => b.addEventListener('click', () => { const f = FX[b.dataset.fx]; if (f) f(); }));
    document.querySelectorAll('.fl-cat-h').forEach((h) => h.addEventListener('click', () => { const cat = h.parentElement; const was = cat.classList.contains('open'); document.querySelectorAll('.fl-cat').forEach((c) => c.classList.remove('open')); if (!was) cat.classList.add('open'); }));
    $('fl-mode').addEventListener('click', () => setMode(!field().classList.contains('m3')));
    $('fl-dir').addEventListener('click', () => { atk = atk === 'my' ? 'foe' : 'my'; $('fl-dir').textContent = '攻方：' + (atk === 'my' ? '我方 ▶' : '敵方 ◀'); });
    $('fl-rand').addEventListener('click', () => { FX[NAMES[Math.floor(Math.random() * NAMES.length)]](); });
    $('fl-seq').addEventListener('click', () => { NAMES.forEach((n, i) => setTimeout(() => FX[n](), i * 1300)); });
  </script>
</body>
</html>
