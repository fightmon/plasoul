    const RANGED_ROWS = [
      ['炮擊系', [['shot', '連發'], ['cannon', '炮彈'], ['shotgun', '散彈'], ['homing', '追蹤'], ['snipe', '狙擊']]],
      ['光束系', [['laser', '雷射'], ['charge', '蓄力'], ['bit', '子機'], ['wave', '波動'], ['snipeb', '狙擊']]],
    ];
    const MOVES = {
      ranged: RANGED_ROWS.flatMap(([, mv]) => mv),
      melee: [['slash', '直斬'], ['arc', '弧斬'], ['iai', '居合'], ['thrust', '突刺'], ['cross', '十字'], ['spin', '迴旋'], ['impact', '重擊']],
      evade: [['dduck', '下蹲'], ['dback', '後撤'], ['dside', '側移'], ['dafter', '殘影'], ['dblink', '瞬移'], ['dspin', '旋身'], ['droll', '翻滾']],
    };
    const aoeOn = () => $('fl-aoe').classList.contains('on');
    const isEvade = (k) => k[0] === 'd';
    const SELF_AOE = new Set(['laser', 'cannon', 'shotgun', 'shot', 'charge', 'homing', 'snipe', 'snipeb', 'bit']);   // 自己處理全體演出的招式（不用通用逐卡重播）
    // 單：打中間卡一次；全：依序對 3 張卡各施放一次（每次鎖定該卡，間隔夠長避免目標錯亂）
    function runMove(k) {
      const fn = FX[k]; if (!fn) return;
      if (!aoeOn() || isEvade(k) || SELF_AOE.has(k)) { AOE_TGT = null; fn(); return; }
      [0, 1, 2].forEach((i, idx) => setTimeout(() => {
        AOE_TGT = card(oth(), i); fn();
        if (idx === 2) setTimeout(() => { AOE_TGT = null; }, 900);
      }, idx * 900));
    }
    function renderMoves(cat) {
      const m = $('fl-moves');
      const btns = (mv) => mv.map(([k, lab]) => '<button class="fl-mv" data-fx="' + k + '">' + lab + '</button>').join('');
      if (cat === 'ranged') {   // 兩排：炮擊系 / 光束系
        m.innerHTML = RANGED_ROWS.map(([, mv]) => '<div class="fl-mvgrp"><div class="fl-mvrow">' + btns(mv) + '</div></div>').join('');
      } else {
        m.innerHTML = btns(MOVES[cat]);
      }
      m.querySelectorAll('.fl-mv').forEach((b) => b.addEventListener('click', () => runMove(b.dataset.fx)));
    }
    document.querySelectorAll('.fl-tab').forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.fl-tab').forEach((x) => x.classList.remove('on'));
      t.classList.add('on'); renderMoves(t.dataset.cat);
    }));
    renderMoves('ranged');

    // 等級鈕：單選（亮藍=目前等級）
    $('fl-lv').querySelectorAll('.fl-lvb').forEach((b) => b.addEventListener('click', () => {
      $('fl-lv').querySelectorAll('.fl-lvb').forEach((x) => x.classList.remove('on'));
      b.classList.add('on'); lv = Number(b.dataset.lv);
    }));
    // 狀態鈕：0/1 切換（亮起=1）
    $('fl-aoe').addEventListener('click', () => { const on = $('fl-aoe').classList.toggle('on'); $('fl-aoe').textContent = on ? '全' : '單'; });
    $('fl-crit').addEventListener('click', () => $('fl-crit').classList.toggle('on'));
    $('fl-miss').addEventListener('click', () => $('fl-miss').classList.toggle('on'));
    $('fl-dir').addEventListener('click', () => { const on = $('fl-dir').classList.toggle('on'); atk = on ? 'foe' : 'my'; });   // 守=1 → 對方攻擊
  </script>
</body>
</html>
