---
// 招式實驗室 v2（純前端表演層測試，不影響正式戰鬥）
// 1機/3機切換、單招、大絕招(全射/全近/全閃/通用)、閃避；類別可展開收合；舞台固定頂端
---

<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#07090f" />
  <title>招式實驗室 · 普拉魂</title>
</head>
<body>
  <div class="fl-wrap">
    <div class="fl-stage" id="fl-stage">
      <div class="fl-stars"></div>
      <div class="fl-hd">
        <div class="side"><div class="fl-pname">我方</div><div class="fl-bar"><i></i></div></div>
        <div class="fl-round">VS</div>
        <div class="side"><div class="fl-pname" style="text-align:right">敵方</div><div class="fl-bar foe"><i></i></div></div>
      </div>
      <div class="fl-field" id="fl-field">
        <div class="fl-darken" id="fl-darken"></div>
        <div class="fl-u my-side" data-i="0" id="fl-my-0"><div class="fl-noimg t-my">🤖</div></div>
        <div class="fl-u my-side active" data-i="1" id="fl-my-1"><div class="fl-noimg t-my">🤖</div><span class="fl-name">我方</span></div>
        <div class="fl-u my-side" data-i="2" id="fl-my-2"><div class="fl-noimg t-my">🤖</div></div>
        <div class="fl-u foe-side" data-i="0" id="fl-foe-0"><div class="fl-noimg t-foe">👾</div></div>
        <div class="fl-u foe-side active" data-i="1" id="fl-foe-1"><div class="fl-noimg t-foe">👾</div><span class="fl-name">敵方</span></div>
        <div class="fl-u foe-side" data-i="2" id="fl-foe-2"><div class="fl-noimg t-foe">👾</div></div>
        <div class="fl-fx" id="fl-fx"></div>
        <div class="fl-banner" id="fl-banner"></div>
      </div>
    </div>

    <div class="fl-panel">
      <div class="fl-lv" id="fl-lv">
        <button class="fl-lvb on" data-lv="1">1</button>
        <button class="fl-lvb" data-lv="2">2</button>
        <button class="fl-lvb" data-lv="3">3</button>
        <button class="fl-lvb" data-lv="4">4</button>
        <button class="fl-lvb" data-lv="5">5</button>
      </div>
      <div class="fl-ctrl">
        <div class="fl-tabs">
          <button class="fl-tab on" data-cat="ranged">射</button>
          <button class="fl-tab" data-cat="melee">近</button>
          <button class="fl-tab" data-cat="evade">閃</button>
        </div>
        <div class="fl-states">
          <button class="fl-st" id="fl-aoe" title="單體 / 全體">單</button>
          <button class="fl-st" id="fl-crit" title="暴擊">暴</button>
          <button class="fl-st" id="fl-miss" title="MISS">M</button>
          <button class="fl-st" id="fl-dir" title="守=對方攻擊">守</button>
        </div>
      </div>
      <div class="fl-moves" id="fl-moves"></div>
    </div>
  </div>

  <style is:global>
    * { box-sizing: border-box; }
    body { margin: 0; background: #07090f; color: #e8ecf5; font-family: -apple-system, "Noto Sans TC", system-ui, sans-serif; -webkit-tap-highlight-color: transparent; }
    .fl-wrap { max-width: 560px; margin: 0 auto; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }

    /* 真實戰鬥同款場景（佔滿上方剩餘空間）*/
    .fl-stage { position: relative; flex: 1; min-height: 0; width: 100%; background: radial-gradient(circle at 50% 40%, #16223f 0%, #0a0e1c 62%, #060812 100%); overflow: hidden; }
    .fl-stars { position: absolute; inset: 0; background-image: radial-gradient(1.5px 1.5px at 20% 28%, #fff, transparent), radial-gradient(1.5px 1.5px at 72% 18%, #cde, transparent), radial-gradient(1px 1px at 42% 70%, #fff, transparent), radial-gradient(1px 1px at 86% 58%, #bcf, transparent), radial-gradient(1px 1px at 58% 88%, #fff, transparent), radial-gradient(1px 1px at 12% 80%, #ace, transparent); opacity: .5; }
    .fl-hd { position: absolute; top: 0; left: 0; right: 0; display: flex; align-items: center; gap: 10px; padding: 10px 14px; z-index: 6; }
    .fl-hd .side { flex: 1; }
    .fl-pname { font-size: 12px; font-weight: 700; color: #cdd7ee; margin-bottom: 5px; }
    .fl-bar { height: 13px; background: rgba(0,0,0,.45); border-radius: 999px; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(255,255,255,.1); }
    .fl-bar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, #36d97b, #26b765); }
    .fl-bar.foe i { background: linear-gradient(90deg, #e84b4b, #ff6b6b); }
    .fl-round { width: 40px; height: 40px; border-radius: 50%; border: 2px solid #4a5a85; background: rgba(10,14,28,.7); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; color: #cdd7ee; flex-shrink: 0; }

    .fl-field { position: absolute; inset: 0; z-index: 1; }
    .fl-field.fl-shake { animation: fl-shake .3s; }
    @keyframes fl-shake { 0%,100%{transform:translateX(0);} 20%{transform:translateX(-7px);} 40%{transform:translateX(7px);} 60%{transform:translateX(-5px);} 80%{transform:translateX(5px);} }

    .fl-u { position: absolute; width: 24%; max-width: 96px; aspect-ratio: 3/4; border-radius: 10px; overflow: hidden; border: 2px solid #46557c; background: #141c34; filter: brightness(.6); transition: top .3s cubic-bezier(.3,1.3,.5,1), left .3s, right .3s, transform .25s, opacity .2s, filter .3s; z-index: 2; animation: fl-float 3.4s ease-in-out infinite; }
    .fl-u.active { filter: brightness(1); box-shadow: 0 0 0 2px rgba(120,170,255,.6), 0 6px 22px rgba(0,0,0,.5); z-index: 5; }
    @keyframes fl-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
    #fl-my-0 { top: 19%; left: 3%; animation-delay: -.5s; } #fl-my-1 { top: 40%; left: 13%; animation-delay: -1.7s; } #fl-my-2 { top: 61%; left: 3%; animation-delay: -1.2s; }
    #fl-foe-0 { top: 19%; right: 3%; animation-delay: -2.1s; } #fl-foe-1 { top: 40%; right: 13%; animation-delay: -.9s; } #fl-foe-2 { top: 61%; right: 3%; animation-delay: -1.5s; }

    .fl-noimg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 30px; }
    .fl-noimg.t-my { background: #1c3a66; } .fl-noimg.t-foe { background: #5a2a1c; }
    .fl-name { position: absolute; left: 0; right: 0; bottom: 0; font-size: 9px; text-align: center; background: rgba(0,0,0,.6); padding: 1px; }

    .fl-u.fl-hit { animation: fl-hit .42s; }
    @keyframes fl-hit { 30%{ transform: translateX(var(--rec,10px)) rotate(3deg); filter: brightness(1) saturate(2.5) sepia(.6) hue-rotate(-30deg);} }
    .fl-u.fl-hop { animation: fl-hop .44s ease; }
    @keyframes fl-hop { 35%{ transform: translate(var(--hx,0), 30px);} 62%{ transform: translate(var(--hx,0), 30px);} }

    .fl-darken { position: absolute; inset: 0; background: #000; opacity: 0; transition: opacity .25s; z-index: 3; pointer-events: none; }
    .fl-darken.on { opacity: .55; }
    .fl-banner { position: absolute; left: 0; right: 0; top: 42%; text-align: center; font-size: 22px; font-weight: 900; color: #ffd23d; text-shadow: 0 2px 12px #000; opacity: 0; transform: scale(.6); transition: opacity .2s, transform .2s; z-index: 9; pointer-events: none; }
    .fl-banner.on { opacity: 1; transform: scale(1); }

    .fl-fx { position: absolute; inset: 0; pointer-events: none; z-index: 12; }
    .fl-fxb { position: absolute; inset: 0; pointer-events: none; z-index: 4; }   /* 卡片後方特效層(子彈/子機用) */
    .fl-ghost { position: absolute; aspect-ratio: 3/4; border-radius: 10px; overflow: hidden; border: 2px solid #46557c; pointer-events: none; filter: brightness(.8) saturate(.6); z-index: 1; }

    .fl-dmg { position: absolute; font-size: 22px; font-weight: 900; color: #fff; text-shadow: 0 2px 6px #000; transform: translate(-50%,-50%); animation: fl-pop .85s ease-out forwards; white-space: nowrap; }
    .fl-dmg.crit { font-size: 30px; color: #ffd23d; } .fl-dmg.miss { color: #cfcfcf; font-size: 18px; }
    @keyframes fl-pop { 0%{opacity:0;transform:translate(-50%,-20%) scale(.6);} 25%{opacity:1;transform:translate(-50%,-80%) scale(1.1);} 100%{opacity:0;transform:translate(-50%,-200%) scale(1);} }

    .fl-ring { position: absolute; width: 52px; height: 52px; border: 3px solid #fff; border-radius: 50%; opacity: .95; transform: translate(-50%,-50%) scale(.2); animation: fl-ring .62s ease-out forwards; }
    @keyframes fl-ring { to { transform: translate(-50%,-50%) scale(var(--rs,2)); opacity: 0; } }
    .fl-flash { position: absolute; width: 80px; height: 80px; border-radius: 50%; transform: translate(-50%,-50%) scale(.4); opacity: .9; background: radial-gradient(circle,#fff,transparent 68%); animation: fl-flashk .32s ease-out forwards; }
    .fl-flash.big { width: 118px; height: 118px; }
    .fl-flash.huge { width: 180px; height: 180px; }
    .fl-smoke { position: absolute; border-radius: 50%; background: radial-gradient(circle, rgba(214,218,228,.85), rgba(190,194,205,.4) 55%, transparent 72%); }
    /* 電漿纏繞（光束上的電弧）*/
    .fl-laser u { display: block; position: absolute; left: 0; top: 50%; width: 100%; height: 70%; transform: translateY(-50%); background: repeating-linear-gradient(90deg, transparent 0 5px, rgba(255,255,255,.9) 5px 7px, transparent 7px 13px); mix-blend-mode: screen; animation: fl-crackle .16s linear infinite; }
    @keyframes fl-crackle { to { background-position: 13px 0; } }
    .fl-spark { position: absolute; width: 6px; height: 6px; border-radius: 50%; transform: translate(-50%,-50%); animation: fl-sparkk .22s ease-out forwards; }
    @keyframes fl-sparkk { 0%{ opacity:1; transform: translate(-50%,-50%) scale(1.4);} 100%{ opacity:0; transform: translate(-50%,-50%) scale(.3);} }
    /* 命中爆閃（鏡頭光斑）*/
    .fl-flare { position: absolute; width: 78px; height: 78px; transform: translate(-50%,-50%); background: radial-gradient(circle, #fff 8%, transparent 52%); animation: fl-flarek .42s ease-out forwards; }
    .fl-flare::before, .fl-flare::after { content: ''; position: absolute; left: 50%; top: 50%; background: currentColor; box-shadow: 0 0 10px currentColor; }
    .fl-flare::before { width: 100%; height: 3px; transform: translate(-50%,-50%); }
    .fl-flare::after { height: 100%; width: 3px; transform: translate(-50%,-50%); }
    @keyframes fl-flarek { 0%{ opacity:0; transform: translate(-50%,-50%) scale(.3);} 30%{ opacity:1; transform: translate(-50%,-50%) scale(1);} 100%{ opacity:0; transform: translate(-50%,-50%) scale(1.25);} }
    /* 灼燒焦痕 */
    .fl-scorch { position: absolute; width: 30px; height: 30px; border-radius: 50%; transform: translate(-50%,-50%); background: radial-gradient(circle, rgba(40,20,12,.85), rgba(90,45,22,.4) 60%, transparent); animation: fl-scorchk .72s ease-out forwards; }
    @keyframes fl-scorchk { 0%{ opacity:.9; transform: translate(-50%,-50%) scale(.6);} 30%{ transform: translate(-50%,-50%) scale(1);} 100%{ opacity:0; transform: translate(-50%,-50%) scale(1.05);} }
    /* 稜鏡分光 */
    .fl-prism { position: absolute; height: 4px; transform-origin: left center; border-radius: 4px; }
    .fl-prism i { display: block; width: 100%; height: 100%; border-radius: 4px; background: inherit; box-shadow: 0 0 8px currentColor; transform-origin: left; animation: fl-prismk .45s ease-out forwards; }
    @keyframes fl-prismk { 0%{ transform: scaleX(0); opacity: .4;} 40%{ transform: scaleX(1); opacity: 1;} 100%{ transform: scaleX(1); opacity: 0;} }
    @keyframes fl-flashk { to { transform: translate(-50%,-50%) scale(1.5); opacity: 0; } }
    .fl-redtint { filter: brightness(1.1) saturate(2.2) sepia(.45) hue-rotate(-25deg); }
    .fl-particle { position: absolute; width: 7px; height: 7px; border-radius: 50%; transform: translate(-50%,-50%); }

    .fl-laser { position: absolute; height: 6px; transform-origin: left center; }
    .fl-laser.big { height: 16px; } .fl-laser.huge { height: 30px; }
    .fl-laser i { display: block; width: 100%; height: 100%; border-radius: 6px; transform-origin: left center; animation: fl-beam .5s ease-out forwards; }
    .fl-laser.c-my i { background: linear-gradient(90deg,#9fe8ff,#2f9bff); box-shadow: 0 0 12px #2f9bff; }
    .fl-laser.c-foe i { background: linear-gradient(90deg,#ffd0d0,#ff4d4d); box-shadow: 0 0 12px #ff4d4d; }
    .fl-laser.weak { height: 3px; opacity: .4; } .fl-laser.weak i { box-shadow: none; }
    @keyframes fl-beam { 0%{transform:scaleX(0);opacity:.5;} 45%{transform:scaleX(1);opacity:1;} 100%{transform:scaleX(1);opacity:0;} }

    .fl-ball { position: absolute; width: 18px; height: 18px; border-radius: 50%; transform: translate(-50%,-50%); }
    .fl-ball.big { width: 28px; height: 28px; }
    .fl-ball.c-my { background: radial-gradient(circle,#dff4ff,#2f9bff); box-shadow: 0 0 16px #2f9bff; }
    .fl-ball.c-foe { background: radial-gradient(circle,#ffe0e0,#ff4d4d); box-shadow: 0 0 16px #ff4d4d; }
    .fl-bolt { position: absolute; width: 12px; height: 12px; border-radius: 50%; transform: translate(-50%,-50%); background: radial-gradient(circle,#fff,#ffd24d); box-shadow: 0 0 8px #ffd24d; }
    .fl-bolt.big { width: 18px; height: 18px; box-shadow: 0 0 12px #ffd24d; }
    .fl-bolt.sm { width: 8px; height: 8px; box-shadow: 0 0 6px #ffd24d; }
    .fl-muzzle { position: absolute; width: 26px; height: 26px; border-radius: 50%; transform: translate(-50%,-50%) scale(.5); background: radial-gradient(circle,#fff,#ffd24d 50%,transparent 72%); opacity: .9; animation: fl-muz .25s ease-out forwards; }
    .fl-muzzle.big { width: 42px; height: 42px; }
    @keyframes fl-muz { to { transform: translate(-50%,-50%) scale(1.4); opacity: 0; } }

    .fl-charge { position: absolute; width: 24px; height: 24px; border-radius: 50%; transform: translate(-50%,-50%); animation: fl-charge .4s ease-in forwards; }
    .fl-charge.c-my { background: radial-gradient(circle,#dff4ff,rgba(47,155,255,.15)); box-shadow: 0 0 20px #2f9bff; }
    .fl-charge.c-foe { background: radial-gradient(circle,#ffe0e0,rgba(255,77,77,.15)); box-shadow: 0 0 20px #ff4d4d; }
    @keyframes fl-charge { 0%{transform:translate(-50%,-50%) scale(.3);opacity:.3;} 100%{transform:translate(-50%,-50%) scale(2.4);opacity:1;} }
    .fl-cring { position: absolute; width: 42px; height: 42px; border: 3px solid #fff; border-radius: 50%; transform: translate(-50%,-50%); box-shadow: 0 0 10px rgba(255,255,255,.5); }
    .fl-cring.big { width: 56px; height: 56px; }
    .fl-ering { position: absolute; width: 40px; height: 40px; border: 3px solid #fff; border-radius: 50%; transform: translate(-50%,-50%); box-shadow: 0 0 10px rgba(255,255,255,.45); }
    .fl-ap { position: absolute; width: 26px; height: 64px; border: 3px solid #3aa0ff; border-radius: 50%; transform: translate(-50%,-50%); box-shadow: 0 0 14px currentColor; color: #3aa0ff; animation: fl-ap .55s ease-out forwards; }
    .fl-ap::before { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 12px; border-radius: 50%; background: #fff; transform: translate(-50%,-50%); box-shadow: 0 0 10px #fff; }
    .fl-ap.big { width: 40px; height: 96px; }
    .fl-ap.sm { width: 13px; height: 32px; border-width: 2px; }
    .fl-ap.sm::before { width: 6px; height: 6px; }
    @keyframes fl-ap { 0%{opacity:.3; transform:translate(-50%,-50%) rotate(var(--apang,0deg)) scale(.25);} 42%{opacity:1; transform:translate(-50%,-50%) rotate(var(--apang,0deg)) scale(1);} 100%{opacity:0; transform:translate(-50%,-50%) rotate(var(--apang,0deg)) scale(1);} }

    .fl-missile { position: absolute; left: 0; top: 0; width: 16px; height: 7px; border-radius: 4px; background: linear-gradient(90deg,#ffd24d,#ff7a1f); box-shadow: 0 0 10px #ff9a3d; offset-rotate: auto; }
    .fl-bit { position: absolute; width: 22px; height: 16px; transform: translate(-50%,-50%); background: linear-gradient(90deg,#5bc8ff,#eafaff); box-shadow: 0 0 14px #6fd3ff; clip-path: polygon(100% 50%, 0 0, 0 100%); }
    .fl-bit.foe { background: linear-gradient(90deg,#ff7a7a,#ffeaea); box-shadow: 0 0 14px #ff7a7a; }

    .fl-sonic { position: absolute; width: 50px; height: 76px; border: 5px solid transparent; border-radius: 50%; transform: translate(-50%,-50%); filter: drop-shadow(0 0 5px #fff); }
    .fl-sonic.r.c-my { border-right-color: #7fd0ff; } .fl-sonic.r.c-foe { border-right-color: #ff8a8a; }
    .fl-sonic.l.c-my { border-left-color: #7fd0ff; } .fl-sonic.l.c-foe { border-left-color: #ff8a8a; }

    .fl-cross { position: absolute; width: 46px; height: 46px; transform: translate(-50%,-50%); border: 2px solid #ff5a5a; border-radius: 50%; animation: fl-crossk .5s ease-out forwards; }
    .fl-cross::before, .fl-cross::after { content: ''; position: absolute; background: #ff5a5a; }
    .fl-cross::before { left: 50%; top: -8px; bottom: -8px; width: 2px; transform: translateX(-50%); }
    .fl-cross::after { top: 50%; left: -8px; right: -8px; height: 2px; transform: translateY(-50%); }
    @keyframes fl-crossk { 0%{opacity:0;transform:translate(-50%,-50%) scale(1.7);} 40%{opacity:1;transform:translate(-50%,-50%) scale(1);} 100%{opacity:.5;} }

    .fl-slash { position: absolute; width: 122px; height: 10px; transform: translate(-50%,-50%); animation: fl-slashk .42s ease-out forwards; }
    .fl-slash.big { width: 162px; height: 14px; }
    .fl-slash::before, .fl-slash::after { content: ''; position: absolute; inset: 0; border-radius: 12px; background: linear-gradient(90deg,transparent 6%,#fff 50%,transparent 94%); filter: drop-shadow(0 0 9px #fff) drop-shadow(0 0 18px #9bdcff); }
    .fl-slash::after { transform: rotate(76deg); }
    @keyframes fl-slashk { 0%{opacity:0;transform:translate(-50%,-50%) rotate(-46deg) scale(.25);} 24%{opacity:1;transform:translate(-50%,-50%) rotate(-34deg) scale(1.35);} 100%{opacity:0;transform:translate(-50%,-50%) rotate(-24deg) scale(1.05);} }

    .fl-arc { position: absolute; }
    .fl-arc path { fill: none; stroke: #fff; stroke-width: 7; stroke-linecap: round; filter: drop-shadow(0 0 6px #9bdcff) drop-shadow(0 0 12px #fff); stroke-dasharray: 210; stroke-dashoffset: 210; animation: fl-draw .45s ease-out forwards; }
    @keyframes fl-draw { 0%{stroke-dashoffset:210;opacity:1;} 55%{stroke-dashoffset:0;opacity:1;} 100%{stroke-dashoffset:0;opacity:0;} }

    .fl-thrust { position: absolute; height: 6px; transform-origin: left center; }
    .fl-thrust.big { height: 10px; }
    .fl-thrust i { display: block; width: 100%; height: 100%; border-radius: 6px; background: linear-gradient(90deg,transparent,#fff 80%,#fff); box-shadow: 0 0 10px #fff; transform-origin: left; animation: fl-thrustk .35s ease-out forwards; }
    @keyframes fl-thrustk { 0%{transform:scaleX(.15);opacity:0;} 45%{transform:scaleX(1);opacity:1;} 100%{transform:scaleX(1);opacity:0;} }

    .fl-spin { position: absolute; width: 92px; height: 92px; border-radius: 50%; transform: translate(-50%,-50%); background: conic-gradient(from 0deg, transparent, #fff, transparent 55%); -webkit-mask: radial-gradient(transparent 54%, #000 56%); mask: radial-gradient(transparent 54%, #000 56%); animation: fl-spink .5s ease-out forwards; }
    @keyframes fl-spink { 0%{opacity:0;transform:translate(-50%,-50%) rotate(0) scale(.5);} 40%{opacity:1;} 100%{opacity:0;transform:translate(-50%,-50%) rotate(330deg) scale(1.25);} }

    /* 底部控制面板（固定，不出框）*/
    .fl-panel { flex-shrink: 0; background: #0b0f1c; border-top: 1px solid #1c2748; padding: 8px 10px calc(8px + env(safe-area-inset-bottom)); }
    .fl-lv { display: flex; gap: 6px; justify-content: flex-end; margin-bottom: 8px; }
    .fl-lvb { width: 34px; height: 30px; border-radius: 9px; background: #141c34; border: 1px solid #2c3a5e; color: #8294b8; font-size: 14px; font-weight: 800; cursor: pointer; }
    .fl-lvb.on { background: linear-gradient(135deg, #3b82f6, #1e50e5); border-color: #5b86ff; color: #fff; }
    .fl-ctrl { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .fl-tabs { display: flex; gap: 6px; }
    .fl-tab { width: 40px; height: 34px; border-radius: 9px; background: #141c34; border: 1px solid #2c3a5e; color: #cdd7ee; font-size: 16px; font-weight: 800; cursor: pointer; }
    .fl-tab.on { background: linear-gradient(135deg, #3b82f6, #1e50e5); border-color: #5b86ff; color: #fff; }
    .fl-states { display: flex; gap: 6px; margin-left: auto; }
    .fl-st { width: 34px; height: 34px; border-radius: 9px; background: #141c34; border: 1px solid #2c3a5e; color: #8294b8; font-size: 15px; font-weight: 800; cursor: pointer; }
    .fl-st.on { background: #e0a93b; border-color: #ffd27a; color: #1a1205; }
    #fl-aoe.on { background: #2e9e6b; border-color: #6fe0a8; color: #06210f; }
    #fl-dir.on { background: #c0453b; border-color: #ff8a7a; color: #fff; }
    .fl-moves { display: flex; flex-wrap: wrap; gap: 6px; }
    .fl-mvgrp { width: 100%; }
    .fl-mvgrp + .fl-mvgrp { margin-top: 8px; }
    .fl-mvlab { font-size: 10px; color: #6b7a9c; letter-spacing: 2px; margin: 0 0 4px 2px; }
    .fl-mvrow { display: flex; flex-wrap: wrap; gap: 6px; }
    .fl-mv { flex: 1 1 calc(20% - 6px); min-width: 52px; height: 42px; border-radius: 9px; background: #141c34; color: #e8ecf5; border: 1px solid #2c3a5e; font-size: 14px; font-weight: 700; cursor: pointer; }
