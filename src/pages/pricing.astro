---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const tiers = [
  {
    key: 'free', name: '免費', price: 'NT$0', period: '',
    desc: '入坑玩家先用著',
    feats: ['車庫 5 盒', '拍盒辨識 3 次/月', '找便宜・比價全開', '願望清單'],
    cta: '目前方案', highlight: false,
  },
  {
    key: 'premium', name: 'Premium', price: 'NT$99', period: '/月',
    desc: '月買 1-3 盒的中度玩家',
    feats: ['車庫 30 盒', '拍盒辨識 30 次/月', '降價警報', '找便宜・比價全開', '願望清單'],
    cta: '即將推出', highlight: true,
  },
  {
    key: 'pro', name: 'Pro', price: 'NT$249', period: '/月',
    desc: '每週逛模型店的重度玩家',
    feats: ['車庫 100 盒', '拍盒辨識 100 次/月', '降價警報', '點數可累積 3 月', '優先客服'],
    cta: '即將推出', highlight: false,
  },
];
---
<Layout title="方案 · 普拉魂" hideHeaderSearch={true}>
  <main class="pr">
    <Breadcrumb items={[{ label: '方案' }]} />
    <header class="pr-head">
      <h1 class="pr-title">選你的方案</h1>
      <p class="pr-sub">找便宜、比價永遠免費。升級拿更大車庫與更多 AI 拍盒。</p>
    </header>

    <div class="pr-grid">
      {tiers.map((t) => (
        <div class={`pr-card${t.highlight ? ' pr-card--hot' : ''}`}>
          {t.highlight && <div class="pr-badge">最熱門</div>}
          <div class="pr-name">{t.name}</div>
          <div class="pr-price">{t.price}<span class="pr-period">{t.period}</span></div>
          <div class="pr-desc">{t.desc}</div>
          <ul class="pr-feats">
            {t.feats.map((f) => <li>✓ {f}</li>)}
          </ul>
          <button class={`pr-cta${t.highlight ? ' pr-cta--hot' : ''}`} data-key={t.key} disabled={t.cta === '即將推出'}>{t.cta}</button>
        </div>
      ))}
    </div>

    <p class="pr-note">付費功能開發中（LINE Pay / 綠界即將上線）。帳單會以「雲端儲存空間進階方案」名義顯示。</p>
  </main>
</Layout>

<style>
  .pr { max-width: 980px; margin: 0 auto; padding: 28px 16px 80px; }
  .pr-head { text-align: center; margin-bottom: 28px; }
  .pr-title { font-size: clamp(24px, 4vw, 32px); font-weight: 800; margin: 0 0 8px; color: var(--color-text); }
  .pr-sub { color: var(--color-text-secondary); margin: 0; }
  .pr-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .pr-grid { grid-template-columns: repeat(3, 1fr); align-items: start; } }
  .pr-card {
    position: relative; background: var(--color-card); border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius); padding: 24px 20px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column;
  }
  .pr-card--hot { border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-light), var(--shadow); }
  .pr-badge { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: var(--color-primary); color: #fff; font-size: 12px; font-weight: 700; padding: 3px 12px; border-radius: 999px; }
  .pr-name { font-size: 16px; font-weight: 700; color: var(--color-text); }
  .pr-price { font-size: 32px; font-weight: 800; color: var(--color-text); margin: 6px 0 2px; }
  .pr-period { font-size: 14px; font-weight: 500; color: var(--color-text-secondary); }
  .pr-desc { font-size: 13px; color: var(--color-text-secondary); margin-bottom: 16px; }
  .pr-feats { list-style: none; padding: 0; margin: 0 0 20px; display: flex; flex-direction: column; gap: 9px; font-size: 14px; color: var(--color-text); }
  .pr-feats li { color: var(--color-text); }
  .pr-cta { margin-top: auto; padding: 11px; border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--color-card); color: var(--color-text); font-weight: 700; cursor: pointer; font-family: inherit; }
  .pr-cta--hot { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
  .pr-cta:disabled { opacity: 0.55; cursor: default; }
  .pr-note { text-align: center; font-size: 12.5px; color: var(--color-text-secondary); margin-top: 24px; line-height: 1.7; }
</style>

<script>
  document.querySelectorAll('.pr-cta:not([disabled])').forEach((b) => {
    b.addEventListener('click', () => { window.location.href = '/garage'; });
  });
</script>
