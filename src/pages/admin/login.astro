---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="管理員登入 · 普拉魂" noIndex={true}>
  <main class="min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <div class="text-5xl mb-3">🤖</div>
        <h1 class="text-2xl font-bold">普拉魂管理後台</h1>
        <p class="text-sm text-white/50 mt-1">PuraSoul Admin</p>
      </div>

      <form id="login-form" class="space-y-4 bg-white/5 rounded-2xl p-6 backdrop-blur">
        <div>
          <label class="block text-sm text-white/70 mb-2" for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="fightmon@gmail.com"
            class="w-full px-4 py-3 rounded-lg bg-white/10 text-white placeholder-white/30 border border-white/10 focus:border-white/40 focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-sm text-white/70 mb-2" for="password">密碼</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full px-4 py-3 rounded-lg bg-white/10 text-white placeholder-white/30 border border-white/10 focus:border-white/40 focus:outline-none"
          />
        </div>

        <div id="error-msg" class="hidden text-sm text-red-400 px-1"></div>

        <button
          id="submit-btn"
          type="submit"
          class="w-full bg-white text-[#0A1428] font-semibold py-3 rounded-lg hover:bg-white/90 transition disabled:opacity-50 disabled:cursor-not-allowed min-h-[44px]"
        >
          登入
        </button>
      </form>

      <p class="text-center text-xs text-white/30 mt-6">
        普拉魂 v0.1 · 僅授權人員可登入
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const errBox = document.getElementById('error-msg') as HTMLDivElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.classList.add('hidden');
      btn.disabled = true;
      btn.textContent = '登入中…';

      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();

        if (!res.ok || !data.ok) {
          errBox.textContent = data.message || '登入失敗';
          errBox.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = '登入';
          return;
        }

        // 成功 → redirect
        window.location.href = data.redirect || '/admin/listings';
      } catch (err) {
        errBox.textContent = '網路錯誤，請稍後再試';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = '登入';
      }
    });
  </script>
</Layout>
