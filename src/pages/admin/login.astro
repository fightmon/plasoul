---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="管理員登入 · 普拉魂" noIndex={true}>
  <main class="min-h-screen flex items-center justify-center px-5 py-10">
    <div class="w-full max-w-sm">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="text-6xl mb-3 select-none" aria-hidden="true">🤖</div>
        <h1 class="text-2xl font-bold tracking-wide">普拉魂管理後台</h1>
        <p class="text-sm text-white/50 mt-1 tracking-widest">PuraSoul Admin</p>
      </div>

      <!-- Form card -->
      <form id="login-form" class="space-y-5 bg-white/[0.04] border border-white/10 rounded-2xl p-6 backdrop-blur shadow-2xl">
        <!-- Email -->
        <label class="block">
          <span class="text-sm text-white/70 mb-2 block font-medium">Email</span>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="hello@plasoul.com"
            class="w-full px-4 py-3 rounded-xl bg-white/5 text-white placeholder-white/25 border border-white/10 focus:border-white/40 focus:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/20 transition"
          />
        </label>

        <!-- Password with eye toggle -->
        <label class="block">
          <span class="text-sm text-white/70 mb-2 block font-medium">密碼</span>
          <div class="relative">
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="w-full px-4 py-3 pr-12 rounded-xl bg-white/5 text-white placeholder-white/25 border border-white/10 focus:border-white/40 focus:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/20 transition"
            />
            <button
              type="button"
              id="toggle-pwd"
              aria-label="顯示／隱藏密碼"
              class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-white/40 hover:text-white/80 transition min-h-[36px] min-w-[36px] flex items-center justify-center rounded-lg hover:bg-white/5"
            >
              <!-- Eye-open SVG (default) -->
              <svg id="icon-eye" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <!-- Eye-off SVG (hidden by default) -->
              <svg id="icon-eye-off" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </label>

        <!-- Error message -->
        <div id="error-msg" class="hidden items-center gap-2 text-sm text-red-300 bg-red-500/10 border border-red-500/20 rounded-lg px-3 py-2">
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span id="error-text"></span>
        </div>

        <!-- Submit button -->
        <button
          id="submit-btn"
          type="submit"
          class="w-full bg-gradient-to-r from-white to-white/90 text-[#0A1428] font-bold py-3.5 rounded-xl shadow-lg hover:shadow-xl hover:from-white hover:to-white active:scale-[0.98] transition-all disabled:opacity-50 disabled:cursor-not-allowed min-h-[48px] flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          <span id="btn-label">登入</span>
        </button>
      </form>

      <p class="text-center text-xs text-white/30 mt-6 tracking-wide">
        普拉魂 v0.1 · 僅授權人員可登入
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnLabel = document.getElementById('btn-label') as HTMLSpanElement;
    const errBox = document.getElementById('error-msg') as HTMLDivElement;
    const errText = document.getElementById('error-text') as HTMLSpanElement;

    // Password show/hide toggle
    const pwdInput = document.getElementById('password') as HTMLInputElement;
    const togglePwd = document.getElementById('toggle-pwd') as HTMLButtonElement;
    const iconEye = document.getElementById('icon-eye') as HTMLElement;
    const iconEyeOff = document.getElementById('icon-eye-off') as HTMLElement;

    togglePwd.addEventListener('click', () => {
      const showing = pwdInput.type === 'text';
      pwdInput.type = showing ? 'password' : 'text';
      iconEye.classList.toggle('hidden', !showing);
      iconEyeOff.classList.toggle('hidden', showing);
    });

    // Submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.classList.add('hidden');
      errBox.classList.remove('flex');
      btn.disabled = true;
      btnLabel.textContent = '登入中…';

      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = pwdInput.value;

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();

        if (!res.ok || !data.ok) {
          errText.textContent = data.message || '登入失敗';
          errBox.classList.remove('hidden');
          errBox.classList.add('flex');
          btn.disabled = false;
          btnLabel.textContent = '登入';
          return;
        }

        // 成功 → redirect
        btnLabel.textContent = '登入成功，跳轉中…';
        window.location.href = data.redirect || '/admin/listings';
      } catch (err) {
        errText.textContent = '網路錯誤，請稍後再試';
        errBox.classList.remove('hidden');
        errBox.classList.add('flex');
        btn.disabled = false;
        btnLabel.textContent = '登入';
      }
    });
  </script>
</Layout>
