---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="會員管理 · 普拉魂 Admin" noIndex={true} bareLayout={true}>
  <div class="admin-shell">
    <header class="admin-topbar">
      <div class="topbar-brand">👥 會員管理</div>
      <div class="topbar-right">
        <a href="/admin" class="link-btn">🏠 後台首頁</a>
        <button id="logout-btn" class="link-btn">登出</button>
      </div>
    </header>

    <main class="admin-main">
      <h1 class="page-title">會員管理</h1>
      <p class="page-sub">沒接金流前，這裡就是人工開通付費方案的地方。</p>

      <div class="toolbar">
        <input id="q" class="search-input" type="search" placeholder="搜尋 email 或暱稱…" />
        <button id="search-btn" class="btn-primary">搜尋</button>
        <span class="count-text">共 <b id="total">—</b> 位</span>
        <button id="reload-btn" class="link-btn">↻</button>
      </div>

      <div id="status" class="status-text"></div>

      <div class="table-wrap">
        <table class="tbl">
          <thead>
            <tr>
              <th>會員</th><th>方案</th><th>登入</th><th>車庫</th><th>天梯</th><th>卡片</th><th>註冊</th><th>狀態</th><th></th>
            </tr>
          </thead>
          <tbody id="rows"><tr><td colspan="9" class="loading-text">載入中…</td></tr></tbody>
        </table>
      </div>
      <div class="pager">
        <button id="prev" class="link-btn" disabled>← 上一頁</button>
        <span id="page-info" class="muted"></span>
        <button id="next" class="link-btn" disabled>下一頁 →</button>
      </div>
    </main>

    <!-- 編輯 modal -->
    <div id="modal" class="modal" hidden>
      <div class="modal-box">
        <div class="modal-head">
          <div>
            <div class="modal-title" id="m-email"></div>
            <div class="modal-sub" id="m-meta"></div>
          </div>
          <button id="m-close" class="x-btn" title="關閉">×</button>
        </div>

        <label class="m-field">
          <span>方案 tier</span>
          <select id="m-tier" class="m-input">
            <option value="free">免費 free</option>
            <option value="premium">Premium</option>
            <option value="pro">Pro</option>
          </select>
        </label>

        <label class="m-field" id="m-expiry-field">
          <span>到期日（留空 = 無期限）</span>
          <input id="m-expiry" type="date" class="m-input" />
        </label>

        <label class="m-field">
          <span>角色 role</span>
          <select id="m-role" class="m-input">
            <option value="user">一般會員 user</option>
            <option value="admin">管理員 admin</option>
          </select>
        </label>

        <div id="m-status" class="status-text"></div>

        <div class="modal-actions">
          <button id="m-suspend" class="btn-danger">停權</button>
          <div class="spacer"></div>
          <button id="m-cancel" class="link-btn">取消</button>
          <button id="m-save" class="btn-primary">儲存</button>
        </div>

        <!-- 創鬥卡進度 -->
        <div class="m-sec">
          <div class="m-sec-h">🎴 創鬥卡進度</div>
          <div id="m-arena"><div class="muted">載入中…</div></div>
        </div>

        <!-- 卡片 -->
        <div class="m-sec">
          <div class="m-sec-h">🃏 卡片 <span class="muted" id="m-cards-n"></span></div>
          <div id="m-cards" class="m-cards"><div class="muted">載入中…</div></div>
        </div>

        <!-- 危險區 -->
        <div class="m-danger">
          <div><b>危險區</b><div class="muted">永久刪除：連同卡片、天梯、車庫一併清除，不可復原。</div></div>
          <button id="m-purge" class="btn-danger">永久刪除帳號</button>
        </div>
      </div>
    </div>

    <!-- 卡片編輯 modal -->
    <div id="card-modal" class="modal" hidden>
      <div class="modal-box">
        <div class="modal-head">
          <div class="modal-title" id="cm-title">編輯卡片</div>
          <button id="cm-close" class="x-btn" title="關閉">×</button>
        </div>
        <label class="m-field"><span>呼號名稱</span><input id="cm-name" class="m-input" /></label>
        <div class="cm-row">
          <label class="m-field"><span>天性</span><select id="cm-type" class="m-input"><option value="ranged">射擊</option><option value="melee">近身</option><option value="evade">閃躲</option></select></label>
          <label class="m-field"><span>稀有度</span><select id="cm-rarity" class="m-input"><option>N</option><option>R</option><option>SR</option><option>SSR</option></select></label>
        </div>
        <div class="cm-grid">
          <label class="m-field"><span>HP</span><input id="cm-hp" type="number" class="m-input" /></label>
          <label class="m-field"><span>攻</span><input id="cm-atk" type="number" class="m-input" /></label>
          <label class="m-field"><span>防</span><input id="cm-def" type="number" class="m-input" /></label>
          <label class="m-field"><span>機動</span><input id="cm-mob" type="number" class="m-input" /></label>
        </div>
        <div class="cm-hint" id="cm-pow"></div>
        <label class="m-field"><span>地形適性</span><input id="cm-terrain" class="m-input" /></label>
        <label class="m-field"><span>必殺名</span><input id="cm-special_name" class="m-input" /></label>
        <label class="m-field"><span>必殺描述</span><input id="cm-special_desc" class="m-input" /></label>
        <label class="m-field"><span>一句介紹</span><input id="cm-flavor" class="m-input" /></label>
        <label class="m-field"><span>語氣 tone_id（tones.json 的 key，留空=預設）</span><input id="cm-tone" class="m-input" placeholder="hot / caocao / cat_normal …" /></label>
        <label class="m-field"><span>招式 moves（逗號分隔，留空=全掛該天性）</span><input id="cm-moves" class="m-input" placeholder="laser,cannon … / slash,arc …" /></label>
        <div id="cm-status" class="status-text"></div>
        <div class="modal-actions">
          <div class="spacer"></div>
          <button id="cm-cancel" class="link-btn">取消</button>
          <button id="cm-save" class="btn-primary">儲存卡片</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .admin-shell { min-height: 100vh; background: var(--admin-bg); color: var(--admin-text); }
  .admin-topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px; background: rgba(0,0,0,0.3);
    border-bottom: 1px solid var(--admin-border); position: sticky; top: 0; z-index: 10; backdrop-filter: blur(8px);
  }
  .topbar-brand { font-weight: 700; letter-spacing: 0.05em; }
  .topbar-right { display: flex; align-items: center; gap: 14px; }
  .link-btn {
    background: transparent; border: none; color: var(--admin-text-dim);
    cursor: pointer; font-size: 13px; padding: 6px 10px; border-radius: 6px;
    text-decoration: none; transition: color 0.15s, background 0.15s;
  }
  .link-btn:hover:not(:disabled) { color: var(--admin-text); background: var(--admin-surface-2); }
  .link-btn:disabled { opacity: 0.4; cursor: default; }

  .admin-main { max-width: 1000px; margin: 0 auto; padding: 24px 16px 80px; }
  .page-title { font-size: 24px; font-weight: 700; margin: 8px 0 4px; }
  .page-sub { color: var(--admin-text-faint); font-size: 14px; margin: 0 0 18px; }

  .toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .search-input {
    flex: 1; min-width: 180px; padding: 9px 13px; font-size: 14px;
    background: var(--admin-surface-2); border: 1px solid var(--admin-border-2);
    border-radius: 8px; color: var(--admin-text); outline: none;
  }
  .search-input:focus { border-color: var(--admin-border-focus); }
  .count-text { font-size: 13px; color: var(--admin-text-dim); }
  .count-text b { color: var(--admin-text); font-size: 16px; }

  .btn-primary {
    padding: 9px 16px; font-size: 13px; font-weight: 700; cursor: pointer; color: #fff;
    background: var(--color-primary); border: none; border-radius: 8px; transition: background 0.15s;
  }
  .btn-primary:hover { background: var(--color-primary-dark); }
  .btn-danger {
    padding: 9px 14px; font-size: 13px; font-weight: 700; cursor: pointer; color: #fca5a5;
    background: transparent; border: 1px solid rgba(248,113,113,0.4); border-radius: 8px;
  }
  .btn-danger:hover { background: rgba(248,113,113,0.12); }

  .status-text { font-size: 13px; margin: 8px 0; min-height: 18px; }
  .status-text.success { color: #86efac; }
  .status-text.error { color: #fca5a5; }

  .table-wrap { overflow-x: auto; border: 1px solid var(--admin-border); border-radius: 12px; }
  .tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 720px; }
  .tbl thead th {
    text-align: left; padding: 11px 14px; font-size: 12px; font-weight: 600;
    color: var(--admin-text-faint); border-bottom: 1px solid var(--admin-border);
    background: var(--admin-surface); position: sticky; top: 0;
  }
  .tbl td { padding: 11px 14px; border-bottom: 1px solid var(--admin-border-2); vertical-align: middle; }
  .tbl tbody tr:hover { background: var(--admin-surface); }
  .tbl tbody tr:last-child td { border-bottom: none; }

  .u-email { font-weight: 600; }
  .u-name { font-size: 12px; color: var(--admin-text-faint); }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; }
  .badge-free { background: var(--admin-surface-2); color: var(--admin-text-dim); }
  .badge-premium { background: rgba(59,130,246,0.18); color: #93c5fd; }
  .badge-pro { background: rgba(234,179,8,0.18); color: #fcd34d; }
  .badge-admin { background: rgba(239,68,68,0.18); color: #fca5a5; margin-left: 5px; }
  .expiry { font-size: 11px; color: var(--admin-text-faint); display: block; margin-top: 3px; }
  .methods { display: flex; gap: 4px; flex-wrap: wrap; }
  .m-tag { font-size: 10px; padding: 2px 6px; border-radius: 5px; background: var(--admin-surface-2); color: var(--admin-text-dim); }
  .st-ok { color: #86efac; font-size: 12px; }
  .st-susp { color: #fca5a5; font-size: 12px; font-weight: 700; }
  .row-edit {
    padding: 6px 12px; font-size: 12px; font-weight: 700; cursor: pointer; color: var(--admin-text);
    background: var(--admin-surface-2); border: 1px solid var(--admin-border-2); border-radius: 7px;
  }
  .row-edit:hover { border-color: var(--admin-border-focus); }
  .muted { color: var(--admin-text-faint); font-size: 13px; }
  .loading-text { text-align: center; padding: 32px; color: var(--admin-text-faint); }
  .pager { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 16px; }

  /* modal */
  .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 50; padding: 16px; }
  .modal[hidden] { display: none; }
  .modal-box {
    width: 100%; max-width: 420px; background: var(--admin-surface);
    border: 1px solid var(--admin-border); border-radius: 16px; padding: 20px;
    max-height: 90vh; overflow-y: auto;
  }
  /* 會員 modal 擴充區 */
  .m-sec { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--admin-border); }
  .m-sec-h { font-size: 13px; font-weight: 700; margin-bottom: 10px; }
  .m-arena-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .m-arena-grid .m-field { margin-bottom: 0; }
  .m-arena-grid .m-input { padding: 7px 9px; font-size: 13px; }
  .m-cards { display: flex; flex-direction: column; gap: 7px; }
  .m-card { display: flex; align-items: center; gap: 9px; padding: 8px 10px; background: var(--admin-surface-2); border: 1px solid var(--admin-border-2); border-radius: 9px; }
  .m-card.dead { opacity: 0.5; }
  .m-card-thumb { width: 34px; height: 44px; border-radius: 5px; object-fit: cover; background: var(--admin-bg); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 16px; }
  .m-card-info { flex: 1; min-width: 0; }
  .m-card-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .m-card-sub { font-size: 11px; color: var(--admin-text-faint); margin-top: 2px; }
  .m-card-acts { display: flex; gap: 6px; flex-shrink: 0; }
  .m-mini { padding: 5px 9px; font-size: 12px; font-weight: 700; cursor: pointer; border-radius: 6px; background: var(--admin-surface); border: 1px solid var(--admin-border-2); color: var(--admin-text); }
  .m-mini.danger { color: #fca5a5; border-color: rgba(248,113,113,0.4); }
  .m-tag-t { display: inline-block; padding: 1px 6px; border-radius: 4px; font-size: 10px; font-weight: 700; margin-right: 4px; background: var(--admin-surface); }
  .m-danger { margin-top: 18px; padding: 12px 14px; border: 1px solid rgba(248,113,113,0.35); border-radius: 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: rgba(248,113,113,0.06); }
  .m-danger .muted { font-size: 11px; margin-top: 3px; }
  .cm-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .cm-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .cm-grid .m-field { margin-bottom: 8px; }
  .cm-hint { font-size: 11px; color: var(--admin-text-faint); margin: -2px 0 12px; }
  .modal-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px; }
  .modal-title { font-weight: 700; font-size: 16px; word-break: break-all; }
  .modal-sub { font-size: 12px; color: var(--admin-text-faint); margin-top: 3px; }
  .x-btn { background: transparent; border: none; color: var(--admin-text-dim); font-size: 22px; cursor: pointer; line-height: 1; }
  .m-field { display: flex; flex-direction: column; gap: 5px; font-size: 13px; color: var(--admin-text-dim); margin-bottom: 14px; }
  .m-input {
    padding: 9px 11px; font-size: 14px; background: var(--admin-surface-2);
    border: 1px solid var(--admin-border-2); border-radius: 8px; color: var(--admin-text); outline: none;
  }
  .m-input:focus { border-color: var(--admin-border-focus); }
  .modal-actions { display: flex; align-items: center; gap: 10px; margin-top: 18px; }
  .modal-actions .spacer { flex: 1; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id);
  const esc = (s: any) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  function applyScope(c: HTMLElement) {
    const attr = Array.from(c.attributes).map((a) => a.name).find((n) => n.startsWith('data-astro-cid'));
    if (attr) c.querySelectorAll('*').forEach((el) => el.setAttribute(attr, ''));
  }
  const fmtDate = (ms: number) => { const d = new Date(ms); const p = (n: number) => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`; };
  const tierLabel: Record<string, string> = { free: '免費', premium: 'Premium', pro: 'Pro' };

  const rowsEl = $('rows')!, statusEl = $('status')!, totalEl = $('total')!;
  const PAGE = 50;
  let offset = 0, total = 0, current: any[] = [];

  // auth gate
  (async () => {
    try { const me = await fetch('/api/admin/me', { credentials: 'include' }); if (!me.ok) { location.href = '/admin/login'; return; } }
    catch { location.href = '/admin/login'; return; }
    load();
  })();

  $('logout-btn')!.addEventListener('click', async () => { try { await fetch('/api/admin/logout', { method: 'POST' }); } catch {} location.href = '/admin/login'; });
  $('search-btn')!.addEventListener('click', () => { offset = 0; load(); });
  $('reload-btn')!.addEventListener('click', load);
  $('q')!.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { offset = 0; load(); } });
  $('prev')!.addEventListener('click', () => { if (offset > 0) { offset = Math.max(0, offset - PAGE); load(); } });
  $('next')!.addEventListener('click', () => { if (offset + PAGE < total) { offset += PAGE; load(); } });

  async function load() {
    rowsEl.innerHTML = '<tr><td colspan="9" class="loading-text">載入中…</td></tr>';
    const q = ($('q') as HTMLInputElement).value.trim();
    try {
      const res = await fetch(`/api/admin/users/list?q=${encodeURIComponent(q)}&limit=${PAGE}&offset=${offset}`, { credentials: 'include' });
      const d = await res.json();
      if (!d.ok) { rowsEl.innerHTML = '<tr><td colspan="9" class="loading-text">載入失敗</td></tr>'; return; }
      total = d.total; current = d.users;
      totalEl.textContent = total.toLocaleString();
      if (!d.users.length) { rowsEl.innerHTML = '<tr><td colspan="9" class="loading-text">查無會員</td></tr>'; }
      else {
        rowsEl.innerHTML = d.users.map((u: any, i: number) => {
          const m: string[] = [];
          if (u.methods.email) m.push('Email');
          if (u.methods.line) m.push('LINE');
          if (u.methods.google) m.push('Google');
          const expiry = u.tier !== 'free' && u.tier_expires_at ? `<span class="expiry">到期 ${fmtDate(u.tier_expires_at)}</span>` : '';
          return `<tr>
            <td><div class="u-email">${esc(u.email)}</div>${u.display_name ? `<div class="u-name">${esc(u.display_name)}</div>` : ''}</td>
            <td><span class="badge badge-${esc(u.tier)}">${tierLabel[u.tier] || esc(u.tier)}</span>${u.role === 'admin' ? '<span class="badge badge-admin">admin</span>' : ''}${expiry}</td>
            <td><div class="methods">${m.map((x) => `<span class="m-tag">${x}</span>`).join('') || '<span class="m-tag">—</span>'}</div></td>
            <td>${u.garage_count}</td>
            <td>${u.rank_score ? u.rank_score.toLocaleString() : '—'}</td>
            <td>${u.card_count || '—'}</td>
            <td>${fmtDate(u.created_at)}</td>
            <td>${u.suspended ? '<span class="st-susp">已停權</span>' : '<span class="st-ok">正常</span>'}</td>
            <td><button class="row-edit" data-i="${i}">編輯</button></td>
          </tr>`;
        }).join('');
        applyScope(rowsEl);
        rowsEl.querySelectorAll('.row-edit').forEach((b) => b.addEventListener('click', () => openModal(current[Number((b as HTMLElement).dataset.i)])));
      }
      const from = total ? offset + 1 : 0;
      $('page-info')!.textContent = `${from}–${Math.min(offset + PAGE, total)} / ${total}`;
      ($('prev') as HTMLButtonElement).disabled = offset === 0;
      ($('next') as HTMLButtonElement).disabled = offset + PAGE >= total;
    } catch { rowsEl.innerHTML = '<tr><td colspan="9" class="loading-text">網路錯誤</td></tr>'; }
  }

  // ---- modal ----
  let editing: any = null;       // list 的基本會員資料
  let detail: any = null;        // /detail 回傳（user/arena/cards）
  const modal = $('modal')!, mStatus = $('m-status')!;
  function openModal(u: any) {
    editing = u; detail = null;
    $('m-email')!.textContent = u.email;
    $('m-meta')!.textContent = `車庫 ${u.garage_count} 盒 · 註冊 ${fmtDate(u.created_at)}${u.suspended ? ' · 已停權' : ''}`;
    ($('m-tier') as HTMLSelectElement).value = u.tier;
    ($('m-role') as HTMLSelectElement).value = u.role;
    ($('m-expiry') as HTMLInputElement).value = u.tier_expires_at ? fmtDate(u.tier_expires_at) : '';
    ($('m-suspend') as HTMLButtonElement).textContent = u.suspended ? '復原帳號' : '停權';
    mStatus.textContent = ''; mStatus.className = 'status-text';
    $('m-arena')!.innerHTML = '<div class="muted">載入中…</div>';
    $('m-cards')!.innerHTML = '<div class="muted">載入中…</div>';
    $('m-cards-n')!.textContent = '';
    modal.removeAttribute('hidden');
    loadDetail(u.id);
  }
  function closeModal() { modal.setAttribute('hidden', ''); editing = null; detail = null; }
  $('m-close')!.addEventListener('click', closeModal);
  $('m-cancel')!.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  // ---- 載入完整資料：天梯 + 卡片 ----
  async function loadDetail(id: string) {
    try {
      const res = await fetch(`/api/admin/users/detail?id=${encodeURIComponent(id)}`, { credentials: 'include' });
      const d = await res.json();
      if (!d.ok) { $('m-arena')!.innerHTML = '<div class="muted">載入失敗</div>'; return; }
      detail = d; renderArena(d.arena); renderCards(d.cards);
    } catch { $('m-arena')!.innerHTML = '<div class="muted">網路錯誤</div>'; }
  }

  const AF: [string, string][] = [['rank_score', '天梯分'], ['best_rank', '最高分'], ['parts', '零件'], ['coins', '金幣'], ['wins', '勝'], ['losses', '敗']];
  function renderArena(a: any) {
    const v = a || { rank_score: 0, best_rank: 0, parts: 0, coins: 0, wins: 0, losses: 0 };
    $('m-arena')!.innerHTML = `<div class="m-arena-grid">${AF.map(([k, lab]) => `<label class="m-field"><span>${lab}</span><input id="ar-${k}" type="number" class="m-input" value="${v[k] || 0}"/></label>`).join('')}</div><div class="modal-actions" style="margin-top:12px"><div class="spacer"></div><button id="ar-save" class="m-mini">儲存進度</button></div>`;
    applyScope($('m-arena')!);
    $('ar-save')!.addEventListener('click', saveArena);
  }
  async function saveArena() {
    if (!editing) return;
    const body: any = { id: editing.id };
    AF.forEach(([k]) => { body[k] = Number(($(`ar-${k}`) as HTMLInputElement).value) || 0; });
    mStatus.textContent = '處理中…'; mStatus.className = 'status-text';
    try {
      const res = await fetch('/api/admin/users/arena-update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body) });
      const d = await res.json();
      if (!res.ok || !d.ok) { mStatus.textContent = '❌ ' + (d.message || '失敗'); mStatus.className = 'status-text error'; return; }
      mStatus.textContent = '✅ 創鬥卡進度已更新'; mStatus.className = 'status-text success';
    } catch { mStatus.textContent = '❌ 網路錯誤'; mStatus.className = 'status-text error'; }
  }

  const TLAB: Record<string, string> = { ranged: '射', melee: '近', evade: '閃' };
  function renderCards(cards: any[]) {
    $('m-cards-n')!.textContent = `共 ${cards.length}（${cards.filter((c) => !c.deleted).length} 有效）`;
    if (!cards.length) { $('m-cards')!.innerHTML = '<div class="muted">沒有卡片</div>'; return; }
    $('m-cards')!.innerHTML = cards.map((c, i) => `<div class="m-card ${c.deleted ? 'dead' : ''}">
      <div class="m-card-thumb">${c.photo_url ? `<img src="${esc(c.photo_url)}" style="width:100%;height:100%;object-fit:cover;border-radius:5px"/>` : '🤖'}</div>
      <div class="m-card-info"><div class="m-card-name"><span class="m-tag-t">${TLAB[c.type] || '?'}</span>${esc(c.name)}${c.deleted ? ' 🗑' : ''}</div>
      <div class="m-card-sub">${esc(c.rarity)} · 戰歷 ${c.wins}/${c.battles} · 戰力 ${c.hp + c.atk + c.def + c.mob}${c.tone_id ? ` · 語氣 ${esc(c.tone_id)}` : ''}</div></div>
      <div class="m-card-acts"><button class="m-mini" data-edit="${i}">編輯</button><button class="m-mini danger" data-del="${i}">${c.deleted ? '還原' : '刪除'}</button></div>
    </div>`).join('');
    applyScope($('m-cards')!);
    $('m-cards')!.querySelectorAll('[data-edit]').forEach((b) => b.addEventListener('click', () => openCard(detail.cards[Number((b as HTMLElement).dataset.edit)])));
    $('m-cards')!.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', () => delCard(detail.cards[Number((b as HTMLElement).dataset.del)])));
  }
  async function delCard(c: any) {
    const restore = !!c.deleted;
    if (!restore && !confirm(`確定刪除卡片「${c.name}」？（軟刪除，可再還原）`)) return;
    try {
      const res = await fetch('/api/admin/users/card-delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ card_id: c.id, restore }) });
      const d = await res.json();
      if (!res.ok || !d.ok) { alert(d.message || '失敗'); return; }
      if (editing) loadDetail(editing.id);
    } catch { alert('網路錯誤'); }
  }

  // ---- 卡片編輯器 ----
  let editingCard: any = null;
  const cardModal = $('card-modal')!, cmStatus = $('cm-status')!;
  const CM_TEXT = ['name', 'terrain', 'special_name', 'special_desc', 'flavor'];
  const CM_NUM = ['hp', 'atk', 'def', 'mob'];
  function cmPow() { const p = CM_NUM.reduce((s, k) => s + (Number(($(`cm-${k}`) as HTMLInputElement).value) || 0), 0); $('cm-pow')!.textContent = `總戰力 ${p}（標準約 800；改數值會破壞平衡）`; }
  function openCard(c: any) {
    editingCard = c;
    $('cm-title')!.textContent = `編輯卡片：${c.name}`;
    CM_TEXT.forEach((k) => (($(`cm-${k}`) as HTMLInputElement).value = c[k] || ''));
    CM_NUM.forEach((k) => (($(`cm-${k}`) as HTMLInputElement).value = String(c[k] ?? 0)));
    ($('cm-type') as HTMLSelectElement).value = c.type;
    ($('cm-rarity') as HTMLSelectElement).value = c.rarity;
    ($('cm-tone') as HTMLInputElement).value = c.tone_id || '';
    let mvText = ''; if (c.moves) { try { const a = JSON.parse(c.moves); if (Array.isArray(a)) mvText = a.join(','); } catch {} }
    ($('cm-moves') as HTMLInputElement).value = mvText;
    cmStatus.textContent = ''; cmStatus.className = 'status-text'; cmPow();
    cardModal.removeAttribute('hidden');
  }
  function closeCard() { cardModal.setAttribute('hidden', ''); editingCard = null; }
  $('cm-close')!.addEventListener('click', closeCard);
  $('cm-cancel')!.addEventListener('click', closeCard);
  cardModal.addEventListener('click', (e) => { if (e.target === cardModal) closeCard(); });
  CM_NUM.forEach((k) => $(`cm-${k}`)!.addEventListener('input', cmPow));
  $('cm-save')!.addEventListener('click', async () => {
    if (!editingCard) return;
    const body: any = { card_id: editingCard.id };
    CM_TEXT.forEach((k) => (body[k] = ($(`cm-${k}`) as HTMLInputElement).value.trim()));
    CM_NUM.forEach((k) => (body[k] = Number(($(`cm-${k}`) as HTMLInputElement).value) || 0));
    body.type = ($('cm-type') as HTMLSelectElement).value;
    body.rarity = ($('cm-rarity') as HTMLSelectElement).value;
    body.tone_id = ($('cm-tone') as HTMLInputElement).value.trim() || null;
    const mv = ($('cm-moves') as HTMLInputElement).value.split(',').map((s) => s.trim()).filter(Boolean);
    body.moves = mv.length ? mv : null;
    cmStatus.textContent = '處理中…'; cmStatus.className = 'status-text';
    try {
      const res = await fetch('/api/admin/users/card-update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body) });
      const d = await res.json();
      if (!res.ok || !d.ok) { cmStatus.textContent = '❌ ' + (d.message || '失敗'); cmStatus.className = 'status-text error'; return; }
      closeCard(); if (editing) loadDetail(editing.id);
      statusEl.textContent = '✅ 卡片已更新'; statusEl.className = 'status-text success';
    } catch { cmStatus.textContent = '❌ 網路錯誤'; cmStatus.className = 'status-text error'; }
  });

  // ---- 永久刪除帳號 ----
  $('m-purge')!.addEventListener('click', async () => {
    if (!editing) return;
    if (detail?.user?.role === 'admin') { alert('對方是管理員，請先把角色降為一般會員再刪除。'); return; }
    const typed = prompt(`⚠️ 永久刪除「${editing.email}」？\n此動作不可復原，會一併清除其卡片、天梯、車庫資料。\n\n請輸入該會員 email 以確認：`);
    if (typed == null) return;
    if (typed.trim() !== editing.email) { alert('輸入與 email 不符，已取消。'); return; }
    mStatus.textContent = '刪除中…'; mStatus.className = 'status-text';
    try {
      const res = await fetch('/api/admin/users/purge', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ id: editing.id, confirm: typed.trim() }) });
      const d = await res.json();
      if (!res.ok || !d.ok) { mStatus.textContent = '❌ ' + (d.message || '失敗'); mStatus.className = 'status-text error'; return; }
      closeModal();
      statusEl.textContent = '✅ 已永久刪除該帳號'; statusEl.className = 'status-text success';
      load();
    } catch { mStatus.textContent = '❌ 網路錯誤'; mStatus.className = 'status-text error'; }
  });

  $('m-save')!.addEventListener('click', async () => {
    if (!editing) return;
    const tier = ($('m-tier') as HTMLSelectElement).value;
    const role = ($('m-role') as HTMLSelectElement).value;
    const expVal = ($('m-expiry') as HTMLInputElement).value;
    let tier_expires_at: number | null = null;
    if (tier !== 'free' && expVal) tier_expires_at = new Date(expVal + 'T23:59:59').getTime();
    const body: any = { id: editing.id, tier, role, tier_expires_at };
    await doUpdate(body, '已儲存');
  });

  $('m-suspend')!.addEventListener('click', async () => {
    if (!editing) return;
    const action = editing.suspended ? 'restore' : 'suspend';
    await doUpdate({ id: editing.id, action }, action === 'suspend' ? '已停權' : '已復原');
  });

  async function doUpdate(body: any, okMsg: string) {
    mStatus.textContent = '處理中…'; mStatus.className = 'status-text';
    try {
      const res = await fetch('/api/admin/users/update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify(body) });
      const d = await res.json();
      if (!res.ok || !d.ok) { mStatus.textContent = '❌ ' + (d.message || '失敗'); mStatus.className = 'status-text error'; return; }
      closeModal();
      statusEl.textContent = '✅ ' + okMsg; statusEl.className = 'status-text success';
      load();
    } catch { mStatus.textContent = '❌ 網路錯誤'; mStatus.className = 'status-text error'; }
  }
</script>
