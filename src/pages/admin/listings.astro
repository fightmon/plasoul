---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="新增 FB Listing · 普拉魂 Admin" noIndex={true}>
  <div class="admin-shell">
    <!-- Top bar -->
    <header class="admin-topbar">
      <div class="topbar-brand">🤖 普拉魂 Admin</div>
      <div class="topbar-right">
        <span id="admin-email" class="admin-email"></span>
        <button id="logout-btn" class="link-btn">登出</button>
      </div>
    </header>

    <main class="admin-main">
      <h1 class="page-title">新增 FB Listing</h1>
      <p class="page-sub">貼 FB 鋼彈交易貼文 → AI 解析 → 多選保存</p>

      <!-- Source info -->
      <section class="card">
        <h2 class="card-title">來源資訊（可選）</h2>
        <div class="grid-2">
          <label class="field">
            <span class="field-label">FB 貼文 URL</span>
            <input id="src-url" type="url" class="field-input" placeholder="https://www.facebook.com/groups/.../posts/..." />
          </label>
          <label class="field">
            <span class="field-label">社團名稱</span>
            <input id="src-group" type="text" class="field-input" placeholder="例：鋼彈交易市集" />
          </label>
        </div>
      </section>

      <!-- Text input -->
      <section class="card">
        <h2 class="card-title">FB 貼文文字 或 截圖（Ctrl+V 貼圖）</h2>
        <textarea
          id="text-input"
          class="textarea"
          rows="10"
          placeholder="貼上整篇 FB 貼文文字… 或直接 Ctrl+V 貼圖（截圖、商品照、FB貼文截圖都可）"
        ></textarea>

        <!-- Image preview area -->
        <div id="img-preview-wrap" class="img-preview-wrap" style="display:none">
          <div class="img-preview-list" id="img-preview-list"></div>
          <button id="img-clear-btn" class="link-btn" style="font-size:12px">清掉所有圖</button>
        </div>

        <div class="actions">
          <button id="parse-btn" class="primary-btn">🤖 AI 解析文字</button>
          <button id="parse-img-btn" class="primary-btn" style="display:none">🖼️ AI 解析圖片</button>
          <span id="parse-status" class="status-text"></span>
        </div>
      </section>

      <!-- Results -->
      <section id="results-card" class="card" style="display:none">
        <div class="results-head">
          <h2 class="card-title">
            找到 <span id="result-count" class="result-badge">0</span> 個 ·
            已選 <span id="save-count" class="result-badge">0</span>
          </h2>
          <div class="select-actions">
            <button id="select-all-btn" type="button" class="link-btn">全選</button>
            <button id="select-none-btn" type="button" class="link-btn">全不選</button>
          </div>
        </div>
        <div id="results-list" class="results-list"></div>
        <div class="actions">
          <button id="save-btn" class="primary-btn">💾 保存選取</button>
          <button id="reset-btn" class="link-btn">清空</button>
          <span id="save-status" class="status-text"></span>
        </div>
      </section>

      <!-- Recent saves (本次 session) -->
      <section id="recent-card" class="card" style="display:none">
        <h2 class="card-title">本次已存 <span id="recent-count" class="result-badge">0</span></h2>
        <div id="recent-list" class="recent-list"></div>
      </section>

      <!-- Stats widget -->
      <section class="card stats-card">
        <div class="stats-grid">
          <div class="stat-block">
            <div class="stat-label">今天</div>
            <div class="stat-value" id="stat-today">—</div>
          </div>
          <div class="stat-block">
            <div class="stat-label">近 30 天</div>
            <div class="stat-value" id="stat-month">—</div>
          </div>
          <div class="stat-block">
            <div class="stat-label">不同品項</div>
            <div class="stat-value" id="stat-products">—</div>
          </div>
          <div class="stat-block">
            <div class="stat-label">不同社團</div>
            <div class="stat-value" id="stat-groups">—</div>
          </div>
        </div>
      </section>

      <!-- Recent listings 永久顯示 -->
      <section class="card">
        <div class="recent-head">
          <h2 class="card-title">最近記錄</h2>
          <div class="recent-filter">
            <select id="recent-days" class="filter-select">
              <option value="1">近 1 天</option>
              <option value="7" selected>近 7 天</option>
              <option value="30">近 30 天</option>
              <option value="90">近 90 天</option>
            </select>
            <button id="refresh-recent-btn" class="link-btn" title="重新整理">↻</button>
          </div>
        </div>
        <div id="recent-table-wrap" class="recent-table-wrap">
          <div class="loading-text">載入中…</div>
        </div>
      </section>
    </main>

    <!-- Catalog create modal -->
    <div id="catalog-modal" class="modal-backdrop" style="display:none">
      <div class="modal-box">
        <div class="modal-head">
          <h3 class="modal-title">⚡ 建立新 Catalog</h3>
          <button id="catalog-modal-close" class="modal-close" title="關閉">×</button>
        </div>
        <div class="modal-body">
          <p class="modal-hint" id="catalog-modal-hint">未對應的 listing 將自動 link 到這個新建的 catalog。</p>

          <div class="field">
            <span class="field-label">系列 (series) *</span>
            <select id="cat-series" class="field-input">
              <option value="">--選擇--</option>
            </select>
          </div>

          <div class="field">
            <span class="field-label">商品名 (full_name) *</span>
            <input id="cat-full-name" type="text" class="field-input" placeholder="例：HG 1/144 鋼彈 ECOAS 傑鋼" />
          </div>

          <div class="grid-2">
            <div class="field">
              <span class="field-label">比例 (scale)</span>
              <input id="cat-scale" type="text" class="field-input" placeholder="1/144" />
            </div>
            <div class="field">
              <span class="field-label">作品 (franchise)</span>
              <input id="cat-franchise" type="text" class="field-input" placeholder="UC / SEED / 00 / ..." />
            </div>
          </div>

          <div class="field">
            <span class="field-label">日文名 (name_jp)</span>
            <input id="cat-name-jp" type="text" class="field-input" placeholder="可選" />
          </div>

          <div class="field">
            <span class="field-label">英文名 (name_en)</span>
            <input id="cat-name-en" type="text" class="field-input" placeholder="可選" />
          </div>

          <div class="field">
            <span class="field-label">Slug (URL 用) *</span>
            <input id="cat-slug" type="text" class="field-input" placeholder="hg-ecoas-jegan（小寫+橫線）" />
            <span class="field-hint">未來 SEO 連結 /gundam/<code>{'{slug}'}</code>，自動帶系列前綴</span>
          </div>

          <div id="catalog-modal-error" class="error-box" style="display:none"></div>
        </div>
        <div class="modal-footer">
          <button id="catalog-modal-cancel" class="link-btn">取消</button>
          <button id="catalog-modal-submit" class="primary-btn">建立 + 連結 listing</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .admin-shell {
      min-height: 100vh;
      background: #0A1428;
      color: #fff;
    }
    .admin-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      background: rgba(0, 0, 0, 0.3);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(8px);
    }
    .topbar-brand {
      font-weight: 700;
      letter-spacing: 0.05em;
    }
    .topbar-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .admin-email {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.55);
    }
    .link-btn {
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.6);
      cursor: pointer;
      font-size: 13px;
      padding: 6px 10px;
      border-radius: 6px;
      transition: color 0.15s, background 0.15s;
    }
    .link-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
    }

    .admin-main {
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px 80px;
    }
    .page-title {
      font-size: 24px;
      font-weight: 700;
      margin: 8px 0 4px;
    }
    .page-sub {
      color: rgba(255, 255, 255, 0.5);
      font-size: 14px;
      margin: 0 0 20px;
    }

    .card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 16px;
    }
    .card-title {
      font-size: 15px;
      font-weight: 600;
      margin: 0 0 12px;
      letter-spacing: 0.02em;
    }
    .required {
      color: #fca5a5;
      font-size: 12px;
      font-weight: 400;
      margin-left: 6px;
    }
    .result-badge {
      display: inline-block;
      min-width: 28px;
      padding: 2px 10px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      text-align: center;
      margin-left: 6px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    @media (min-width: 720px) {
      .grid-2 {
        grid-template-columns: 1fr 1fr;
      }
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .field-label {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.6);
      font-weight: 500;
    }
    .field-input,
    .textarea {
      width: 100%;
      padding: 10px 12px;
      font-size: 16px;
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      outline: none;
      transition: border-color 0.15s, background 0.15s;
      box-sizing: border-box;
      font-family: inherit;
    }
    .textarea {
      resize: vertical;
      min-height: 180px;
      line-height: 1.5;
    }
    .field-input:focus,
    .textarea:focus {
      border-color: rgba(255, 255, 255, 0.4);
      background: rgba(255, 255, 255, 0.08);
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 12px;
      flex-wrap: wrap;
    }
    .primary-btn {
      padding: 10px 18px;
      min-height: 44px;
      font-size: 15px;
      font-weight: 700;
      color: #0A1428;
      background: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      letter-spacing: 0.05em;
      transition: background 0.15s, transform 0.1s;
    }
    .primary-btn:hover {
      background: #f0f0f0;
    }
    .primary-btn:active {
      transform: scale(0.98);
    }
    .primary-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }
    .status-text {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.6);
    }
    .status-text.success { color: #86efac; }
    .status-text.error { color: #fca5a5; }

    /* Results list */
    .results-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 60vh;
      overflow-y: auto;
      padding: 4px;
    }
    .result-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 12px;
      align-items: start;
      padding: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      transition: border-color 0.15s, background 0.15s;
    }
    .result-row.unchecked {
      opacity: 0.5;
    }
    .result-row.is-sold {
      opacity: 0.65;
      background: rgba(156, 163, 175, 0.04);
    }
    .result-row.is-sold .lc-tag,
    .result-row.is-sold input,
    .result-row.is-sold select {
      filter: saturate(0.6);
    }
    .raw-hint {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.4);
      padding: 4px 2px 0;
      line-height: 1.4;
      font-style: italic;
    }
    .raw-hint::before {
      content: 'raw: ';
      color: rgba(255, 255, 255, 0.3);
      font-style: normal;
    }

    /* Results head */
    .results-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .results-head .card-title { margin: 0; }
    .select-actions {
      display: flex;
      gap: 4px;
    }
    .select-actions .link-btn {
      font-size: 12px;
      padding: 4px 10px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
    }
    .select-actions .link-btn:hover {
      background: rgba(255, 255, 255, 0.08);
    }
    .result-row input[type="checkbox"] {
      width: 20px;
      height: 20px;
      margin-top: 4px;
      cursor: pointer;
      flex-shrink: 0;
      accent-color: #fff;
    }
    .row-content {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }
    .row-fields {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    @media (min-width: 720px) {
      .row-fields {
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      }
    }
    .row-meta {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      padding-top: 6px;
      border-top: 1px dashed rgba(255, 255, 255, 0.08);
    }
    @media (min-width: 720px) {
      .row-meta { grid-template-columns: 1fr 1fr; }
    }
    .meta-field {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .meta-label {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.5);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .meta-field input {
      flex: 1;
      min-width: 0;
      padding: 4px 8px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.85);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 5px;
      outline: none;
      font-family: inherit;
    }
    .meta-field input:focus {
      border-color: rgba(255, 255, 255, 0.3);
    }
    .meta-field input::placeholder {
      color: rgba(255, 255, 255, 0.2);
    }
    .row-fields input,
    .row-fields select {
      padding: 6px 8px;
      font-size: 14px;
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      outline: none;
      font-family: inherit;
      box-sizing: border-box;
    }
    .row-fields input:focus,
    .row-fields select:focus {
      border-color: rgba(255, 255, 255, 0.4);
    }
    .row-fields .price-input {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    /* Recent saves */
    .recent-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.75);
    }
    .recent-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 10px;
      background: rgba(34, 197, 94, 0.06);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: 6px;
    }
    .recent-row.skipped {
      background: rgba(234, 179, 8, 0.06);
      border-color: rgba(234, 179, 8, 0.25);
      color: rgba(254, 240, 138, 0.85);
    }

    /* Stats */
    .stats-card { padding: 14px; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    @media (min-width: 720px) {
      .stats-grid { grid-template-columns: repeat(4, 1fr); }
    }
    .stat-block {
      padding: 10px 14px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 10px;
    }
    .stat-label {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.5);
    }
    .stat-value {
      font-size: 22px;
      font-weight: 700;
      color: #fff;
      font-variant-numeric: tabular-nums;
      margin-top: 2px;
    }

    /* Recent listings table */
    .recent-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .recent-head .card-title { margin: 0; }
    .recent-filter {
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .filter-select {
      padding: 6px 10px;
      font-size: 13px;
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      outline: none;
      font-family: inherit;
    }
    .loading-text {
      text-align: center;
      padding: 24px;
      color: rgba(255, 255, 255, 0.4);
      font-size: 14px;
    }
    /* Recent listings card grid */
    .recent-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    @media (min-width: 760px) {
      .recent-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .listing-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: border-color 0.15s, background 0.15s;
    }
    .listing-card:hover {
      border-color: rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.05);
    }
    .lc-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
    }
    .lc-title {
      font-size: 15px;
      font-weight: 600;
      color: #fff;
      line-height: 1.35;
      flex: 1;
      min-width: 0;
      word-break: break-word;
    }
    .lc-price {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .lc-price.sold {
      color: rgba(255, 255, 255, 0.4);
      text-decoration: line-through;
    }
    .lc-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      font-size: 12px;
    }
    .lc-tag {
      padding: 2px 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      color: rgba(255, 255, 255, 0.75);
    }
    .lc-tag.status-available {
      background: rgba(34, 197, 94, 0.12);
      color: #86efac;
    }
    .lc-tag.status-sold {
      background: rgba(156, 163, 175, 0.16);
      color: rgba(255, 255, 255, 0.55);
    }
    .lc-tag.unmatched {
      background: rgba(234, 179, 8, 0.15);
      color: #fde68a;
    }
    .lc-tag.legacy {
      background: rgba(168, 85, 247, 0.15);
      color: #d8b4fe;
    }
    .lc-meta-row {
      display: flex;
      align-items: flex-start;
      gap: 6px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.45;
    }
    .lc-meta-icon {
      flex-shrink: 0;
      width: 14px;
      text-align: center;
      opacity: 0.7;
    }
    .lc-meta-text {
      flex: 1;
      min-width: 0;
      word-break: break-word;
    }
    .lc-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-top: 8px;
      border-top: 1px dashed rgba(255, 255, 255, 0.06);
      font-size: 11px;
      color: rgba(255, 255, 255, 0.4);
    }
    .lc-source {
      flex: 1;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lc-fb-link {
      color: rgba(96, 165, 250, 0.85);
      text-decoration: none;
      flex-shrink: 0;
    }
    .lc-fb-link:hover { text-decoration: underline; }

    /* Thumbnails in listing card */
    .lc-thumbs {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items: center;
    }
    .lc-thumb {
      width: 56px;
      height: 56px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      cursor: zoom-in;
      transition: transform 0.15s, border-color 0.15s;
    }
    .lc-thumb:hover {
      transform: scale(1.05);
      border-color: rgba(255, 255, 255, 0.3);
    }
    .lc-thumb-more {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.5);
      padding: 0 6px;
    }
    .lc-time {
      flex-shrink: 0;
      white-space: nowrap;
    }

    /* Image preview */
    .img-preview-wrap {
      margin-top: 10px;
      padding: 10px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px dashed rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .img-preview-list {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .img-thumb {
      position: relative;
      width: 80px;
      height: 80px;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .img-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .img-thumb .x-btn {
      position: absolute;
      top: 2px;
      right: 2px;
      width: 18px;
      height: 18px;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      font-size: 12px;
      line-height: 1;
      padding: 0;
    }

    .row-empty {
      text-align: center;
      padding: 24px;
      color: rgba(255, 255, 255, 0.35);
      font-size: 13px;
    }

    /* Listing card 上「⚡ 建 catalog」action */
    .lc-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      font-size: 11px;
      color: #fde68a;
      background: rgba(234, 179, 8, 0.1);
      border: 1px solid rgba(234, 179, 8, 0.25);
      border-radius: 6px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s;
    }
    .lc-action-btn:hover {
      background: rgba(234, 179, 8, 0.2);
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-box {
      width: 100%;
      max-width: 480px;
      max-height: 90vh;
      overflow-y: auto;
      background: #0F1A2E;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
    }
    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .modal-title {
      font-size: 16px;
      font-weight: 700;
      margin: 0;
    }
    .modal-close {
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.5);
      font-size: 22px;
      cursor: pointer;
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .modal-close:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
    }
    .modal-body {
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .modal-hint {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.5);
      margin: 0 0 4px;
    }
    .field-hint {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.4);
      margin-top: 4px;
    }
    .field-hint code {
      background: rgba(255, 255, 255, 0.08);
      padding: 1px 5px;
      border-radius: 3px;
      font-family: monospace;
    }
    .modal-footer {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      padding: 12px 20px 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .error-box {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 13px;
    }
  </style>

  <script>
    /* ============================================
       Admin login check (call /api/admin/me，因為 HttpOnly cookie 不能 JS 讀)
       ============================================ */
    (async () => {
      try {
        const res = await fetch('/api/admin/me', { credentials: 'include' });
        if (!res.ok) {
          window.location.href = '/admin/login';
          return;
        }
        const data = await res.json();
        if (data?.user?.email) {
          const el = document.getElementById('admin-email');
          if (el) el.textContent = data.user.email;
        }
      } catch {
        window.location.href = '/admin/login';
      }
    })();

    /* ============================================
       Hash prefill (給 Chrome Extension 帶資料用)
       URL: /admin/listings#text=...&url=...&group=...
       ============================================ */
    (() => {
      if (!window.location.hash || window.location.hash.length < 2) return;
      try {
        const params = new URLSearchParams(window.location.hash.slice(1));
        const txt = params.get('text');
        const u = params.get('url');
        const g = params.get('group');
        if (txt) {
          const ta = document.getElementById('text-input') as HTMLTextAreaElement | null;
          if (ta) ta.value = txt;
        }
        if (u) {
          const i = document.getElementById('src-url') as HTMLInputElement | null;
          if (i) i.value = u;
        }
        if (g) {
          const i = document.getElementById('src-group') as HTMLInputElement | null;
          if (i) i.value = g;
        }
        // 清掉 hash 避免重整時重複帶（用 replaceState 不留 history）
        history.replaceState(null, '', window.location.pathname);
      } catch {}
    })();

    /* ============================================
       Setup
       ============================================ */
    const SERIES_OPTIONS = ['HG', 'RG', 'MG', 'MGEX', 'MGSD', 'MG Ver.Ka', 'PG', 'RE/100', 'SD', 'ROBOT魂', 'METAL ROBOT魂', '超合金', '好微笑', 'METAL BUILD', 'GFFMC', 'GFFN', 'SHCM PRO'];
    const CONDITION_OPTIONS = ['全新', '全新（拆檢）', '九成新', '八成新', '七成新', '已組'];

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const srcUrl = $('src-url') as HTMLInputElement;
    const srcGroup = $('src-group') as HTMLInputElement;
    const textInput = $('text-input') as HTMLTextAreaElement;
    const parseBtn = $('parse-btn') as HTMLButtonElement;
    const parseStatus = $('parse-status') as HTMLSpanElement;
    const resultsCard = $('results-card') as HTMLElement;
    const resultsList = $('results-list') as HTMLDivElement;
    const resultCount = $('result-count') as HTMLSpanElement;
    const saveBtn = $('save-btn') as HTMLButtonElement;
    const saveCount = $('save-count') as HTMLSpanElement;
    const saveStatus = $('save-status') as HTMLSpanElement;
    const resetBtn = $('reset-btn') as HTMLButtonElement;
    const recentCard = $('recent-card') as HTMLElement;
    const recentList = $('recent-list') as HTMLDivElement;
    const recentCount = $('recent-count') as HTMLSpanElement;
    const logoutBtn = $('logout-btn') as HTMLButtonElement;
    const adminEmail = $('admin-email') as HTMLSpanElement;

    let parsedItems: any[] = [];

    /* ============================================
       Image paste handler
       ============================================ */
    const imgPreviewWrap = $('img-preview-wrap') as HTMLElement;
    const imgPreviewList = $('img-preview-list') as HTMLDivElement;
    const parseImgBtn = $('parse-img-btn') as HTMLButtonElement;
    const imgClearBtn = $('img-clear-btn') as HTMLButtonElement;

    interface PendingImage {
      mime: string;
      base64: string;
      dataUrl: string;
      id: string;
    }
    let pendingImages: PendingImage[] = [];

    function updateImgUI() {
      const has = pendingImages.length > 0;
      imgPreviewWrap.style.display = has ? 'flex' : 'none';
      parseImgBtn.style.display = has ? '' : 'none';
      parseBtn.style.display = has ? 'none' : '';
      parseImgBtn.textContent = has
        ? `🖼️ AI 解析 ${pendingImages.length} 張圖片`
        : '🖼️ AI 解析圖片';
    }

    function renderImgList() {
      imgPreviewList.innerHTML = pendingImages
        .map(
          (img) => `
        <div class="img-thumb" data-id="${img.id}">
          <img src="${img.dataUrl}" alt="preview" />
          <button class="x-btn" data-rm="${img.id}" title="移除">×</button>
        </div>
      `
        )
        .join('');
      imgPreviewList.querySelectorAll('[data-rm]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-rm');
          pendingImages = pendingImages.filter((p) => p.id !== id);
          renderImgList();
          updateImgUI();
        });
      });
    }

    async function fileToBase64(file: File): Promise<{ mime: string; base64: string; dataUrl: string }> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const dataUrl = reader.result as string;
          const base64 = dataUrl.split(',')[1] || '';
          resolve({ mime: file.type, base64, dataUrl });
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    // textarea paste
    textInput.addEventListener('paste', async (e) => {
      const items = (e as ClipboardEvent).clipboardData?.items;
      if (!items) return;
      let imageFound = false;
      for (const item of Array.from(items)) {
        if (item.type.startsWith('image/')) {
          imageFound = true;
          e.preventDefault();
          const file = item.getAsFile();
          if (!file) continue;
          if (pendingImages.length >= 4) {
            parseStatus.textContent = '⚠️ 最多 4 張圖';
            parseStatus.className = 'status-text error';
            continue;
          }
          try {
            const { mime, base64, dataUrl } = await fileToBase64(file);
            pendingImages.push({
              mime,
              base64,
              dataUrl,
              id: 'img_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
            });
            renderImgList();
            updateImgUI();
            parseStatus.textContent = `✅ 已加入第 ${pendingImages.length} 張圖`;
            parseStatus.className = 'status-text success';
          } catch (err) {
            parseStatus.textContent = '❌ 圖片讀取失敗';
            parseStatus.className = 'status-text error';
          }
        }
      }
      // 若沒抓到圖（純文字 paste）→ 讓 default paste 跑
    });

    imgClearBtn.addEventListener('click', () => {
      pendingImages = [];
      renderImgList();
      updateImgUI();
      parseStatus.textContent = '';
    });

    /* ============================================
       AI parse - image
       ============================================ */
    parseImgBtn.addEventListener('click', async () => {
      if (pendingImages.length === 0) return;
      parseImgBtn.disabled = true;
      parseStatus.textContent = `🖼️ AI Vision 解析 ${pendingImages.length} 張圖中…（可能 10-30 秒）`;
      parseStatus.className = 'status-text';
      resultsCard.style.display = 'none';

      try {
        const res = await fetch('/api/ai/extract-listing-from-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            images: pendingImages.map((p) => ({ mime: p.mime, base64: p.base64 })),
            text: textInput.value.trim(), // 同時帶 textarea 文字當 context
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          parseStatus.textContent = `❌ ${data.message || '解析失敗'}`;
          parseStatus.className = 'status-text error';
          parseImgBtn.disabled = false;
          return;
        }
        parsedItems = data.items || [];
        // 如果 AI 抓到 group / poster，回填 source 區
        if (data.group && !srcGroup.value) srcGroup.value = data.group;

        parseStatus.textContent = `✅ 從圖片找到 ${parsedItems.length} 個商品（原始 ${data.raw_count || parsedItems.length}）`;
        parseStatus.className = 'status-text success';
        renderResults();
        resultsCard.style.display = '';
        parseImgBtn.disabled = false;
      } catch (e) {
        parseStatus.textContent = '❌ 網路錯誤';
        parseStatus.className = 'status-text error';
        parseImgBtn.disabled = false;
      }
    });

    /* ============================================
       Logout
       ============================================ */
    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
      } catch {}
      window.location.href = '/admin/login';
    });

    /* ============================================
       AI parse
       ============================================ */
    parseBtn.addEventListener('click', async () => {
      const text = textInput.value.trim();
      if (!text) {
        parseStatus.textContent = '請貼上 FB 貼文文字';
        parseStatus.className = 'status-text error';
        return;
      }
      parseBtn.disabled = true;
      parseStatus.textContent = '🤖 AI 解析中…';
      parseStatus.className = 'status-text';
      resultsCard.style.display = 'none';

      try {
        const res = await fetch('/api/ai/extract-listing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          parseStatus.textContent = `❌ ${data.message || '解析失敗'}`;
          parseStatus.className = 'status-text error';
          parseBtn.disabled = false;
          return;
        }
        parsedItems = data.items || [];
        parseStatus.textContent = `✅ 找到 ${parsedItems.length} 個商品（原始 ${data.raw_count || parsedItems.length}）`;
        parseStatus.className = 'status-text success';
        renderResults();
        resultsCard.style.display = '';
        parseBtn.disabled = false;
      } catch (e) {
        parseStatus.textContent = '❌ 網路錯誤';
        parseStatus.className = 'status-text error';
        parseBtn.disabled = false;
      }
    });

    function renderResults() {
      resultCount.textContent = String(parsedItems.length);
      resultsList.innerHTML = '';
      parsedItems.forEach((item, idx) => {
        const row = document.createElement('div');
        row.className = 'result-row';
        row.dataset.idx = String(idx);

        const seriesOptions = SERIES_OPTIONS.map(
          (s) => `<option value="${s}" ${s === item.series ? 'selected' : ''}>${s}</option>`
        ).join('');
        const condOptions = CONDITION_OPTIONS.map(
          (c) => `<option value="${c}" ${c === item.condition ? 'selected' : ''}>${c}</option>`
        ).join('');

        const isSold = item.status === 'sold';
        if (isSold) row.classList.add('is-sold');
        const pricePlaceholder = isSold && !item.price ? '已售未知' : 'NT$';
        const rawHintHtml = item.rawHint
          ? `<div class="raw-hint">${escapeHtml(item.rawHint)}</div>`
          : '';

        row.innerHTML = `
          <input type="checkbox" class="check" checked />
          <div class="row-content">
            <div class="row-fields">
              <input type="text" class="model-input" value="${escapeHtml(item.model || item.originalName || '')}" placeholder="品名" />
              <select class="series-select">
                <option value="">--系列--</option>
                ${seriesOptions}
              </select>
              <select class="cond-select">${condOptions}</select>
              <select class="status-select">
                <option value="available" ${isSold ? '' : 'selected'}>🟢 販售中</option>
                <option value="sold" ${isSold ? 'selected' : ''}>🔴 已售出</option>
              </select>
              <input type="number" class="price-input" value="${item.price || ''}" min="0" placeholder="${pricePlaceholder}" />
            </div>
            ${rawHintHtml}
            <div class="row-meta">
              <label class="meta-field">
                <span class="meta-label">📦 寄送</span>
                <input type="text" class="ship-input" value="${escapeHtml(item.shippingText || '')}" placeholder="例：賣貨便+45 / 店到店+60" />
              </label>
              <label class="meta-field">
                <span class="meta-label">📍 面交</span>
                <input type="text" class="meetup-input" value="${escapeHtml(item.meetupText || '')}" placeholder="例：台南面交 / 雙北面交" />
              </label>
            </div>
          </div>
        `;
        resultsList.appendChild(row);

        // Hookup
        const check = row.querySelector('.check') as HTMLInputElement;
        check.addEventListener('change', () => {
          row.classList.toggle('unchecked', !check.checked);
          updateSaveCount();
        });
        // status 變更時即時更新 sold 灰化
        const statusSel = row.querySelector('.status-select') as HTMLSelectElement;
        statusSel.addEventListener('change', () => {
          row.classList.toggle('is-sold', statusSel.value === 'sold');
          const priceInput = row.querySelector('.price-input') as HTMLInputElement;
          if (statusSel.value === 'sold' && !priceInput.value) {
            priceInput.placeholder = '已售未知';
          } else {
            priceInput.placeholder = 'NT$';
          }
        });
      });
      updateSaveCount();
    }

    function updateSaveCount() {
      const n = resultsList.querySelectorAll('.check:checked').length;
      saveCount.textContent = String(n);
      saveBtn.disabled = n === 0;
    }

    /* ============================================
       Save
       ============================================ */
    saveBtn.addEventListener('click', async () => {
      const rows = Array.from(resultsList.querySelectorAll('.result-row'));
      const items = rows
        .filter((row) => (row.querySelector('.check') as HTMLInputElement).checked)
        .map((row) => {
          const idx = parseInt(row.getAttribute('data-idx') || '0', 10);
          const orig = parsedItems[idx] || {};
          return {
            model: (row.querySelector('.model-input') as HTMLInputElement).value.trim(),
            originalName: orig.originalName || '',
            series: (row.querySelector('.series-select') as HTMLSelectElement).value,
            scale: orig.scale || '',
            franchise: orig.franchise || '',
            condition: (row.querySelector('.cond-select') as HTMLSelectElement).value,
            status: (row.querySelector('.status-select') as HTMLSelectElement).value,
            price: parseInt((row.querySelector('.price-input') as HTMLInputElement).value || '0', 10),
            shippingText: (row.querySelector('.ship-input') as HTMLInputElement).value.trim(),
            meetupText: (row.querySelector('.meetup-input') as HTMLInputElement).value.trim(),
            notes: orig.note || '',
          };
        });

      if (items.length === 0) {
        saveStatus.textContent = '請至少勾一筆';
        saveStatus.className = 'status-text error';
        return;
      }

      saveBtn.disabled = true;
      saveStatus.textContent = '💾 保存中…';
      saveStatus.className = 'status-text';

      // 先上傳 pending images（如果有）拿 r2_keys
      const imageR2Keys: string[] = [];
      if (pendingImages.length > 0) {
        saveStatus.textContent = `📷 上傳 ${pendingImages.length} 張圖中…`;
        for (let i = 0; i < pendingImages.length; i++) {
          const img = pendingImages[i];
          try {
            const upRes = await fetch('/api/admin/upload-screenshot', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ mime: img.mime, base64: img.base64 }),
            });
            const upData = await upRes.json();
            if (upRes.ok && upData.ok && upData.r2_key) {
              imageR2Keys.push(upData.r2_key);
            }
          } catch {
            // 個別圖失敗不擋（圖少存幾張不影響 listings）
          }
        }
        saveStatus.textContent = `💾 已上傳 ${imageR2Keys.length} 張圖，保存 listings 中…`;
      }

      try {
        const res = await fetch('/api/admin/listings/batch-save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source_url: srcUrl.value.trim() || null,
            source_group_name: srcGroup.value.trim() || null,
            items,
            image_r2_keys: imageR2Keys,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          saveStatus.textContent = `❌ ${data.message || '保存失敗'}`;
          saveStatus.className = 'status-text error';
          saveBtn.disabled = false;
          return;
        }
        saveStatus.textContent = `✅ 已存 ${data.saved_count} 筆${data.skipped_count > 0 ? `，跳過 ${data.skipped_count} 筆` : ''}`;
        saveStatus.className = 'status-text success';

        // Show recent
        renderRecent(data);
        recentCard.style.display = '';

        // Clear results card + textarea + images
        resultsCard.style.display = 'none';
        textInput.value = '';
        parsedItems = [];
        parseStatus.textContent = '';
        pendingImages = [];
        renderImgList();
        updateImgUI();
        saveBtn.disabled = false;
      } catch (e) {
        saveStatus.textContent = '❌ 網路錯誤';
        saveStatus.className = 'status-text error';
        saveBtn.disabled = false;
      }
    });

    function renderRecent(data: any) {
      const existingCount = parseInt(recentCount.textContent || '0', 10);
      recentCount.textContent = String(existingCount + data.saved.length + data.skipped.length);

      // Saved rows (green)
      data.saved.forEach((s: any) => {
        const row = document.createElement('div');
        row.className = 'recent-row';
        row.innerHTML = `<span>✅ ${escapeHtml(s.model)}</span><span>NT$ ${s.price}・${s.status === 'sold' ? '已售' : '可購'}</span>`;
        recentList.insertBefore(row, recentList.firstChild);
      });
      // Skipped rows (yellow)
      data.skipped.forEach((s: any) => {
        const row = document.createElement('div');
        row.className = 'recent-row skipped';
        row.innerHTML = `<span>⚠️ ${escapeHtml(s.model)}</span><span>${escapeHtml(s.reason)}</span>`;
        recentList.insertBefore(row, recentList.firstChild);
      });
    }

    resetBtn.addEventListener('click', () => {
      resultsList.innerHTML = '';
      resultsCard.style.display = 'none';
      parsedItems = [];
      saveStatus.textContent = '';
    });

    /* ============================================
       Select all / none buttons
       ============================================ */
    const selectAllBtn = $('select-all-btn') as HTMLButtonElement;
    const selectNoneBtn = $('select-none-btn') as HTMLButtonElement;
    function setAllChecked(val: boolean) {
      resultsList.querySelectorAll('.result-row').forEach((row) => {
        const cb = row.querySelector('.check') as HTMLInputElement;
        if (cb) cb.checked = val;
        row.classList.toggle('unchecked', !val);
      });
      updateSaveCount();
    }
    selectAllBtn.addEventListener('click', () => setAllChecked(true));
    selectNoneBtn.addEventListener('click', () => setAllChecked(false));

    function escapeHtml(s: string): string {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    /* ============================================
       Recent listings + stats
       ============================================ */
    const recentDaysSel = $('recent-days') as HTMLSelectElement;
    const recentWrap = $('recent-table-wrap') as HTMLDivElement;
    const refreshBtn = $('refresh-recent-btn') as HTMLButtonElement;

    async function loadRecent() {
      const days = recentDaysSel.value || '7';
      recentWrap.innerHTML = '<div class="loading-text">載入中…</div>';
      try {
        const res = await fetch(`/api/admin/listings/recent?days=${days}&limit=80`, { credentials: 'include' });
        if (!res.ok) {
          recentWrap.innerHTML = '<div class="row-empty">載入失敗（' + res.status + '）</div>';
          return;
        }
        const data = await res.json();
        renderStats(data.stats);
        renderRecentTable(data.items || []);
      } catch {
        recentWrap.innerHTML = '<div class="row-empty">網路錯誤</div>';
      }
    }

    function renderStats(stats: any) {
      ($('stat-today') as HTMLElement).textContent = String(stats?.today_count ?? 0);
      ($('stat-month') as HTMLElement).textContent = String(stats?.month_count ?? 0);
      ($('stat-products') as HTMLElement).textContent = String(stats?.month_distinct_products ?? 0);
      ($('stat-groups') as HTMLElement).textContent = String(stats?.month_distinct_groups ?? 0);
    }

    function renderRecentTable(items: any[]) {
      if (items.length === 0) {
        recentWrap.innerHTML = '<div class="row-empty">這段時間沒有記錄</div>';
        return;
      }

      const cards = items.map((it) => {
        const status = it.status === 'sold' ? 'sold' : 'available';
        const statusLabel = status === 'sold' ? '已售' : '可購';
        const unmatched = !it.product_id || it.product_id === 'cat_unknown';
        const sourceText = it.source_group_name || '—';
        const timeAgo = formatTimeAgo(it.created_at);

        // tags row: 系列 · 條件 · 狀態 · 未對應 · legacy
        const tags = [];
        if (it.series) tags.push(`<span class="lc-tag">${escapeHtml(it.series)}</span>`);
        if (it.condition) tags.push(`<span class="lc-tag">${escapeHtml(it.condition)}</span>`);
        tags.push(`<span class="lc-tag status-${status}">${statusLabel}</span>`);
        if (unmatched) tags.push('<span class="lc-tag unmatched">未對應</span>');
        if (it.is_legacy) tags.push('<span class="lc-tag legacy">legacy</span>');

        // meta rows: 寄送 / 面交（各自一行）
        const metaParts = [];
        if (it.shipping_text) {
          metaParts.push(`
            <div class="lc-meta-row">
              <span class="lc-meta-icon">📦</span>
              <span class="lc-meta-text">${escapeHtml(it.shipping_text)}</span>
            </div>
          `);
        }
        if (it.meetup_text) {
          metaParts.push(`
            <div class="lc-meta-row">
              <span class="lc-meta-icon">📍</span>
              <span class="lc-meta-text">${escapeHtml(it.meetup_text)}</span>
            </div>
          `);
        }
        if (it.notes) {
          metaParts.push(`
            <div class="lc-meta-row">
              <span class="lc-meta-icon">📝</span>
              <span class="lc-meta-text">${escapeHtml(it.notes)}</span>
            </div>
          `);
        }

        const fbLink = it.source_url
          ? `<a href="${escapeHtml(it.source_url)}" target="_blank" rel="noopener" class="lc-fb-link">🔗 FB</a>`
          : '';

        const buildCatalogBtn = unmatched
          ? `<button class="lc-action-btn" data-build-catalog="${escapeHtml(it.id)}" data-name="${escapeHtml(it.model)}">⚡ 建立 catalog</button>`
          : '';

        // Screenshot thumbnails
        const imageKeys: string[] = Array.isArray(it.image_r2_keys) ? it.image_r2_keys : [];
        const thumbsHtml = imageKeys.length > 0
          ? `<div class="lc-thumbs">${imageKeys
              .slice(0, 4)
              .map((k) => `<img class="lc-thumb" src="/api/screenshot/${escapeHtml(k)}" data-fullkey="${escapeHtml(k)}" alt="screenshot" loading="lazy" />`)
              .join('')}${imageKeys.length > 4 ? `<span class="lc-thumb-more">+${imageKeys.length - 4}</span>` : ''}</div>`
          : '';

        return `
          <div class="listing-card">
            <div class="lc-head">
              <div class="lc-title">${escapeHtml(it.model)}</div>
              <div class="lc-price ${status}">NT$ ${(it.price || 0).toLocaleString()}</div>
            </div>
            <div class="lc-tags">${tags.join('')} ${buildCatalogBtn}</div>
            ${thumbsHtml}
            ${metaParts.join('')}
            <div class="lc-footer">
              <span class="lc-source">${escapeHtml(sourceText)}</span>
              ${fbLink}
              <span class="lc-time">${timeAgo}</span>
            </div>
          </div>
        `;
      }).join('');

      recentWrap.innerHTML = `<div class="recent-grid">${cards}</div>`;

      // Hook up「⚡ 建立 catalog」button
      recentWrap.querySelectorAll('[data-build-catalog]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const t = e.currentTarget as HTMLElement;
          openCatalogModal(t.getAttribute('data-build-catalog') || '', t.getAttribute('data-name') || '');
        });
      });

      // Thumbnail click → 開新 tab 看大圖
      recentWrap.querySelectorAll('.lc-thumb').forEach((img) => {
        img.addEventListener('click', (e) => {
          const key = (e.currentTarget as HTMLElement).getAttribute('data-fullkey') || '';
          if (key) window.open('/api/screenshot/' + key, '_blank');
        });
      });
    }

    /* ============================================
       Catalog create modal
       ============================================ */
    const catalogModal = $('catalog-modal') as HTMLDivElement;
    const catalogModalClose = $('catalog-modal-close') as HTMLButtonElement;
    const catalogModalCancel = $('catalog-modal-cancel') as HTMLButtonElement;
    const catalogModalSubmit = $('catalog-modal-submit') as HTMLButtonElement;
    const catalogModalHint = $('catalog-modal-hint') as HTMLParagraphElement;
    const catalogModalError = $('catalog-modal-error') as HTMLDivElement;
    const catSeries = $('cat-series') as HTMLSelectElement;
    const catFullName = $('cat-full-name') as HTMLInputElement;
    const catScale = $('cat-scale') as HTMLInputElement;
    const catFranchise = $('cat-franchise') as HTMLInputElement;
    const catNameJp = $('cat-name-jp') as HTMLInputElement;
    const catNameEn = $('cat-name-en') as HTMLInputElement;
    const catSlug = $('cat-slug') as HTMLInputElement;

    // 填 series options
    SERIES_OPTIONS.forEach((s) => {
      const opt = document.createElement('option');
      opt.value = s;
      opt.textContent = s;
      catSeries.appendChild(opt);
    });

    let currentListingId = '';

    function openCatalogModal(listingId: string, presetName: string) {
      currentListingId = listingId;
      catFullName.value = presetName;
      catScale.value = '';
      catFranchise.value = '';
      catNameJp.value = '';
      catNameEn.value = '';
      catSlug.value = '';
      catSeries.value = '';
      catalogModalError.style.display = 'none';
      catalogModalHint.textContent = listingId
        ? `將自動 link 到 listing「${presetName}」`
        : '建立新 catalog';
      catalogModal.style.display = 'flex';
      catFullName.focus();
      // 自動 suggest slug 從 full_name
      catFullName.addEventListener('input', autoSuggestSlug);
      catSeries.addEventListener('change', autoSuggestSlug);
    }

    function autoSuggestSlug() {
      if (catSlug.dataset.userEdited === '1') return;
      const series = catSeries.value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const name = catFullName.value
        .replace(/[^\x20-\x7e]+/g, ' ')   // 去中文
        .replace(/[^a-zA-Z0-9]+/g, '-')   // 連續非字母數字 → -
        .replace(/^-+|-+$/g, '')           // trim -
        .toLowerCase();
      catSlug.value = series && name ? `${series}-${name}` : (name || series);
    }
    catSlug.addEventListener('input', () => { catSlug.dataset.userEdited = '1'; });

    function closeCatalogModal() {
      catalogModal.style.display = 'none';
      currentListingId = '';
    }

    catalogModalClose.addEventListener('click', closeCatalogModal);
    catalogModalCancel.addEventListener('click', closeCatalogModal);
    catalogModal.addEventListener('click', (e) => {
      if (e.target === catalogModal) closeCatalogModal();
    });

    catalogModalSubmit.addEventListener('click', async () => {
      const payload = {
        series: catSeries.value.trim(),
        slug: catSlug.value.trim().toLowerCase(),
        full_name: catFullName.value.trim(),
        scale: catScale.value.trim(),
        franchise: catFranchise.value.trim(),
        name_jp: catNameJp.value.trim(),
        name_en: catNameEn.value.trim(),
        listing_id: currentListingId || undefined,
      };

      if (!payload.series || !payload.slug || !payload.full_name) {
        catalogModalError.textContent = '必填：系列 / 商品名 / Slug';
        catalogModalError.style.display = 'block';
        return;
      }

      catalogModalSubmit.disabled = true;
      catalogModalSubmit.textContent = '建立中…';
      catalogModalError.style.display = 'none';

      try {
        const res = await fetch('/api/admin/catalog/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          catalogModalError.textContent = data.message || '建立失敗';
          catalogModalError.style.display = 'block';
          catalogModalSubmit.disabled = false;
          catalogModalSubmit.textContent = '建立 + 連結 listing';
          return;
        }
        // 成功
        closeCatalogModal();
        catalogModalSubmit.disabled = false;
        catalogModalSubmit.textContent = '建立 + 連結 listing';
        // refresh recent list
        loadRecent();
      } catch (e) {
        catalogModalError.textContent = '網路錯誤';
        catalogModalError.style.display = 'block';
        catalogModalSubmit.disabled = false;
        catalogModalSubmit.textContent = '建立 + 連結 listing';
      }
    });

    function formatTimeAgo(ts: number): string {
      const diff = Date.now() - ts;
      const minutes = Math.floor(diff / 60000);
      if (minutes < 1) return '剛剛';
      if (minutes < 60) return `${minutes} 分鐘前`;
      const hours = Math.floor(minutes / 60);
      if (hours < 24) return `${hours} 小時前`;
      const days = Math.floor(hours / 24);
      if (days < 7) return `${days} 天前`;
      const d = new Date(ts);
      return `${d.getMonth() + 1}/${d.getDate()}`;
    }

    recentDaysSel.addEventListener('change', loadRecent);
    refreshBtn.addEventListener('click', loadRecent);

    // 進頁立刻載入
    loadRecent();

    // save 成功後也 reload recent
    const _origSaveClick = saveBtn.onclick;
    saveBtn.addEventListener('click', () => {
      setTimeout(loadRecent, 500); // 等 batch-save 寫完
    });
  </script>
</Layout>
