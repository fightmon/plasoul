---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="新增 FB Listing · 普拉魂 Admin" noIndex={true}>
  <div class="admin-shell">
    <!-- Top bar -->
    <header class="admin-topbar">
      <div class="topbar-brand">🤖 普拉魂 Admin</div>
      <div class="topbar-right">
        <span id="admin-email" class="admin-email"></span>
        <button id="logout-btn" class="link-btn">登出</button>
      </div>
    </header>

    <main class="admin-main">
      <h1 class="page-title">新增 FB Listing</h1>
      <p class="page-sub">貼 FB 鋼彈交易貼文 → AI 解析 → 多選保存</p>

      <!-- Source info -->
      <section class="card">
        <h2 class="card-title">來源資訊（可選）</h2>
        <div class="grid-2">
          <label class="field">
            <span class="field-label">FB 貼文 URL</span>
            <input id="src-url" type="url" class="field-input" placeholder="https://www.facebook.com/groups/.../posts/..." />
          </label>
          <label class="field">
            <span class="field-label">社團名稱</span>
            <input id="src-group" type="text" class="field-input" placeholder="例：鋼彈交易市集" />
          </label>
        </div>
      </section>

      <!-- Text input -->
      <section class="card">
        <h2 class="card-title">FB 貼文文字 <span class="required">*必填</span></h2>
        <textarea id="text-input" class="textarea" rows="10" placeholder="貼上整篇 FB 貼文…"></textarea>
        <div class="actions">
          <button id="parse-btn" class="primary-btn">🤖 AI 解析</button>
          <span id="parse-status" class="status-text"></span>
        </div>
      </section>

      <!-- Results -->
      <section id="results-card" class="card" style="display:none">
        <h2 class="card-title">
          AI 解析結果 <span id="result-count" class="result-badge">0</span>
        </h2>
        <div id="results-list" class="results-list"></div>
        <div class="actions">
          <button id="save-btn" class="primary-btn">💾 保存選取 <span id="save-count">0</span> 筆</button>
          <button id="reset-btn" class="link-btn">清空</button>
          <span id="save-status" class="status-text"></span>
        </div>
      </section>

      <!-- Recent saves -->
      <section id="recent-card" class="card" style="display:none">
        <h2 class="card-title">本次已存 <span id="recent-count" class="result-badge">0</span></h2>
        <div id="recent-list" class="recent-list"></div>
      </section>
    </main>
  </div>

  <style>
    .admin-shell {
      min-height: 100vh;
      background: #0A1428;
      color: #fff;
    }
    .admin-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      background: rgba(0, 0, 0, 0.3);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(8px);
    }
    .topbar-brand {
      font-weight: 700;
      letter-spacing: 0.05em;
    }
    .topbar-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .admin-email {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.55);
    }
    .link-btn {
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.6);
      cursor: pointer;
      font-size: 13px;
      padding: 6px 10px;
      border-radius: 6px;
      transition: color 0.15s, background 0.15s;
    }
    .link-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
    }

    .admin-main {
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px 80px;
    }
    .page-title {
      font-size: 24px;
      font-weight: 700;
      margin: 8px 0 4px;
    }
    .page-sub {
      color: rgba(255, 255, 255, 0.5);
      font-size: 14px;
      margin: 0 0 20px;
    }

    .card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 16px;
    }
    .card-title {
      font-size: 15px;
      font-weight: 600;
      margin: 0 0 12px;
      letter-spacing: 0.02em;
    }
    .required {
      color: #fca5a5;
      font-size: 12px;
      font-weight: 400;
      margin-left: 6px;
    }
    .result-badge {
      display: inline-block;
      min-width: 28px;
      padding: 2px 10px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      text-align: center;
      margin-left: 6px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    @media (min-width: 720px) {
      .grid-2 {
        grid-template-columns: 1fr 1fr;
      }
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .field-label {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.6);
      font-weight: 500;
    }
    .field-input,
    .textarea {
      width: 100%;
      padding: 10px 12px;
      font-size: 16px;
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      outline: none;
      transition: border-color 0.15s, background 0.15s;
      box-sizing: border-box;
      font-family: inherit;
    }
    .textarea {
      resize: vertical;
      min-height: 180px;
      line-height: 1.5;
    }
    .field-input:focus,
    .textarea:focus {
      border-color: rgba(255, 255, 255, 0.4);
      background: rgba(255, 255, 255, 0.08);
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 12px;
      flex-wrap: wrap;
    }
    .primary-btn {
      padding: 10px 18px;
      min-height: 44px;
      font-size: 15px;
      font-weight: 700;
      color: #0A1428;
      background: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      letter-spacing: 0.05em;
      transition: background 0.15s, transform 0.1s;
    }
    .primary-btn:hover {
      background: #f0f0f0;
    }
    .primary-btn:active {
      transform: scale(0.98);
    }
    .primary-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }
    .status-text {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.6);
    }
    .status-text.success { color: #86efac; }
    .status-text.error { color: #fca5a5; }

    /* Results list */
    .results-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 60vh;
      overflow-y: auto;
      padding: 4px;
    }
    .result-row {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 12px;
      align-items: start;
      padding: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      transition: border-color 0.15s, background 0.15s;
    }
    .result-row.unchecked {
      opacity: 0.5;
    }
    .result-row input[type="checkbox"] {
      width: 20px;
      height: 20px;
      margin-top: 4px;
      cursor: pointer;
      flex-shrink: 0;
      accent-color: #fff;
    }
    .row-fields {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    @media (min-width: 720px) {
      .row-fields {
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      }
    }
    .row-fields input,
    .row-fields select {
      padding: 6px 8px;
      font-size: 14px;
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      outline: none;
      font-family: inherit;
      box-sizing: border-box;
    }
    .row-fields input:focus,
    .row-fields select:focus {
      border-color: rgba(255, 255, 255, 0.4);
    }
    .row-fields .price-input {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    /* Recent saves */
    .recent-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.75);
    }
    .recent-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 10px;
      background: rgba(34, 197, 94, 0.06);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: 6px;
    }
    .recent-row.skipped {
      background: rgba(234, 179, 8, 0.06);
      border-color: rgba(234, 179, 8, 0.25);
      color: rgba(254, 240, 138, 0.85);
    }
  </style>

  <script>
    /* ============================================
       Admin login check (client-side guard)
       ============================================ */
    if (!document.cookie.includes('ps_session=')) {
      window.location.href = '/admin/login';
    }

    /* ============================================
       Setup
       ============================================ */
    const SERIES_OPTIONS = ['HG', 'RG', 'MG', 'MGEX', 'MGSD', 'MG Ver.Ka', 'PG', 'RE/100', 'SD', 'ROBOT魂', 'METAL ROBOT魂', '超合金', '好微笑', 'METAL BUILD', 'GFFMC', 'GFFN', 'SHCM PRO'];
    const CONDITION_OPTIONS = ['全新', '全新（拆檢）', '九成新', '八成新', '七成新', '已組'];

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const srcUrl = $('src-url') as HTMLInputElement;
    const srcGroup = $('src-group') as HTMLInputElement;
    const textInput = $('text-input') as HTMLTextAreaElement;
    const parseBtn = $('parse-btn') as HTMLButtonElement;
    const parseStatus = $('parse-status') as HTMLSpanElement;
    const resultsCard = $('results-card') as HTMLElement;
    const resultsList = $('results-list') as HTMLDivElement;
    const resultCount = $('result-count') as HTMLSpanElement;
    const saveBtn = $('save-btn') as HTMLButtonElement;
    const saveCount = $('save-count') as HTMLSpanElement;
    const saveStatus = $('save-status') as HTMLSpanElement;
    const resetBtn = $('reset-btn') as HTMLButtonElement;
    const recentCard = $('recent-card') as HTMLElement;
    const recentList = $('recent-list') as HTMLDivElement;
    const recentCount = $('recent-count') as HTMLSpanElement;
    const logoutBtn = $('logout-btn') as HTMLButtonElement;
    const adminEmail = $('admin-email') as HTMLSpanElement;

    let parsedItems: any[] = [];

    /* ============================================
       Logout
       ============================================ */
    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
      } catch {}
      window.location.href = '/admin/login';
    });

    /* ============================================
       AI parse
       ============================================ */
    parseBtn.addEventListener('click', async () => {
      const text = textInput.value.trim();
      if (!text) {
        parseStatus.textContent = '請貼上 FB 貼文文字';
        parseStatus.className = 'status-text error';
        return;
      }
      parseBtn.disabled = true;
      parseStatus.textContent = '🤖 AI 解析中…';
      parseStatus.className = 'status-text';
      resultsCard.style.display = 'none';

      try {
        const res = await fetch('/api/ai/extract-listing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          parseStatus.textContent = `❌ ${data.message || '解析失敗'}`;
          parseStatus.className = 'status-text error';
          parseBtn.disabled = false;
          return;
        }
        parsedItems = data.items || [];
        parseStatus.textContent = `✅ 找到 ${parsedItems.length} 個商品（原始 ${data.raw_count || parsedItems.length}）`;
        parseStatus.className = 'status-text success';
        renderResults();
        resultsCard.style.display = '';
        parseBtn.disabled = false;
      } catch (e) {
        parseStatus.textContent = '❌ 網路錯誤';
        parseStatus.className = 'status-text error';
        parseBtn.disabled = false;
      }
    });

    function renderResults() {
      resultCount.textContent = String(parsedItems.length);
      resultsList.innerHTML = '';
      parsedItems.forEach((item, idx) => {
        const row = document.createElement('div');
        row.className = 'result-row';
        row.dataset.idx = String(idx);

        const seriesOptions = SERIES_OPTIONS.map(
          (s) => `<option value="${s}" ${s === item.series ? 'selected' : ''}>${s}</option>`
        ).join('');
        const condOptions = CONDITION_OPTIONS.map(
          (c) => `<option value="${c}" ${c === item.condition ? 'selected' : ''}>${c}</option>`
        ).join('');

        row.innerHTML = `
          <input type="checkbox" class="check" checked />
          <div class="row-fields">
            <input type="text" class="model-input" value="${escapeHtml(item.model || item.originalName || '')}" placeholder="品名" />
            <select class="series-select">
              <option value="">--系列--</option>
              ${seriesOptions}
            </select>
            <select class="cond-select">${condOptions}</select>
            <select class="status-select">
              <option value="available" ${item.status === 'sold' ? '' : 'selected'}>可購</option>
              <option value="sold" ${item.status === 'sold' ? 'selected' : ''}>已售</option>
            </select>
            <input type="number" class="price-input" value="${item.price || 0}" min="0" placeholder="NT$" />
          </div>
        `;
        resultsList.appendChild(row);

        // Hookup
        const check = row.querySelector('.check') as HTMLInputElement;
        check.addEventListener('change', () => {
          row.classList.toggle('unchecked', !check.checked);
          updateSaveCount();
        });
      });
      updateSaveCount();
    }

    function updateSaveCount() {
      const n = resultsList.querySelectorAll('.check:checked').length;
      saveCount.textContent = String(n);
      saveBtn.disabled = n === 0;
    }

    /* ============================================
       Save
       ============================================ */
    saveBtn.addEventListener('click', async () => {
      const rows = Array.from(resultsList.querySelectorAll('.result-row'));
      const items = rows
        .filter((row) => (row.querySelector('.check') as HTMLInputElement).checked)
        .map((row) => {
          const idx = parseInt(row.getAttribute('data-idx') || '0', 10);
          const orig = parsedItems[idx] || {};
          return {
            model: (row.querySelector('.model-input') as HTMLInputElement).value.trim(),
            originalName: orig.originalName || '',
            series: (row.querySelector('.series-select') as HTMLSelectElement).value,
            scale: orig.scale || '',
            franchise: orig.franchise || '',
            condition: (row.querySelector('.cond-select') as HTMLSelectElement).value,
            status: (row.querySelector('.status-select') as HTMLSelectElement).value,
            price: parseInt((row.querySelector('.price-input') as HTMLInputElement).value || '0', 10),
            notes: orig.note || '',
          };
        });

      if (items.length === 0) {
        saveStatus.textContent = '請至少勾一筆';
        saveStatus.className = 'status-text error';
        return;
      }

      saveBtn.disabled = true;
      saveStatus.textContent = '💾 保存中…';
      saveStatus.className = 'status-text';

      try {
        const res = await fetch('/api/admin/listings/batch-save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source_url: srcUrl.value.trim() || null,
            source_group_name: srcGroup.value.trim() || null,
            items,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          saveStatus.textContent = `❌ ${data.message || '保存失敗'}`;
          saveStatus.className = 'status-text error';
          saveBtn.disabled = false;
          return;
        }
        saveStatus.textContent = `✅ 已存 ${data.saved_count} 筆${data.skipped_count > 0 ? `，跳過 ${data.skipped_count} 筆` : ''}`;
        saveStatus.className = 'status-text success';

        // Show recent
        renderRecent(data);
        recentCard.style.display = '';

        // Clear results card + textarea
        resultsCard.style.display = 'none';
        textInput.value = '';
        parsedItems = [];
        parseStatus.textContent = '';
        saveBtn.disabled = false;
      } catch (e) {
        saveStatus.textContent = '❌ 網路錯誤';
        saveStatus.className = 'status-text error';
        saveBtn.disabled = false;
      }
    });

    function renderRecent(data: any) {
      const existingCount = parseInt(recentCount.textContent || '0', 10);
      recentCount.textContent = String(existingCount + data.saved.length + data.skipped.length);

      // Saved rows (green)
      data.saved.forEach((s: any) => {
        const row = document.createElement('div');
        row.className = 'recent-row';
        row.innerHTML = `<span>✅ ${escapeHtml(s.model)}</span><span>NT$ ${s.price}・${s.status === 'sold' ? '已售' : '可購'}</span>`;
        recentList.insertBefore(row, recentList.firstChild);
      });
      // Skipped rows (yellow)
      data.skipped.forEach((s: any) => {
        const row = document.createElement('div');
        row.className = 'recent-row skipped';
        row.innerHTML = `<span>⚠️ ${escapeHtml(s.model)}</span><span>${escapeHtml(s.reason)}</span>`;
        recentList.insertBefore(row, recentList.firstChild);
      });
    }

    resetBtn.addEventListener('click', () => {
      resultsList.innerHTML = '';
      resultsCard.style.display = 'none';
      parsedItems = [];
      saveStatus.textContent = '';
    });

    function escapeHtml(s: string): string {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }
  </script>
</Layout>
